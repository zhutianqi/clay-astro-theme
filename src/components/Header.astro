---
export interface Props {
    title?: string;
}

const { title } = Astro.props;
const currentPath = Astro.url?.pathname ?? '';
---

<header class="site-head">
    <div class="site-head-container">

        <!-- LEFT NAV -->
        <nav class="site-head-left" aria-label="Left navigation">
            <ul class="nav" role="menu">

                <!-- About dropdown -->
                <li class={`nav-item has-dropdown${(currentPath.startsWith('/bio') || currentPath.startsWith('/our-story') || currentPath.startsWith('/winemaker') || currentPath.startsWith('/vineyards') || currentPath.startsWith('/philosophy')) ? ' nav-current' : ''}`} role="menuitem">
                    <a href="/bio">About</a>
                    <div class="dropdown" role="navigation" aria-label="About submenu">
                        <div class="dropdown-editorial">
                            <div class="dropdown-editorial-img">
                                <img src="/img/wine-estate.jpg" alt="" loading="lazy" />
                            </div>
                            <p class="dropdown-editorial-label">The Estate</p>
                        </div>
                        <nav class="dropdown-links">
                            <a href="/our-story">Our Story</a>
                            <a href="/winemaker">The Winemaker</a>
                            <a href="/vineyards">Vineyards</a>
                            <a href="/philosophy">Philosophy</a>
                            <a href="/faq">FAQ</a>
                        </nav>
                    </div>
                </li>

                <!-- Wines dropdown -->
                <li class={`nav-item has-dropdown${currentPath.startsWith('/work') ? ' nav-current' : ''}`} role="menuitem">
                    <a href="/work">Wines</a>
                    <div class="dropdown" role="navigation" aria-label="Wines submenu">
                        <div class="dropdown-editorial">
                            <div class="dropdown-editorial-img">
                                <img src="/img/wine-bottle-label.jpg" alt="" loading="lazy" />
                            </div>
                            <p class="dropdown-editorial-label">Our Selection</p>
                        </div>
                        <nav class="dropdown-links">
                            <a href="/work/leonidas-cabernet">Leonidas Cabernet</a>
                            <a href="/work/hillside-blend">Hillside Blend</a>
                            <a href="/work/reserve-chardonnay">Reserve Chardonnay</a>
                            <a href="/work/pinot-noir">Estate Pinot Noir</a>
                            <a href="/work/petite-sirah">Palisades Petite Sirah</a>
                        </nav>
                    </div>
                </li>

            </ul>
        </nav>

        <!-- CENTER LOGO -->
        <div class="site-head-center">
            <a class="site-head-logo" href="/">
                {title || "Maison"}
            </a>
        </div>

        <!-- RIGHT NAV -->
        <nav class="site-head-right" aria-label="Right navigation">
            <ul class="nav" role="menu">

                <!-- Experience dropdown -->
                <li class={`nav-item has-dropdown${(currentPath.startsWith('/news') || currentPath.startsWith('/wine-tasting') || currentPath.startsWith('/accolades')) ? ' nav-current' : ''}`} role="menuitem">
                    <a href="/news">Experience</a>
                    <div class="dropdown" role="navigation" aria-label="Experience submenu">
                        <div class="dropdown-editorial">
                            <div class="dropdown-editorial-img">
                                <img src="/img/wine-tasting.jpg" alt="" loading="lazy" />
                            </div>
                            <p class="dropdown-editorial-label">The Experience</p>
                        </div>
                        <nav class="dropdown-links">
                            <a href="/wine-tasting">Wine Tasting</a>
                            <a href="/news">Events &amp; Gallery</a>
                            <a href="/accolades">Accolades</a>
                        </nav>
                    </div>
                </li>

                <!-- Contact -->
                <li class={`nav-item${(currentPath === '/contact' || currentPath === '/contact/') ? ' nav-current' : ''}`} role="menuitem">
                    <a href="/contact">Contact</a>
                </li>

            </ul>

            <button id="theme-toggle" class="theme-toggle" aria-label="Toggle Dark Mode">
                <svg class="sun-icon" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"></circle><line x1="12" y1="1" x2="12" y2="3"></line><line x1="12" y1="21" x2="12" y2="23"></line><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line><line x1="1" y1="12" x2="3" y2="12"></line><line x1="21" y1="12" x2="23" y2="12"></line><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line></svg>
                <svg class="moon-icon" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg>
            </button>
        </nav>

        <!-- MOBILE BURGER — visible on ≤850px -->
        <button class="nav-burger" id="nav-burger" aria-label="Open menu" aria-expanded="false">
            <span class="burger-bar bar-1"></span>
            <span class="burger-bar bar-2"></span>
            <span class="burger-bar bar-3"></span>
            <span class="burger-text">Menu</span>
        </button>
    </div>

    <!-- MOBILE DRAWER -->
    <div class="mobile-drawer" id="mobile-drawer" aria-hidden="true">
        <button class="mobile-close" id="mobile-close-btn" aria-label="Close menu">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
        </button>
        <nav>
            <div class="mobile-section">
                <span class="mobile-section-label">About</span>
                <a href="/bio">About the Estate</a>
                <a href="/our-story">Our Story</a>
                <a href="/winemaker">The Winemaker</a>
                <a href="/vineyards">Vineyards</a>
                <a href="/philosophy">Philosophy</a>
                <a href="/faq">FAQ</a>
            </div>
            <div class="mobile-section">
                <span class="mobile-section-label">Wines</span>
                <a href="/work">All Wines</a>
                <a href="/work/leonidas-cabernet">Leonidas Cabernet</a>
                <a href="/work/hillside-blend">Hillside Blend</a>
                <a href="/work/reserve-chardonnay">Reserve Chardonnay</a>
                <a href="/work/pinot-noir">Estate Pinot Noir</a>
                <a href="/work/petite-sirah">Palisades Petite Sirah</a>
            </div>
            <div class="mobile-section">
                <span class="mobile-section-label">Experience</span>
                <a href="/wine-tasting">Wine Tasting</a>
                <a href="/news">Events &amp; Gallery</a>
                <a href="/accolades">Accolades</a>
            </div>
            <div class="mobile-section">
                <a href="/contact">Contact</a>
            </div>
            <div class="mobile-section mobile-footer-row">
                <button id="mobile-theme-toggle" class="mobile-theme-btn" aria-label="Toggle theme">
                    <svg class="sun-icon-m" xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"></circle><line x1="12" y1="1" x2="12" y2="3"></line><line x1="12" y1="21" x2="12" y2="23"></line><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line><line x1="1" y1="12" x2="3" y2="12"></line><line x1="21" y1="12" x2="23" y2="12"></line><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line></svg>
                    <svg class="moon-icon-m" xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg>
                    <span id="mobile-theme-label" class="mobile-theme-label">Dark Mode</span>
                </button>
            </div>
        </nav>
    </div>
</header>

<style>
/* ── Dropdown chevron ── */
.nav-item.has-dropdown > a::after {
    content: '';
    display: inline-block;
    width: 4px;
    height: 4px;
    border-right: 1px solid currentColor;
    border-bottom: 1px solid currentColor;
    transform: rotate(45deg) translateY(-2px);
    margin-left: 7px;
    opacity: 0.4;
    vertical-align: middle;
    transition: transform 0.25s cubic-bezier(0.2,0,0,1), opacity 0.25s;
}
.nav-item.has-dropdown:hover > a::after,
.nav-item.is-open > a::after {
    transform: rotate(225deg) translateY(0px);
    opacity: 0.75;
}

/* ────────────────────────────────────────────
   MEGA DROPDOWN — editorial image + links
   Positions relative to sticky header (containing block)
   ──────────────────────────────────────────── */
.nav-item.has-dropdown {
    position: static;
    height: 100%;
    display: flex;
    align-items: center;
}
.nav {
    height: 100%;
    align-items: stretch;
}
.site-head-left,
.site-head-right {
    height: 100%;
}

.dropdown {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    display: flex;
    flex-direction: row;
    justify-content: center;
    align-items: stretch;
    background: rgba(var(--color-bg-rgb), 0.98);
    backdrop-filter: blur(36px) saturate(1.8);
    -webkit-backdrop-filter: blur(36px) saturate(1.8);
    border: none;
    box-shadow: 0 24px 80px rgba(0,0,0,0.10);
    z-index: 500;
    /* hidden state */
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translateY(-10px);
    transition:
        opacity 0.28s cubic-bezier(0.2,0,0,1),
        transform 0.28s cubic-bezier(0.2,0,0,1),
        visibility 0s 0.28s;
}

[data-theme='dark'] .dropdown {
    background: rgba(10,7,4,0.98);
    box-shadow: 0 24px 80px rgba(0,0,0,0.65);
}

/* Visible state — JS .is-open + CSS :hover (fallback) + :focus-within (a11y) */
.nav-item.is-open .dropdown,
.nav-item:hover .dropdown,
.nav-item:focus-within .dropdown {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateY(0);
    transition:
        opacity 0.28s cubic-bezier(0.2,0,0,1),
        transform 0.28s cubic-bezier(0.2,0,0,1),
        visibility 0s;
}

/* ── Editorial image panel (left) ── */
.dropdown-editorial {
    position: relative;
    width: 260px;
    flex-shrink: 0;
    overflow: hidden;
}
.dropdown-editorial-img {
    width: 100%;
    height: 100%;
    min-height: 230px;
}
.dropdown-editorial-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    transition: transform 0.7s cubic-bezier(0.2,0,0,1);
}
.nav-item.is-open .dropdown-editorial-img img,
.nav-item:hover .dropdown-editorial-img img {
    transform: scale(1.06);
}
/* Dark gradient overlay on image */
.dropdown-editorial::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, rgba(0,0,0,0.08) 40%, rgba(0,0,0,0.52) 100%);
    pointer-events: none;
}
.dropdown-editorial-label {
    position: absolute;
    bottom: 1.4rem;
    left: 1.8rem;
    z-index: 2;
    font-family: var(--font-display);
    font-size: 1.45rem;
    font-weight: 300;
    font-style: italic;
    color: rgba(255,255,255,0.9);
    margin: 0;
    letter-spacing: 1px;
    text-shadow: 0 1px 8px rgba(0,0,0,0.35);
}

/* ── Links column (right) ── */
.dropdown-links {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 2.2rem 4.5vw;
    gap: 0;
    min-width: 200px;
}
.dropdown-links a {
    display: block;
    padding: 1rem 0;
    font-family: var(--font-sans-serif);
    font-size: 0.83rem;
    letter-spacing: 3.5px;
    text-transform: uppercase;
    color: var(--color-base);
    opacity: 0.55;
    text-decoration: none;
    white-space: nowrap;
    transition: opacity 0.22s, color 0.22s, transform 0.25s cubic-bezier(0.2,0,0,1);
}
[data-theme='dark'] .dropdown-links a {
    opacity: 0.75;
    color: #f8f2e5;
}
.dropdown-links a + a {
    border-top: 1px solid rgba(150,120,60,0.12);
}
[data-theme='dark'] .dropdown-links a + a {
    border-top: 1px solid rgba(255,235,185,0.07);
}
.dropdown-links a:hover {
    opacity: 1;
    color: var(--color-primary);
    transform: translateX(8px);
    text-decoration: none;
}

/* ────────────────────────────────────────────
   MOBILE BURGER BUTTON
   ──────────────────────────────────────────── */
.nav-burger {
    display: none;
    flex-direction: column;
    align-items: flex-end;
    justify-content: center;
    gap: 4px;
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 10px 0;
    position: absolute;
    right: 4vw;
    top: 50%;
    transform: translateY(-50%);
    z-index: 9999;
}
.burger-bar {
    display: block;
    height: 2px;
    background: var(--color-base);
    transition: all 0.3s cubic-bezier(0.4,0,0.2,1);
    transform-origin: center;
    border-radius: 1px;
}
.bar-1 { width: 28px; }
.bar-2 { width: 20px; }
.bar-3 { width: 28px; }

/* White bars when transparent nav over dark hero */
.site-head.is-transparent .burger-bar {
    background: rgba(255,255,255,0.92);
}

/* Active (X) state */
.nav-burger.is-active .bar-1 { transform: translateY(6px) rotate(45deg); width: 28px; }
.nav-burger.is-active .bar-2 { opacity: 0; transform: scaleX(0); }
.nav-burger.is-active .bar-3 { transform: translateY(-6px) rotate(-45deg); width: 28px; }

.burger-text {
    font-family: var(--font-sans-serif);
    font-size: 0.7rem;
    letter-spacing: 2.5px;
    text-transform: uppercase;
    color: var(--color-base);
    opacity: 0.7;
    margin-top: 2px;
    display: block;
}
.site-head.is-transparent .burger-text { color: rgba(255,255,255,0.8); }

/* ────────────────────────────────────────────
   MOBILE DRAWER — NO BORDERS, CLEAN
   ──────────────────────────────────────────── */
.mobile-drawer {
    display: none;
    position: fixed;
    inset: 0;
    top: 64px;
    background: var(--color-bg);
    z-index: 200;
    overflow-y: auto;
    padding: 1rem 8vw 5rem;
    transform: translateX(-100%);
    transition: transform 0.38s cubic-bezier(0.4,0,0.2,1);
}
.mobile-drawer.is-open {
    transform: translateX(0);
}

/* Close button inside drawer */
.mobile-close {
    position: absolute;
    top: 1.2rem;
    right: 6vw;
    background: transparent;
    border: none;
    cursor: pointer;
    color: var(--color-base);
    opacity: 0.55;
    padding: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: opacity 0.2s;
}
.mobile-close:hover { opacity: 1; }

.mobile-section {
    display: flex;
    flex-direction: column;
    padding: 2rem 0 1.5rem;
}

.mobile-section-label {
    font-family: var(--font-sans-serif);
    font-size: 0.78rem;
    letter-spacing: 4px;
    text-transform: uppercase;
    color: var(--color-primary);
    margin-bottom: 1rem;
    opacity: 0.9;
}

.mobile-section a {
    font-family: var(--font-display);
    font-size: 2.2rem;
    font-weight: 300;
    letter-spacing: 2px;
    color: var(--color-base);
    text-decoration: none;
    padding: 4px 0;
    opacity: 0.82;
    transition: color 0.2s, opacity 0.2s;
    display: block;
}
.mobile-section a:hover {
    color: var(--color-primary);
    opacity: 1;
}

/* Thin gold rule between sections */
.mobile-section + .mobile-section::before {
    content: '';
    display: block;
    width: 32px;
    height: 1px;
    background: var(--color-primary);
    opacity: 0.3;
    margin-bottom: 2rem;
}

.mobile-footer-row {
    padding-top: 1rem;
}
.mobile-footer-row::before {
    content: '';
    display: block;
    width: 32px;
    height: 1px;
    background: var(--color-primary);
    opacity: 0.3;
    margin-bottom: 2rem;
}
.mobile-theme-btn {
    display: flex;
    align-items: center;
    gap: 12px;
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 0;
    color: var(--color-base);
    opacity: 0.5;
    transition: opacity 0.25s;
}
.mobile-theme-btn:hover { opacity: 1; }
.mobile-theme-label {
    font-family: var(--font-sans-serif);
    font-size: 0.88rem;
    letter-spacing: 2.5px;
    text-transform: uppercase;
}
.sun-icon-m { color: var(--color-primary); }
.moon-icon-m { color: var(--color-base); }

/* Theme toggle button — borderless */
.theme-toggle {
    background: transparent;
    border: none;
    cursor: pointer;
    padding: 5px 8px;
    display: flex;
    align-items: center;
    gap: 6px;
    color: var(--color-base);
    opacity: 0.7;
    transition: opacity 0.3s;
    flex-shrink: 0;
}
.theme-toggle:focus { outline: none; }
.theme-toggle:hover { opacity: 1; }
.sun-icon { color: var(--color-primary); }
.moon-icon { color: var(--color-base); }

@media (max-width: 850px) {
    .mobile-drawer { display: block; }
    .site-head-left,
    .site-head-right { display: none !important; }
    .nav-burger { display: flex; }
}
</style>

<script>
// Wire up the mobile close button
(function() {
    const closeBtn = document.getElementById('mobile-close-btn');
    const drawer = document.getElementById('mobile-drawer') as HTMLElement;
    const burger = document.getElementById('nav-burger') as HTMLElement;
    if (closeBtn && drawer && burger) {
        closeBtn.addEventListener('click', () => {
            drawer.classList.remove('is-open');
            drawer.setAttribute('aria-hidden', 'true');
            burger.setAttribute('aria-expanded', 'false');
            burger.classList.remove('is-active');
        });
    }
})();

// JS hover management — bridges the gap between nav link and dropdown
// Prevents dropdown from closing when mouse passes through the header gap
document.addEventListener('astro:page-load', () => {
    const items = document.querySelectorAll<HTMLElement>('.nav-item.has-dropdown');
    items.forEach(item => {
        let hideTimer: ReturnType<typeof setTimeout>;

        item.addEventListener('mouseenter', () => {
            clearTimeout(hideTimer);
            // Close other open dropdowns
            items.forEach(other => {
                if (other !== item) other.classList.remove('is-open');
            });
            item.classList.add('is-open');
        });

        item.addEventListener('mouseleave', () => {
            hideTimer = setTimeout(() => {
                item.classList.remove('is-open');
            }, 200);
        });
    });

    // Close dropdowns on outside click
    document.addEventListener('click', (e) => {
        if (!(e.target as Element).closest('.nav-item.has-dropdown')) {
            items.forEach(i => i.classList.remove('is-open'));
        }
    });
});
</script>
