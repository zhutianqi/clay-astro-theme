---
export interface Props {
    title?: string;
}

const { title } = Astro.props;
const currentPath = Astro.url?.pathname ?? '';
---

<header class="site-head">
    <div class="site-head-container">

        <!-- LEFT NAV -->
        <nav class="site-head-left" aria-label="Left navigation">
            <ul class="nav" role="menu">

                <!-- About dropdown -->
                <li class={`nav-item has-dropdown${(currentPath.startsWith('/bio') || currentPath.startsWith('/our-story') || currentPath.startsWith('/winemaker') || currentPath.startsWith('/vineyards') || currentPath.startsWith('/philosophy')) ? ' nav-current' : ''}`} role="menuitem">
                    <a href="/bio">About</a>
                    <ul class="dropdown" role="menu" aria-label="About submenu">
                        <li><a href="/our-story">Our Story</a></li>
                        <li><a href="/winemaker">The Winemaker</a></li>
                        <li><a href="/vineyards">Vineyards</a></li>
                        <li><a href="/philosophy">Philosophy</a></li>
                        <li><a href="/faq">FAQ</a></li>
                    </ul>
                </li>

                <!-- Wines dropdown -->
                <li class={`nav-item has-dropdown${currentPath.startsWith('/work') ? ' nav-current' : ''}`} role="menuitem">
                    <a href="/work">Wines</a>
                    <ul class="dropdown" role="menu" aria-label="Wines submenu">
                        <li><a href="/work/earthen-textures">Leonidas Cabernet</a></li>
                        <li><a href="/work/minimal-forms">Hillside Blend</a></li>
                        <li><a href="/work/sculpted-vessels">Reserve Chardonnay</a></li>
                        <li><a href="/work/pinot-noir">Estate Pinot Noir</a></li>
                        <li><a href="/work/petite-sirah">Palisades Petite Sirah</a></li>
                    </ul>
                </li>

            </ul>
        </nav>

        <!-- CENTER LOGO -->
        <div class="site-head-center">
            <a class="site-head-logo" href="/">
                {title || "Maison"}
            </a>
        </div>

        <!-- RIGHT NAV -->
        <nav class="site-head-right" aria-label="Right navigation">
            <ul class="nav" role="menu">

                <!-- Experience dropdown -->
                <li class={`nav-item has-dropdown${(currentPath.startsWith('/news') || currentPath.startsWith('/wine-tasting') || currentPath.startsWith('/accolades')) ? ' nav-current' : ''}`} role="menuitem">
                    <a href="/news">Experience</a>
                    <ul class="dropdown dropdown-right" role="menu" aria-label="Experience submenu">
                        <li><a href="/wine-tasting">Wine Tasting</a></li>
                        <li><a href="/news">Events &amp; Gallery</a></li>
                        <li><a href="/accolades">Accolades</a></li>
                    </ul>
                </li>

                <!-- Contact -->
                <li class={`nav-item${(currentPath === '/contact' || currentPath === '/contact/') ? ' nav-current' : ''}`} role="menuitem">
                    <a href="/contact">Contact</a>
                </li>

            </ul>

            <button id="theme-toggle" class="theme-toggle" aria-label="Toggle Dark Mode">
                <svg class="sun-icon" xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"></circle><line x1="12" y1="1" x2="12" y2="3"></line><line x1="12" y1="21" x2="12" y2="23"></line><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line><line x1="1" y1="12" x2="3" y2="12"></line><line x1="21" y1="12" x2="23" y2="12"></line><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line></svg>
                <svg class="moon-icon" xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg>
            </button>
        </nav>

        <!-- MOBILE BURGER -->
        <button class="nav-burger" id="nav-burger" aria-label="Open menu" aria-expanded="false">
            <span></span>
            <span></span>
            <span></span>
        </button>
    </div>

    <!-- MOBILE DRAWER -->
    <div class="mobile-drawer" id="mobile-drawer" aria-hidden="true">
        <nav>
            <div class="mobile-section">
                <span class="mobile-section-label">About</span>
                <a href="/bio">About the Estate</a>
                <a href="/our-story">Our Story</a>
                <a href="/winemaker">The Winemaker</a>
                <a href="/vineyards">Vineyards</a>
                <a href="/philosophy">Philosophy</a>
                <a href="/faq">FAQ</a>
            </div>
            <div class="mobile-section">
                <span class="mobile-section-label">Wines</span>
                <a href="/work">All Wines</a>
                <a href="/work/earthen-textures">Leonidas Cabernet</a>
                <a href="/work/minimal-forms">Hillside Blend</a>
                <a href="/work/sculpted-vessels">Reserve Chardonnay</a>
                <a href="/work/pinot-noir">Estate Pinot Noir</a>
                <a href="/work/petite-sirah">Palisades Petite Sirah</a>
            </div>
            <div class="mobile-section">
                <span class="mobile-section-label">Experience</span>
                <a href="/wine-tasting">Wine Tasting</a>
                <a href="/news">Events &amp; Gallery</a>
                <a href="/accolades">Accolades</a>
            </div>
            <div class="mobile-section">
                <a href="/contact">Contact</a>
            </div>
        </nav>
    </div>
</header>

<style>
/* Dropdown chevron */
.nav-item.has-dropdown > a::after {
    content: '';
    display: inline-block;
    width: 4px;
    height: 4px;
    border-right: 1px solid currentColor;
    border-bottom: 1px solid currentColor;
    transform: rotate(45deg) translateY(-2px);
    margin-left: 6px;
    opacity: 0.5;
    vertical-align: middle;
    transition: transform 0.2s;
}
.nav-item.has-dropdown:hover > a::after {
    transform: rotate(225deg) translateY(-2px);
    opacity: 0.8;
}

/* Dropdown panel */
.dropdown {
    position: absolute;
    top: calc(100% + 10px);
    left: 0;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    min-width: 200px;
    padding: 0.5rem 0;
    opacity: 0;
    visibility: hidden;
    transform: translateY(-8px);
    transition: opacity 0.22s ease, transform 0.22s ease, visibility 0.22s;
    list-style: none;
    margin: 0;
    z-index: 500;
    box-shadow: 0 12px 40px rgba(0,0,0,0.22);
}
.dropdown::before {
    content: '';
    position: absolute;
    top: -6px;
    left: 20px;
    width: 10px;
    height: 10px;
    background: var(--color-bg);
    border-left: 1px solid var(--color-border);
    border-top: 1px solid var(--color-border);
    transform: rotate(45deg);
}
.dropdown-right {
    left: auto;
    right: 0;
}
.dropdown-right::before {
    left: auto;
    right: 20px;
}

.nav-item:hover .dropdown,
.nav-item:focus-within .dropdown {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
}

.dropdown li {
    margin: 0;
    padding: 0;
}
.dropdown li a {
    display: block !important;
    padding: 9px 22px !important;
    font-size: 1.05rem !important;
    letter-spacing: 1.8px !important;
    opacity: 0.68 !important;
    white-space: nowrap;
    color: var(--color-base) !important;
    transition: opacity 0.15s, color 0.15s !important;
}
.dropdown li a:hover {
    opacity: 1 !important;
    color: var(--color-primary) !important;
}
.dropdown li a::after {
    display: none !important;
}

/* Mobile Drawer */
.mobile-drawer {
    display: none;
    position: fixed;
    inset: 0;
    top: 70px;
    background: var(--color-bg);
    z-index: 200;
    overflow-y: auto;
    padding: 2rem 6vw 4rem;
    border-top: 1px solid var(--color-border);
    transform: translateX(-100%);
    transition: transform 0.35s cubic-bezier(0.4,0,0.2,1);
}
.mobile-drawer.is-open {
    transform: translateX(0);
}
.mobile-section {
    display: flex;
    flex-direction: column;
    padding: 1.5rem 0;
    border-bottom: 1px solid var(--color-border);
}
.mobile-section:last-child { border-bottom: none; }
.mobile-section-label {
    font-family: var(--font-sans-serif);
    font-size: 0.9rem;
    letter-spacing: 3px;
    text-transform: uppercase;
    color: var(--color-primary);
    margin-bottom: 0.8rem;
}
.mobile-section a {
    font-family: var(--font-display);
    font-size: 2rem;
    font-weight: 300;
    letter-spacing: 2px;
    color: var(--color-base);
    text-decoration: none;
    padding: 5px 0;
    opacity: 0.85;
    transition: color 0.2s, opacity 0.2s;
}
.mobile-section a:hover {
    color: var(--color-primary);
    opacity: 1;
}

@media (max-width: 850px) {
    .mobile-drawer { display: block; }
    .site-head-left,
    .site-head-right { display: none !important; }
}
</style>
