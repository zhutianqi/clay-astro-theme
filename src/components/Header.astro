---
export interface Props {
    title?: string;
}

const { title } = Astro.props;
const currentPath = Astro.url?.pathname ?? '';
---

<header class="site-head">
    <div class="site-head-container">

        <!-- LEFT NAV -->
        <nav class="site-head-left" aria-label="Left navigation">
            <ul class="nav" role="menu">

                <!-- About dropdown -->
                <li class={`nav-item has-dropdown${(currentPath.startsWith('/bio') || currentPath.startsWith('/our-story') || currentPath.startsWith('/winemaker') || currentPath.startsWith('/vineyards') || currentPath.startsWith('/philosophy')) ? ' nav-current' : ''}`} role="menuitem">
                    <a href="/bio">About</a>
                    <div class="dropdown" role="navigation" aria-label="About submenu">
                        <div class="dropdown-inner">
                            <div class="dropdown-editorial">
                                <img src="/img/wine-estate.jpg" alt="" loading="lazy" />
                                <div class="dropdown-editorial-overlay"></div>
                                <p class="dropdown-editorial-label">The Estate</p>
                            </div>
                            <nav class="dropdown-links">
                                <a href="/our-story">Our Story</a>
                                <a href="/winemaker">The Winemaker</a>
                                <a href="/vineyards">Vineyards</a>
                                <a href="/philosophy">Philosophy</a>
                                <a href="/faq">FAQ</a>
                            </nav>
                        </div>
                    </div>
                </li>

                <!-- Wines dropdown -->
                <li class={`nav-item has-dropdown${currentPath.startsWith('/work') ? ' nav-current' : ''}`} role="menuitem">
                    <a href="/work">Wines</a>
                    <div class="dropdown" role="navigation" aria-label="Wines submenu">
                        <div class="dropdown-inner">
                            <div class="dropdown-editorial">
                                <img src="/img/wine-bottle-label.jpg" alt="" loading="lazy" />
                                <div class="dropdown-editorial-overlay"></div>
                                <p class="dropdown-editorial-label">Our Selection</p>
                            </div>
                            <nav class="dropdown-links">
                                <a href="/work/leonidas-cabernet">Leonidas Cabernet</a>
                                <a href="/work/hillside-blend">Hillside Blend</a>
                                <a href="/work/reserve-chardonnay">Reserve Chardonnay</a>
                                <a href="/work/pinot-noir">Estate Pinot Noir</a>
                                <a href="/work/petite-sirah">Palisades Petite Sirah</a>
                            </nav>
                        </div>
                    </div>
                </li>

            </ul>
        </nav>

        <!-- CENTER LOGO -->
        <div class="site-head-center">
            <a class="site-head-logo" href="/">
                {title || "Maison"}
            </a>
        </div>

        <!-- RIGHT NAV -->
        <nav class="site-head-right" aria-label="Right navigation">
            <ul class="nav" role="menu">

                <!-- Experience dropdown -->
                <li class={`nav-item has-dropdown${(currentPath.startsWith('/news') || currentPath.startsWith('/wine-tasting') || currentPath.startsWith('/accolades')) ? ' nav-current' : ''}`} role="menuitem">
                    <a href="/news">Experience</a>
                    <div class="dropdown" role="navigation" aria-label="Experience submenu">
                        <div class="dropdown-inner">
                            <div class="dropdown-editorial">
                                <img src="/img/wine-tasting.jpg" alt="" loading="lazy" />
                                <div class="dropdown-editorial-overlay"></div>
                                <p class="dropdown-editorial-label">The Experience</p>
                            </div>
                            <nav class="dropdown-links">
                                <a href="/wine-tasting">Wine Tasting</a>
                                <a href="/news">Events &amp; Gallery</a>
                                <a href="/accolades">Accolades</a>
                            </nav>
                        </div>
                    </div>
                </li>

                <!-- Contact — NO dropdown -->
                <li class={`nav-item${(currentPath === '/contact' || currentPath === '/contact/') ? ' nav-current' : ''}`} role="menuitem">
                    <a href="/contact">Contact</a>
                </li>

            </ul>

            <button id="theme-toggle" class="theme-toggle" aria-label="Toggle Dark Mode">
                <svg class="sun-icon" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"></circle><line x1="12" y1="1" x2="12" y2="3"></line><line x1="12" y1="21" x2="12" y2="23"></line><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line><line x1="1" y1="12" x2="3" y2="12"></line><line x1="21" y1="12" x2="23" y2="12"></line><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line></svg>
                <svg class="moon-icon" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg>
            </button>
        </nav>

        <!-- MOBILE BURGER — visible on ≤850px -->
        <button class="nav-burger" id="nav-burger" aria-label="Open menu" aria-expanded="false">
            <span class="burger-bar bar-1"></span>
            <span class="burger-bar bar-2"></span>
            <span class="burger-bar bar-3"></span>
            <span class="burger-text-wrap">
                <span class="burger-text">Menu</span>
                <svg class="burger-chevron" width="10" height="10" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                    <path d="M2 4.5L6 8L10 4.5" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
            </span>
        </button>
    </div>

    <!-- MOBILE DRAWER -->
    <div class="mobile-drawer" id="mobile-drawer" aria-hidden="true">
        <button class="mobile-close" id="mobile-close-btn" aria-label="Close menu">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
        </button>
        <nav>
            <div class="mobile-section">
                <span class="mobile-section-label">About</span>
                <a href="/bio">About the Estate</a>
                <a href="/our-story">Our Story</a>
                <a href="/winemaker">The Winemaker</a>
                <a href="/vineyards">Vineyards</a>
                <a href="/philosophy">Philosophy</a>
                <a href="/faq">FAQ</a>
            </div>
            <div class="mobile-section">
                <span class="mobile-section-label">Wines</span>
                <a href="/work">All Wines</a>
                <a href="/work/leonidas-cabernet">Leonidas Cabernet</a>
                <a href="/work/hillside-blend">Hillside Blend</a>
                <a href="/work/reserve-chardonnay">Reserve Chardonnay</a>
                <a href="/work/pinot-noir">Estate Pinot Noir</a>
                <a href="/work/petite-sirah">Palisades Petite Sirah</a>
            </div>
            <div class="mobile-section">
                <span class="mobile-section-label">Experience</span>
                <a href="/wine-tasting">Wine Tasting</a>
                <a href="/news">Events &amp; Gallery</a>
                <a href="/accolades">Accolades</a>
            </div>
            <div class="mobile-section">
                <a href="/contact">Contact</a>
            </div>
            <div class="mobile-section mobile-footer-row">
                <button id="mobile-theme-toggle" class="mobile-theme-btn" aria-label="Toggle theme">
                    <svg class="sun-icon-m" xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"></circle><line x1="12" y1="1" x2="12" y2="3"></line><line x1="12" y1="21" x2="12" y2="23"></line><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"></line><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"></line><line x1="1" y1="12" x2="3" y2="12"></line><line x1="21" y1="12" x2="23" y2="12"></line><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"></line><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"></line></svg>
                    <svg class="moon-icon-m" xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg>
                    <span id="mobile-theme-label" class="mobile-theme-label">Dark Mode</span>
                </button>
            </div>
        </nav>
    </div>
</header>

<style>
/* ── Dropdown chevron ── */
.nav-item.has-dropdown > a::after {
    content: '';
    display: inline-block;
    width: 4px;
    height: 4px;
    border-right: 1px solid currentColor;
    border-bottom: 1px solid currentColor;
    transform: rotate(45deg) translateY(-2px);
    margin-left: 7px;
    opacity: 0.4;
    vertical-align: middle;
    transition: transform 0.25s cubic-bezier(0.2,0,0,1), opacity 0.25s;
}
.nav-item.has-dropdown:hover > a::after,
.nav-item.is-open > a::after {
    transform: rotate(225deg) translateY(0px);
    opacity: 0.75;
}

/* ────────────────────────────────────────────
   MEGA DROPDOWN
   Positions relative to sticky header.
   Uses .dropdown-inner to constrain layout
   while full-width background bleeds edge-to-edge.
   ──────────────────────────────────────────── */
.nav-item.has-dropdown {
    position: static; /* dropdown uses header as containing block */
}

.dropdown {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    height: 320px;           /* roomier luxury mega menu */
    overflow: hidden;
    display: flex;
    align-items: stretch;
    background:
        linear-gradient(180deg, rgba(255, 235, 185, 0.06) 0%, rgba(255, 235, 185, 0) 16%),
        linear-gradient(180deg, rgba(10, 8, 7, 0.98) 0%, rgba(7, 6, 5, 0.97) 100%);
    backdrop-filter: blur(14px) saturate(1.08);
    -webkit-backdrop-filter: blur(14px) saturate(1.08);
    border-top: 1px solid rgba(255, 235, 185, 0.2);
    box-shadow: 0 30px 85px rgba(0,0,0,0.62);
    z-index: 500;
    /* hidden state */
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translateY(-10px);
    transition:
        opacity 0.36s cubic-bezier(0.2,0,0,1),
        transform 0.42s cubic-bezier(0.2,0,0,1),
        visibility 0s 0.42s;
}
/* Removed decorative side background panels for a cleaner premium look */
.dropdown::before,
.dropdown::after {
    display: none;
}
[data-theme='dark'] .dropdown {
    background:
        linear-gradient(180deg, rgba(255, 235, 185, 0.05) 0%, rgba(255, 235, 185, 0) 16%),
        linear-gradient(180deg, rgba(8, 7, 6, 0.99) 0%, rgba(6, 5, 4, 0.98) 100%);
    border-top: 1px solid rgba(255, 235, 185, 0.24);
    box-shadow: 0 30px 95px rgba(0,0,0,0.72);
}

/* Visible state */
.nav-item.is-open .dropdown,
.nav-item:hover .dropdown,
.nav-item:focus-within .dropdown {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateY(0);
    transition:
        opacity 0.36s cubic-bezier(0.2,0,0,1),
        transform 0.42s cubic-bezier(0.2,0,0,1),
        visibility 0s;
}
.nav-item.is-open .dropdown::before,
.nav-item:hover .dropdown::before,
.nav-item:focus-within .dropdown::before {
    transform: translateX(0) scale(1);
    opacity: 0.28;
}
.nav-item.is-open .dropdown::after,
.nav-item:hover .dropdown::after,
.nav-item:focus-within .dropdown::after {
    transform: translateX(0) scale(1);
    opacity: 0.24;
}
[data-theme='dark'] .nav-item.is-open .dropdown::before,
[data-theme='dark'] .nav-item:hover .dropdown::before,
[data-theme='dark'] .nav-item:focus-within .dropdown::before {
    opacity: 0.18;
}
[data-theme='dark'] .nav-item.is-open .dropdown::after,
[data-theme='dark'] .nav-item:hover .dropdown::after,
[data-theme='dark'] .nav-item:focus-within .dropdown::after {
    opacity: 0.16;
}

/* ── Inner container — bounded content, full-height ── */
.dropdown-inner {
    display: flex;
    flex-direction: row;
    align-items: stretch;
    width: 100%;
    max-width: none;
    margin: 0;
    height: 100%;
    padding: 0 clamp(28px, 4vw, 72px);
    position: relative;
    z-index: 2;
}

/* ── Editorial image panel — consistent 380px wide landscape crop ── */
.dropdown-editorial {
    position: relative;
    width: min(36vw, 520px);
    flex-shrink: 0;
    overflow: hidden;
    border-radius: 2px;
}
.dropdown-editorial img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    transition: transform 0.7s cubic-bezier(0.2,0,0,1);
}
.nav-item.is-open .dropdown-editorial img,
.nav-item:hover .dropdown-editorial img {
    transform: scale(1.06);
}
/* Gradient overlay on image */
.dropdown-editorial-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to right, rgba(0,0,0,0.08) 42%, rgba(8,7,6,0.98) 100%);
    pointer-events: none;
}
[data-theme='dark'] .dropdown-editorial-overlay {
    background: linear-gradient(to right, rgba(0,0,0,0.08) 42%, rgba(7,6,5,0.98) 100%);
}
/* Caption on bottom of image */
.dropdown-editorial-label {
    position: absolute;
    bottom: 1.6rem;
    left: 2rem;
    font-family: var(--font-display);
    font-size: 1.55rem;
    font-weight: 300;
    font-style: italic;
    color: rgba(255,255,255,0.9);
    margin: 0;
    letter-spacing: 1px;
    text-shadow: 0 1px 8px rgba(0,0,0,0.35);
    pointer-events: none;
}

/* ── Links column ── */
.dropdown-links {
    display: grid;
    grid-template-columns: repeat(2, minmax(240px, 1fr));
    align-content: center;
    column-gap: clamp(28px, 4vw, 68px);
    row-gap: 0;
    padding: 2rem clamp(26px, 4vw, 72px);
    flex: 1;
}
.dropdown-links a {
    display: block;
    padding: 1rem 0;
    font-family: var(--font-sans-serif);
    font-size: clamp(0.98rem, 0.75rem + 0.45vw, 1.15rem);
    letter-spacing: 2.8px;
    text-transform: uppercase;
    color: #f6efe2;
    opacity: 0.84;
    text-decoration: none;
    white-space: nowrap;
    border-bottom: 1px solid rgba(255,235,185,0.16);
    transition: opacity 0.32s, color 0.32s, transform 0.38s cubic-bezier(0.2,0,0,1);
}
[data-theme='dark'] .dropdown-links a {
    opacity: 0.86;
    color: #f8f2e5;
    border-bottom: 1px solid rgba(255,235,185,0.18);
}
.dropdown-links a:hover {
    opacity: 1;
    color: var(--color-primary);
    transform: translateX(6px);
    text-decoration: none;
}

/* ────────────────────────────────────────────
   MOBILE BURGER BUTTON
   ──────────────────────────────────────────── */
.nav-burger {
    display: none;
    flex-direction: column;
    align-items: flex-end;
    justify-content: center;
    gap: 4px;
    background: transparent;
    border: 0;
    cursor: pointer;
    padding: 10px 0;
    position: absolute;
    right: 4vw;
    top: 50%;
    transform: translateY(-50%);
    z-index: 9999;
    -webkit-tap-highlight-color: transparent;
    -webkit-appearance: none;
    appearance: none;
}
.nav-burger,
#nav-burger {
    outline: none !important;
    box-shadow: none !important;
    border: 0 !important;
    background: transparent !important;
}
.nav-burger:focus,
.nav-burger:focus-visible,
.nav-burger:active,
#nav-burger:focus,
#nav-burger:focus-visible,
#nav-burger:active {
    outline: none !important;
    box-shadow: none !important;
    border: 0 !important;
    border-color: transparent !important;
    background: transparent !important;
}
.nav-burger::-moz-focus-inner,
#nav-burger::-moz-focus-inner {
    border: 0 !important;
}

.burger-bar {
    display: block;
    height: 2px;
    background: var(--color-base);
    transition: all 0.3s cubic-bezier(0.4,0,0.2,1);
    transform-origin: center;
    border-radius: 1px;
}
.bar-1 { width: 28px; }
.bar-2 { width: 20px; }
.bar-3 { width: 28px; }

.site-head.is-transparent .burger-bar { background: rgba(255,255,255,0.92); }

.nav-burger.is-active .bar-1 { transform: translateY(6px) rotate(45deg); width: 28px; }
.nav-burger.is-active .bar-2 { opacity: 0; transform: scaleX(0); }
.nav-burger.is-active .bar-3 { transform: translateY(-6px) rotate(-45deg); width: 28px; }

.burger-text-wrap {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    margin-top: 2px;
    color: var(--text-body);
}
.burger-text {
    font-family: var(--font-sans-serif);
    font-size: 0.72rem;
    letter-spacing: 2.4px;
    text-transform: uppercase;
    color: currentColor;
    opacity: 0.95;
    display: block;
}
.burger-chevron {
    color: currentColor;
    opacity: 0.8;
    transform: translateY(0.5px);
    transition: transform 0.25s cubic-bezier(0.2,0,0,1), opacity 0.25s;
}
.nav-burger.is-active .burger-chevron {
    transform: rotate(180deg) translateY(-1px);
    opacity: 1;
}
.site-head.is-transparent .burger-text-wrap,
.site-head.is-transparent .burger-text,
.site-head.is-transparent .burger-chevron { color: rgba(255,255,255,0.86); }

.nav-burger *:focus,
.nav-burger *:focus-visible,
#nav-burger *:focus,
#nav-burger *:focus-visible {
    outline: none !important;
    box-shadow: none !important;
}

/* Light mode on transparent header: keep menu button dark for contrast */
html:not([data-theme='dark']) .site-head.is-transparent .burger-bar,
:root:not([data-theme='dark']) .site-head.is-transparent .burger-bar {
    background: rgba(20,13,6,0.92) !important;
}
html:not([data-theme='dark']) .site-head.is-transparent .burger-text-wrap,
html:not([data-theme='dark']) .site-head.is-transparent .burger-text,
html:not([data-theme='dark']) .site-head.is-transparent .burger-chevron,
:root:not([data-theme='dark']) .site-head.is-transparent .burger-text-wrap,
:root:not([data-theme='dark']) .site-head.is-transparent .burger-text,
:root:not([data-theme='dark']) .site-head.is-transparent .burger-chevron {
    color: rgba(20,13,6,0.92) !important;
}

/* ────────────────────────────────────────────
   MOBILE DRAWER — NO BORDERS, CLEAN
   ──────────────────────────────────────────── */
.mobile-drawer {
    display: none;
    position: fixed;
    inset: 0;
    top: 64px;
    background: var(--color-bg);
    z-index: 200;
    overflow-y: auto;
    padding: 1rem 8vw 5rem;
    transform: translateX(-100%);
    transition: transform 0.38s cubic-bezier(0.4,0,0.2,1);
}
.mobile-drawer.is-open { transform: translateX(0); }

.mobile-close {
    position: absolute;
    top: 1.2rem;
    right: 6vw;
    z-index: 12;
    background: transparent;
    border: 0;
    cursor: pointer;
    color: var(--text-body);
    opacity: 0.9;
    padding: 6px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: opacity 0.2s, color 0.2s;
    box-shadow: none;
    -webkit-appearance: none;
    appearance: none;
    -webkit-tap-highlight-color: transparent;
}
.mobile-close:focus { outline: none; }
.mobile-close:hover,
.mobile-close:focus,
.mobile-close:focus-visible,
.mobile-close:active {
    box-shadow: none;
    border-color: transparent;
}
.mobile-close:hover { opacity: 1; }
html:not([data-theme='dark']) .mobile-close,
:root:not([data-theme='dark']) .mobile-close {
    color: rgba(20,13,6,0.9);
}

.mobile-section {
    display: flex;
    flex-direction: column;
    padding: 2rem 0 1.5rem;
}
.mobile-section-label {
    font-family: var(--font-sans-serif);
    font-size: 0.78rem;
    letter-spacing: 4px;
    text-transform: uppercase;
    color: var(--color-primary);
    margin-bottom: 1rem;
    opacity: 0.9;
}
.mobile-section a {
    font-family: var(--font-display);
    font-size: 2.2rem;
    font-weight: 300;
    letter-spacing: 2px;
    color: var(--text-strong);
    text-decoration: none;
    padding: 4px 0;
    opacity: 1;
    transition: color 0.2s, opacity 0.2s;
    display: block;
}
.mobile-section a:focus,
.mobile-section a:focus-visible,
.mobile-section a:active {
    outline: none;
    box-shadow: none;
    border-color: transparent;
}
.mobile-section a:hover { color: var(--color-primary); opacity: 1; }

.mobile-section + .mobile-section::before {
    content: '';
    display: block;
    width: 32px;
    height: 1px;
    background: var(--color-primary);
    opacity: 0.3;
    margin-bottom: 2rem;
}
.mobile-footer-row { padding-top: 1rem; }
.mobile-footer-row::before {
    content: '';
    display: block;
    width: 32px;
    height: 1px;
    background: var(--color-primary);
    opacity: 0.3;
    margin-bottom: 2rem;
}
.mobile-theme-btn {
    display: flex;
    align-items: center;
    gap: 12px;
    background: transparent;
    border: 0;
    cursor: pointer;
    padding: 0;
    color: var(--text-body);
    opacity: 0.86;
    transition: opacity 0.25s;
    box-shadow: none;
    -webkit-appearance: none;
    appearance: none;
    -webkit-tap-highlight-color: transparent;
}
.mobile-theme-btn:focus { outline: none; }
.mobile-theme-btn:hover,
.mobile-theme-btn:focus,
.mobile-theme-btn:focus-visible,
.mobile-theme-btn:active {
    box-shadow: none;
    border-color: transparent;
}
.mobile-theme-btn:hover { opacity: 1; }
.mobile-theme-label {
    font-family: var(--font-sans-serif);
    font-size: 0.88rem;
    letter-spacing: 2.5px;
    text-transform: uppercase;
}
.sun-icon-m { color: var(--color-primary); }
.moon-icon-m { color: var(--color-base); }

/* Theme toggle button — borderless, no outline */
.theme-toggle {
    background: transparent;
    border: 0;
    cursor: pointer;
    padding: 5px 8px;
    display: flex;
    align-items: center;
    gap: 6px;
    color: var(--color-base);
    opacity: 0.7;
    transition: opacity 0.3s;
    flex-shrink: 0;
    box-shadow: none;
    -webkit-appearance: none;
    appearance: none;
    -webkit-tap-highlight-color: transparent;
}
.theme-toggle:focus { outline: none; }
.theme-toggle:hover,
.theme-toggle:focus,
.theme-toggle:focus-visible,
.theme-toggle:active {
    box-shadow: none;
    border-color: transparent;
}
.theme-toggle:hover { opacity: 1; }
.sun-icon { color: var(--color-primary); }
.moon-icon { color: var(--color-base); }

@media (max-width: 1200px) {
    .dropdown-inner {
        padding: 0 24px;
    }
    .dropdown-editorial { width: min(40vw, 420px); }
    .dropdown-links {
        grid-template-columns: 1fr;
        padding: 1.4rem 2rem;
    }
}

@media (max-width: 850px) {
    .mobile-drawer { display: block; }
    .site-head-left,
    .site-head-right { display: none !important; }
    .nav-burger { display: flex; }
}
</style>

<script>
// JS hover management — 200ms delay bridges the gap between nav link and dropdown
document.addEventListener('astro:page-load', () => {
    const items = document.querySelectorAll<HTMLElement>('.nav-item.has-dropdown');
    items.forEach(item => {
        let hideTimer: ReturnType<typeof setTimeout>;
        item.addEventListener('mouseenter', () => {
            clearTimeout(hideTimer);
            items.forEach(other => { if (other !== item) other.classList.remove('is-open'); });
            item.classList.add('is-open');
        });
        item.addEventListener('mouseleave', () => {
            hideTimer = setTimeout(() => item.classList.remove('is-open'), 200);
        });
    });
    document.addEventListener('click', (e) => {
        if (!(e.target as Element).closest('.nav-item.has-dropdown')) {
            items.forEach(i => i.classList.remove('is-open'));
        }
    });
});
</script>
