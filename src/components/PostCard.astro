---
export interface Props {
  count: number;
  post: any;
  slug: string;
}

const { count, post, slug } = Astro.props;
const thumbnail = post.data.thumbnail;
const title = post.data.title;
const rating = post.data.rating;
const varietal = post.data.varietal;
const vintage = post.data.vintage;
const isLarge = count % 3 === 0;

const bgStyle = thumbnail ? `background-image: url(${thumbnail});` : '';
const postClass = `post-card ${isLarge ? 'post-card-large' : ''} ${thumbnail ? 'with-image' : 'no-image'}`;
---

<article class={postClass} style={bgStyle}>
  <a href={`/${slug}`} class="post-card-link">
    <div class="post-card-content">
      {rating && (
        <div class="post-card-rating">{rating}<span class="post-card-rating-pts">pts</span></div>
      )}
      <div class="post-card-text">
        {varietal && <p class="post-card-varietal">{varietal}{vintage ? ` · ${vintage}` : ''}</p>}
        <h2 class="post-card-title">{title}</h2>
        <div class="post-card-rule"></div>
      </div>
    </div>
  </a>
</article>

<style>
.post-card {
  position: relative;
  flex: 1 0 300px;
  display: flex;
  height: 40vw;
  max-height: 680px;
  background: linear-gradient(160deg, #1a1209 0%, #0a0604 100%) center center;
  background-size: cover;
  overflow: hidden;
  counter-increment: posts;
  border: 1px solid var(--color-border);
}

@media (max-width: 700px) {
  .post-card {
    flex: 1 1 100%;
    height: 72vw;
    max-height: none;
  }
}

.post-card-large {
  flex: 1 1 100%;
  height: 55vw;
  max-height: 760px;
}

.post-card-link {
  flex: 1 1 auto;
  display: block;
  text-decoration: none;
}

.post-card-content {
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
  padding: 3rem 2.5rem;
  background: linear-gradient(to top, rgba(8,6,4,0.88) 0%, rgba(8,6,4,0.3) 40%, rgba(8,6,4,0.05) 100%);
  opacity: 0;
  transition: opacity 0.45s cubic-bezier(0.33,0,0.2,1);
  text-align: center;
}
.post-card.no-image .post-card-content {
  opacity: 1;
  background: transparent;
  align-items: flex-start;
  justify-content: flex-end;
}
.post-card-link:hover .post-card-content { opacity: 1; }

@media (max-width: 700px) {
  .post-card.with-image .post-card-content {
    opacity: 1;
    background: linear-gradient(to top, rgba(8,6,4,0.85) 0%, rgba(8,6,4,0.2) 60%, transparent 100%);
  }
}

/* Rating badge */
.post-card-rating {
  position: absolute;
  top: 1.8rem;
  right: 1.8rem;
  font-family: var(--font-display);
  font-size: 3.5rem;
  font-weight: 300;
  color: var(--color-primary, #e7c874);
  line-height: 1;
  display: flex;
  align-items: baseline;
  gap: 2px;
  opacity: 0;
  transform: translateY(-6px);
  transition: opacity 0.45s ease, transform 0.45s ease;
}
.post-card-rating-pts {
  font-family: var(--font-sans-serif);
  font-size: 0.9rem;
  letter-spacing: 1px;
  text-transform: uppercase;
  opacity: 0.65;
}
.post-card-link:hover .post-card-rating {
  opacity: 1;
  transform: translateY(0);
}

.post-card-text {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0.8rem;
}
.post-card.no-image .post-card-text { align-items: flex-start; }

.post-card-varietal {
  font-family: var(--font-sans-serif);
  font-size: 0.9rem;
  letter-spacing: 3px;
  text-transform: uppercase;
  color: var(--color-primary, #e7c874);
  margin: 0;
  opacity: 0.9;
}
.post-card-title {
  margin: 0;
  font-family: var(--font-display);
  font-size: clamp(2.4rem, 3.5vw, 4rem);
  font-weight: 300;
  letter-spacing: 4px;
  text-transform: uppercase;
  text-align: center;
  color: #fff;
  transition: color 0.3s;
  line-height: 1.15;
}
.post-card.no-image .post-card-title {
  font-size: clamp(3rem, 4vw, 5rem);
  text-align: left;
  color: var(--color-base);
}
.post-card-link:hover .post-card-title { color: var(--color-primary, #e7c874); }

.post-card-rule {
  width: 0;
  height: 1px;
  background: var(--color-primary, #e7c874);
  transition: width 0.45s ease;
}
.post-card-link:hover .post-card-rule { width: 40px; }

.post-card.no-image::before {
  display: block;
  content: counter(posts, upper-roman);
  position: absolute;
  bottom: -0.05em;
  right: 4vw;
  font-family: var(--font-display);
  font-size: 20vw;
  line-height: 1em;
  font-weight: 200;
  letter-spacing: -0.05em;
  color: var(--color-base);
  opacity: 0.04;
  pointer-events: none;
  user-select: none;
}
</style>
