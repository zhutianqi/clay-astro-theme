---
export interface Props {
  count: number;
  post: any;
  slug: string;
}

const { count, post, slug } = Astro.props;
const thumbnail = post.data.thumbnail;
const title = post.data.title;
const isLarge = count % 3 === 0;

const bgStyle = thumbnail ? `background-image: url(${thumbnail});` : '';
const postClass = `post-card ${isLarge ? 'post-card-large' : ''} ${thumbnail ? 'with-image' : 'no-image'} post`;
---

<article class={postClass} style={bgStyle}>
  <a href={`/${slug}`} class="post-card-link">
    <div class="post-card-content">
      <h2 class="post-card-title">
        {title}
      </h2>
      <div class="post-card-rule"></div>
    </div>
  </a>
</article>

<style>
.post-card {
  position: relative;
  flex: 1 0 auto;
  display: flex;
  height: 38vw;
  background: linear-gradient(160deg, #1a1209 0%, #0a0604 100%) center center;
  background-size: cover;
  overflow: hidden;
  counter-increment: posts;
  margin: 0;
  border: 1px solid var(--color-border);
}

@media (max-width: 700px) {
  .post-card {
    flex: 1 1 100%;
    height: 70vw;
  }
}

.post-card-large {
  flex: 1 1 100%;
}

.post-card-link {
  flex: 1 1 auto;
  display: block;
  text-decoration: none;
}

.post-card-content {
  flex: 1 1 auto;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 1.2rem;
  position: absolute;
  inset: 0;
  color: #fff;
  background: var(--color-overlay, rgba(8,6,4,0.55));
  transition: background 0.4s ease;
}

.post-card.with-image .post-card-content {
  background: rgba(8,6,4,0.25);
}

.post-card-link:hover .post-card-content {
  background: rgba(8,6,4,0.6);
}

.post-card-title {
  margin: 0;
  font-family: var(--font-display);
  font-size: 3.8rem;
  font-weight: 300;
  letter-spacing: 5px;
  text-transform: uppercase;
  text-align: center;
  max-width: 70%;
  color: #fff;
  transition: color 0.3s;
}

.post-card-link:hover .post-card-title {
  color: var(--color-primary);
}

.post-card-rule {
  width: 0;
  height: 1px;
  background: var(--color-primary);
  transition: width 0.4s ease;
}

.post-card-link:hover .post-card-rule {
  width: 50px;
}

/* Cards without images */
.post-card.no-image::before {
  display: block;
  content: counter(posts, upper-roman);
  position: absolute;
  bottom: -0.1em;
  right: 4vw;
  font-family: var(--font-display);
  font-size: 22vw;
  line-height: 1em;
  font-weight: 300;
  letter-spacing: -0.05em;
  color: rgba(255,255,255,0.04);
  pointer-events: none;
}

.post-card.no-image .post-card-content {
  align-items: flex-start;
  justify-content: flex-end;
  padding: 4vw;
  background: transparent;
}

.post-card.no-image .post-card-title {
  font-size: 4.5rem;
  text-align: left;
  max-width: 80%;
  color: var(--color-base);
}

.post-card.no-image:hover .post-card-title {
  color: var(--color-primary);
}

@media (max-width: 1200px) {
  .post-card.no-image .post-card-title {
    font-size: 3rem;
  }
}
@media (max-width: 700px) {
  .post-card-title { font-size: 2.8rem; }
  .post-card.no-image::before { font-size: 40vw; }
}
</style>
