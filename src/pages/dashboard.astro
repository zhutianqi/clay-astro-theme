---
// src/pages/dashboard.astro
import Layout from '../layouts/Layout.astro';

// 获取 Netlify Identity 自动注入的 Cookie
// 注意：Netlify 会在请求头中包含用户信息的加密 Token
const userCookie = Astro.cookies.get('nf_jwt');

// 如果没有找到登录 Token，直接重定向回登录页
if (!userCookie) {
  return Astro.redirect('/login');
}

// 如果需要更高级的校验，可以通过解析 JWT 获取用户信息
// 但对于基础保护，检查 nf_jwt 是否存在是最简单有效的方法
---

<Layout title="会员中心">
  <main>
    <h1>欢迎回来，尊贵的会员！</h1>
    <p>这段内容是受服务器保护的，未登录者无法看到。</p>
    <div data-netlify-identity-button></div>
  </main>
</Layout>