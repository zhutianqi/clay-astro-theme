<script>
// Quote carousel
(function() {
    const DURATION = 7500;
    const circumference = 2 * Math.PI * 22; // r=22

    let current = 0;
    let startTs: number | null = null;
    let paused = false;
    let rafId: number;

    const items = Array.from(document.querySelectorAll<HTMLElement>('.quote-item'));
    const dots  = Array.from(document.querySelectorAll<HTMLButtonElement>('.quote-dot'));
    const ring  = document.querySelector<SVGCircleElement>('.progress-ring__circle');
    const countEl = document.getElementById('quote-count');
    const section = document.getElementById('quote-section');

    if (!items.length || !ring) return;

    function goTo(idx: number) {
        items[current].classList.remove('revealed');
        dots[current]?.classList.remove('active');
        current = ((idx % items.length) + items.length) % items.length;
        items[current].classList.add('revealed');
        dots[current]?.classList.add('active');
        if (countEl) countEl.textContent = String(current + 1);
        startTs = null;
    }

    function tick(ts: number) {
        if (!paused) {
            if (!startTs) startTs = ts;
            const p = Math.min((ts - startTs) / DURATION, 1);
            ring!.style.strokeDashoffset = String(circumference * (1 - p));
            if (p >= 1) goTo(current + 1);
        }
        rafId = requestAnimationFrame(tick);
    }

    dots.forEach((d, i) => d.addEventListener('click', () => goTo(i)));

    // Touch swipe support
    let touchX = 0;
    section?.addEventListener('touchstart', (e) => { touchX = e.touches[0].clientX; }, { passive: true });
    section?.addEventListener('touchend', (e) => {
        const dx = e.changedTouches[0].clientX - touchX;
        if (Math.abs(dx) > 40) goTo(dx < 0 ? current + 1 : current - 1);
    }, { passive: true });

    rafId = requestAnimationFrame(tick);
    document.addEventListener('astro:before-swap', () => cancelAnimationFrame(rafId));
})();

// Wine card modal
(function() {
    let modalCenterRaf: number | undefined;
    const isFinePointer = window.matchMedia('(pointer: fine)').matches;

    function getEls() {
        const modal = document.getElementById('wine-modal') as HTMLElement | null;
        if (!modal) return null;
        return {
            modal,
            backdrop: modal.querySelector('.wine-modal-backdrop') as HTMLElement | null,
            closeBtn: modal.querySelector('.wine-modal-close') as HTMLElement | null,
            panel: modal.querySelector('.wine-modal-panel') as HTMLElement | null,
            img: document.getElementById('modal-img') as HTMLImageElement | null,
            scoreNum: document.getElementById('modal-score-num') as HTMLElement | null,
            varietal: document.getElementById('modal-varietal') as HTMLElement | null,
            title: document.getElementById('modal-title') as HTMLElement | null,
            meta: document.getElementById('modal-meta') as HTMLElement | null,
            desc: document.getElementById('modal-desc') as HTMLElement | null,
            notes: document.getElementById('modal-notes') as HTMLElement | null,
            price: document.getElementById('modal-price') as HTMLElement | null,
            link: document.getElementById('modal-link') as HTMLAnchorElement | null,
            scoreBadge: modal.querySelector('.wine-modal-score-badge') as HTMLElement | null
        };
    }

    function openModal(trigger: HTMLElement) {
        const els = getEls();
        if (!els) return;
        const { modal, img, scoreNum, varietal, title, meta, desc, notes, price, link, scoreBadge } = els;
        const slug = trigger.dataset.wineSlug || '';

        if (img) { img.src = trigger.dataset.wineImg || ''; img.alt = trigger.dataset.wineTitle || ''; }
        if (scoreNum) scoreNum.textContent = trigger.dataset.wineRating || '';
        if (scoreBadge) scoreBadge.style.display = trigger.dataset.wineRating ? '' : 'none';
        if (varietal) varietal.textContent = trigger.dataset.wineVarietal || '';
        if (title) title.textContent = trigger.dataset.wineTitle || '';

        const parts = [trigger.dataset.wineAppellation, trigger.dataset.wineVintage].filter(Boolean);
        if (meta) meta.textContent = parts.join(' · ');
        if (desc) desc.textContent = trigger.dataset.wineDescription || '';

        if (notes) {
            notes.innerHTML = '';
            try {
                const noteList: string[] = JSON.parse(trigger.dataset.wineNotes || '[]');
                noteList.forEach((n) => {
                    const li = document.createElement('li');
                    li.textContent = n;
                    notes.appendChild(li);
                });
            } catch {}
        }

        if (price) price.textContent = trigger.dataset.winePrice || '';
        if (link) link.href = `/work/${slug}`;

        queueModalCenterUpdate();
        clearFarCloseTimer();
        modal.classList.add('is-open');
        modal.setAttribute('aria-hidden', 'false');
        document.body.style.overflow = 'hidden';
        queueModalCenterUpdate();
    }

    function closeModal() {
        const els = getEls();
        if (!els) return;
        els.modal.classList.remove('is-open');
        els.modal.setAttribute('aria-hidden', 'true');
        document.body.style.overflow = '';
        clearFarCloseTimer();
    }
    function closeIfOpen() {
        const els = getEls();
        if (!els) return;
        if (els.modal.classList.contains('is-open')) closeModal();
    }

    let farCloseTimer: number | undefined;
    function clearFarCloseTimer() {
        window.clearTimeout(farCloseTimer);
        farCloseTimer = undefined;
    }
    function scheduleFarClose() {
        if (farCloseTimer) return;
        farCloseTimer = window.setTimeout(closeIfOpen, 520);
    }
    function distanceToPanel(e: PointerEvent, panel: HTMLElement) {
        const rect = panel.getBoundingClientRect();
        const dx = e.clientX < rect.left ? rect.left - e.clientX : e.clientX > rect.right ? e.clientX - rect.right : 0;
        const dy = e.clientY < rect.top ? rect.top - e.clientY : e.clientY > rect.bottom ? e.clientY - rect.bottom : 0;
        return Math.hypot(dx, dy);
    }
    function onPointerMove(e: PointerEvent) {
        const els = getEls();
        if (!els || !els.panel || !els.modal.classList.contains('is-open')) return;
        const far = distanceToPanel(e, els.panel) > 180;
        if (far) scheduleFarClose();
        else clearFarCloseTimer();
    }
    function getViewportCenter() {
        const vv = window.visualViewport;
        return {
            x: vv ? vv.width / 2 : window.innerWidth / 2,
            y: vv ? vv.height / 2 : window.innerHeight / 2
        };
    }
    function updateModalCenter() {
        const els = getEls();
        if (!els?.panel) return;
        const { x, y } = getViewportCenter();
        els.panel.style.left = `${x}px`;
        els.panel.style.top = `${y}px`;
    }
    function queueModalCenterUpdate() {
        window.cancelAnimationFrame(modalCenterRaf);
        modalCenterRaf = window.requestAnimationFrame(() => {
            updateModalCenter();
            modalCenterRaf = window.requestAnimationFrame(updateModalCenter);
        });
    }

    function onDocClick(e: MouseEvent) {
        const target = e.target as HTMLElement | null;
        if (!target) return;
        const trigger = target.closest('[data-wine-slug]') as HTMLElement | null;
        if (trigger) {
            e.preventDefault();
            openModal(trigger);
            return;
        }
        if (target.closest('.wine-modal-backdrop') || target.closest('.wine-modal-close')) {
            closeModal();
        }
    }

    if (!(window as any).__wineModalBound) {
        document.addEventListener('click', onDocClick);
        document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeModal(); });
        document.addEventListener('visibilitychange', () => { if (document.hidden) closeIfOpen(); });
        if (isFinePointer) document.addEventListener('pointermove', onPointerMove, { passive: true });
        window.addEventListener('resize', queueModalCenterUpdate);
        window.addEventListener('scroll', queueModalCenterUpdate, { passive: true });
        window.visualViewport?.addEventListener('resize', queueModalCenterUpdate);
        window.visualViewport?.addEventListener('scroll', queueModalCenterUpdate);
        document.addEventListener('astro:before-swap', closeModal);
        (window as any).__wineModalBound = true;
    }
    queueModalCenterUpdate();
})();

// Drag-to-scroll on The Collection rail
(function() {
    const scroller = document.querySelector<HTMLElement>('[data-drag-scroll]');
    if (!scroller) return;

    let isDown = false;
    let startX = 0;
    let startScrollLeft = 0;

    const onPointerDown = (e: PointerEvent) => {
        if (e.pointerType === 'mouse' && e.button !== 0) return;
        isDown = true;
        startX = e.clientX;
        startScrollLeft = scroller.scrollLeft;
        scroller.classList.add('is-dragging');
        scroller.setPointerCapture?.(e.pointerId);
    };

    const onPointerMove = (e: PointerEvent) => {
        if (!isDown) return;
        const dx = e.clientX - startX;
        scroller.scrollLeft = startScrollLeft - dx;
    };

    const onPointerUp = (e: PointerEvent) => {
        if (!isDown) return;
        isDown = false;
        scroller.classList.remove('is-dragging');
        scroller.releasePointerCapture?.(e.pointerId);
    };

    scroller.addEventListener('pointerdown', onPointerDown);
    scroller.addEventListener('pointermove', onPointerMove);
    scroller.addEventListener('pointerup', onPointerUp);
    scroller.addEventListener('pointercancel', onPointerUp);
    scroller.addEventListener('pointerleave', onPointerUp);

    document.addEventListener('astro:before-swap', () => {
        scroller.removeEventListener('pointerdown', onPointerDown);
        scroller.removeEventListener('pointermove', onPointerMove);
        scroller.removeEventListener('pointerup', onPointerUp);
        scroller.removeEventListener('pointercancel', onPointerUp);
        scroller.removeEventListener('pointerleave', onPointerUp);
    });
})();

// Parallax scroll on vineyard section
(function() {
    const bg = document.getElementById('parallax-bg') as HTMLElement;
    if (!bg) return;
    const onScroll = () => {
        const section = bg.parentElement!;
        const rect = section.getBoundingClientRect();
        const pct = (window.innerHeight - rect.top) / (window.innerHeight + rect.height);
        const shift = (pct - 0.5) * 80;
        bg.style.transform = `translateY(${shift}px)`;
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    document.addEventListener('astro:before-swap', () =>
        window.removeEventListener('scroll', onScroll)
    );
})();
</script>
