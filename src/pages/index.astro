---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

// Fetch wines sorted by rating (highest first)
const allWines = (await getCollection('work')).sort((a, b) =>
    (b.data.rating || 0) - (a.data.rating || 0)
);
const featuredWine = allWines[0];  // Leonidas 98pts
const collectionWines = allWines.slice(1, 4); // next 3

// Fetch events
const events = (await getCollection('news')).sort((a, b) =>
    new Date(b.data.date || 0).getTime() - new Date(a.data.date || 0).getTime()
).slice(0, 3);
---

<Layout title="Maison" description="Estate wines of exceptional character from Napa Valley and Sonoma Coast.">

    <!-- ── HERO ──────────────────────────────────────────────── -->
    <section class="hero">
        <div class="hero-bg" id="hero-bg"></div>
        <div class="hero-overlay"></div>
        <div class="hero-content">
            <p class="hero-eyebrow">Est. 1989 &nbsp;·&nbsp; Napa Valley</p>
            <h1 class="hero-title">Maison</h1>
            <div class="hero-rule"></div>
            <p class="hero-desc">
                We are proud to share our remarkable limited production wines, whose subtle balance of elegance, structure, power and finesse are a striking embodiment of everything we hold dear about this land.
            </p>
            <div class="hero-actions">
                <a href="/contact" class="btn btn-gold">Join the Allocation List</a>
                <a href="/work" class="btn btn-outline-white">Explore the Wines</a>
            </div>
        </div>
        <a href="#quote-section" class="hero-scroll" aria-label="Scroll down">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><polyline points="6 9 12 15 18 9"></polyline></svg>
        </a>
    </section>

    <!-- ── QUOTE CAROUSEL ──────────────────────────────────── -->
    <section id="quote-section" class="quote-section">
        <div class="quote-inner">
            <div class="progress-ring-wrap" aria-hidden="true">
                <svg class="progress-ring" width="52" height="52" viewBox="0 0 52 52">
                    <circle class="progress-ring__bg" cx="26" cy="26" r="22" />
                    <circle class="progress-ring__circle" cx="26" cy="26" r="22" />
                </svg>
                <span class="progress-ring__count" id="quote-count">1</span>
            </div>
            <ul class="quote-list" id="quote-list" aria-live="polite">
                <li class="quote-item revealed" data-index="0">
                    <blockquote class="quote-text">"Opens with gregarious blue and black fruits, dried herbs, chargrill and savory notes. The full-bodied palate is vibrant, expressive, mineral, and earthy with black fruits and firm, grainy tannins, finishing long."</blockquote>
                    <cite class="quote-cite">
                        <span class="quote-score">98 Points</span>
                        <span class="quote-source">Robert Parker · Wine Advocate</span>
                        <span class="quote-wine">Leonidas Cabernet Sauvignon 2020</span>
                    </cite>
                </li>
                <li class="quote-item" data-index="1">
                    <blockquote class="quote-text">"Extraordinary complexity and finesse. A wine of great poise and elegance, with a crystalline purity of fruit that is genuinely rare in today's market. Among the finest Napa Valley wines I have encountered in years."</blockquote>
                    <cite class="quote-cite">
                        <span class="quote-score">97 Points</span>
                        <span class="quote-source">James Suckling</span>
                        <span class="quote-wine">Leonidas Cabernet Sauvignon 2018</span>
                    </cite>
                </li>
                <li class="quote-item" data-index="2">
                    <blockquote class="quote-text">"Mountain intensity with classical restraint. Each sip reveals something new — a testament to both terroir and the winemaker's art. Among the finest expressions from any appellation I have encountered."</blockquote>
                    <cite class="quote-cite">
                        <span class="quote-score">96 Points</span>
                        <span class="quote-source">Wine Spectator</span>
                        <span class="quote-wine">Howell Mountain Hillside Blend 2019</span>
                    </cite>
                </li>
                <li class="quote-item" data-index="3">
                    <blockquote class="quote-text">"Effortlessly beautiful. The kind of Pinot Noir that reminds you why the grape is called the heartbreak grape — seductive and elusive in equal measure. A remarkable achievement from an already remarkable estate."</blockquote>
                    <cite class="quote-cite">
                        <span class="quote-score">94 Points</span>
                        <span class="quote-source">Vinous</span>
                        <span class="quote-wine">Estate Pinot Noir 2021</span>
                    </cite>
                </li>
            </ul>
            <div class="quote-dots" id="quote-dots">
                <button class="quote-dot active" data-slide="0" aria-label="Quote 1"></button>
                <button class="quote-dot" data-slide="1" aria-label="Quote 2"></button>
                <button class="quote-dot" data-slide="2" aria-label="Quote 3"></button>
                <button class="quote-dot" data-slide="3" aria-label="Quote 4"></button>
            </div>
        </div>
    </section>

    <!-- ── PHILOSOPHY STATEMENT ───────────────────────────── -->
    <section class="statement-section">
        <div class="statement-inner" data-reveal="up">
            <span class="eyebrow">The Philosophy</span>
            <h2 class="statement-heading">
                We do not chase scores,<br>
                <em>though the scores arrive anyway.</em>
            </h2>
            <p class="statement-body">
                For over three decades, Maison has been guided by a single conviction: the finest wines come from the finest farming. Our 42 acres of estate vines are worked by hand, farmed biodynamically, and harvested over multiple passes to capture only what the year has given us. Nothing more.
            </p>
            <a href="/bio" class="text-link">Read our story <span aria-hidden="true">→</span></a>
        </div>
    </section>

    <!-- ── FEATURED WINE ──────────────────────────────────── -->
    {featuredWine && (
        <section class="feature-section">
            <div class="feature-img-wrap" data-reveal="left">
                <div class="feature-img-inner">
                    <img
                        src={featuredWine.data.thumbnail || '/img/wine-red-glass.jpg'}
                        alt={featuredWine.data.title}
                        class="feature-img"
                    />
                </div>
                {featuredWine.data.rating && (
                    <div class="feature-score-badge" aria-label={`${featuredWine.data.rating} points`}>
                        <span class="feature-score-num">{featuredWine.data.rating}</span>
                        <span class="feature-score-pts">pts</span>
                    </div>
                )}
            </div>
            <div class="feature-content" data-reveal="right">
                <span class="eyebrow">Flagship Wine</span>
                <h2 class="feature-title">{featuredWine.data.title}</h2>
                <p class="feature-meta">
                    {featuredWine.data.vintage && <span>{featuredWine.data.vintage}</span>}
                    {featuredWine.data.appellation && <span>{featuredWine.data.appellation}</span>}
                </p>
                <div class="feature-rule"></div>
                <p class="feature-desc">{featuredWine.data.description}</p>
                {featuredWine.data.critic && featuredWine.data.rating && (
                    <p class="feature-critic">
                        <strong>{featuredWine.data.rating} Points</strong> — {featuredWine.data.critic}
                    </p>
                )}
                <a href={`/work/${featuredWine.slug}`} class="feature-link">
                    Discover this wine <span aria-hidden="true">→</span>
                </a>
            </div>
        </section>
    )}

    <!-- ── WINE COLLECTION ────────────────────────────────── -->
    <section class="collection-section">
        <div class="collection-header" data-reveal="up">
            <h2 class="collection-title">The Collection</h2>
            <a href="/work" class="text-link">View all wines <span aria-hidden="true">→</span></a>
        </div>
        <div class="collection-grid">
            {collectionWines.map((wine, i) => (
                <a href={`/work/${wine.slug}`} class="collection-card" data-reveal="up" data-delay={String(i + 1)}>
                    <div class="collection-card-img-wrap">
                        <img
                            src={wine.data.thumbnail || '/img/wine-red-glass.jpg'}
                            alt={wine.data.title}
                            class="collection-card-img"
                        />
                        <div class="collection-card-overlay"></div>
                    </div>
                    <div class="collection-card-body">
                        {wine.data.varietal && <span class="collection-card-varietal">{wine.data.varietal}</span>}
                        <h3 class="collection-card-title">{wine.data.title}</h3>
                        <div class="collection-card-footer">
                            <span class="collection-card-vintage">{wine.data.vintage}</span>
                            {wine.data.rating && <span class="collection-card-score">{wine.data.rating} pts</span>}
                        </div>
                    </div>
                </a>
            ))}
        </div>
    </section>

    <!-- ── ESTATE PARALLAX ────────────────────────────────── -->
    <section class="parallax-section" id="parallax-section">
        <div class="parallax-bg" id="parallax-bg"></div>
        <div class="parallax-overlay"></div>
        <div class="parallax-content" data-reveal="scale">
            <span class="eyebrow eyebrow-light">The Estate</span>
            <h2 class="parallax-title">
                42 Acres.<br>
                Five Blocks.<br>
                <em>One Vision.</em>
            </h2>
            <div class="parallax-rule"></div>
            <p class="parallax-text">
                Our land was chosen for its volcanic soils, its elevation, and its capacity to produce something that could not come from anywhere else on earth.
            </p>
            <a href="/vineyards" class="btn btn-outline-gold">Explore the Vineyards</a>
        </div>
    </section>

    <!-- ── EVENTS ─────────────────────────────────────────── -->
    <section class="events-section">
        <div class="events-header" data-reveal="up">
            <h2 class="events-title">Experience</h2>
            <a href="/news" class="text-link">All events <span aria-hidden="true">→</span></a>
        </div>
        <div class="events-grid">
            {events.map((event, i) => (
                <a href={`/news/${event.slug}`} class="event-card" data-reveal="up" data-delay={String(i + 1)}>
                    <div class="event-card-img-wrap">
                        <img
                            src={event.data.thumbnail || '/img/wine-tasting.jpg'}
                            alt={event.data.title}
                            class="event-card-img"
                        />
                    </div>
                    <div class="event-card-body">
                        <span class="event-card-label">
                            {event.data.date ? new Date(event.data.date).toLocaleDateString('en-US', { month: 'long', year: 'numeric' }) : 'Estate Event'}
                        </span>
                        <h3 class="event-card-title">{event.data.title}</h3>
                        <p class="event-card-desc">{event.data.description}</p>
                        <span class="event-card-link">Read more <span aria-hidden="true">→</span></span>
                    </div>
                </a>
            ))}
        </div>
    </section>

    <!-- ── JOIN THE LIST ──────────────────────────────────── -->
    <section class="join-section">
        <div class="join-inner" data-reveal="scale">
            <span class="eyebrow eyebrow-light">Limited Allocation</span>
            <h2 class="join-title">Join the List</h2>
            <div class="join-rule"></div>
            <p class="join-text">
                Our wines are released annually to allocation list members before reaching retail or restaurant channels. Membership is complimentary and carries no minimum purchase obligation.
            </p>
            <a href="/contact" class="btn btn-gold-large">Request an Allocation</a>
        </div>
    </section>

</Layout>

<style>
/* ─── GLOBAL SHARED ELEMENTS ──────────────── */
.eyebrow {
    font-family: var(--font-sans-serif);
    font-size: 1rem;
    letter-spacing: 4.5px;
    text-transform: uppercase;
    color: var(--color-primary);
    display: block;
    margin-bottom: 1.8rem;
    opacity: 0.9;
}
.eyebrow-light { color: rgba(231,200,116,0.85); }

.text-link {
    font-family: var(--font-sans-serif);
    font-size: 1.05rem;
    letter-spacing: 2.5px;
    text-transform: uppercase;
    color: var(--color-base);
    text-decoration: none;
    opacity: 0.5;
    transition: opacity 0.25s, color 0.25s;
    border-bottom: 1px solid var(--color-primary);
    padding-bottom: 2px;
}
.text-link:hover { opacity: 0.9; color: var(--color-primary); text-decoration: none; }

.btn {
    font-family: var(--font-sans-serif);
    font-size: 1rem;
    letter-spacing: 3px;
    text-transform: uppercase;
    padding: 15px 40px;
    display: inline-block;
    text-decoration: none;
    transition: all 0.3s ease;
}
.btn-gold {
    background: var(--color-primary, #e7c874);
    color: #0a0604;
    border: 1px solid var(--color-primary, #e7c874);
}
.btn-gold:hover { background: transparent; color: var(--color-primary, #e7c874); text-decoration: none; }
.btn-outline-white {
    background: transparent;
    color: rgba(255,255,255,0.85);
    border: 1px solid rgba(255,255,255,0.35);
}
.btn-outline-white:hover { border-color: var(--color-primary, #e7c874); color: var(--color-primary, #e7c874); text-decoration: none; }
.btn-outline-gold {
    background: transparent;
    color: #e7c874;
    border: 1px solid rgba(231,200,116,0.55);
}
.btn-outline-gold:hover { background: rgba(231,200,116,0.12); border-color: #e7c874; text-decoration: none; }
.btn-gold-large {
    background: var(--color-primary, #e7c874);
    color: #0a0604;
    border: 1px solid var(--color-primary, #e7c874);
    font-size: 1.05rem;
    letter-spacing: 4px;
    padding: 18px 56px;
}
.btn-gold-large:hover { background: transparent; color: var(--color-primary, #e7c874); text-decoration: none; }

/* ─── HERO ─────────────────────────────────── */
.hero {
    position: relative;
    height: 100svh;
    min-height: 600px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
}
.hero-bg {
    position: absolute;
    inset: 0;
    background-image: url('/img/hero-wine.jpg');
    background-size: cover;
    background-position: center 30%;
    transform: scale(1.08);
    transition: transform 12s ease-out;
    will-change: transform;
}
.hero:hover .hero-bg { transform: scale(1.03); }
.hero-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
        to bottom,
        rgba(8,6,4,0.35) 0%,
        rgba(8,6,4,0.20) 40%,
        rgba(8,6,4,0.78) 100%
    );
}
.hero-content {
    position: relative;
    z-index: 2;
    text-align: center;
    color: #fff;
    padding: 0 5vw;
    max-width: 920px;
    animation: heroIn 1.8s cubic-bezier(0.16,1,0.3,1) both;
}
@keyframes heroIn {
    from { opacity: 0; transform: translateY(36px); }
    to   { opacity: 1; transform: translateY(0); }
}
.hero-eyebrow {
    font-family: var(--font-sans-serif);
    font-size: 1.05rem;
    letter-spacing: 5px;
    text-transform: uppercase;
    color: var(--color-primary, #e7c874);
    margin: 0 0 2.5rem;
    display: block;
    opacity: 0.9;
}
.hero-title {
    font-family: var(--font-display);
    font-size: clamp(6rem, 14vw, 14rem);
    font-weight: 200;
    letter-spacing: 14px;
    text-transform: uppercase;
    margin: 0 0 2rem;
    line-height: 1;
    color: #fff;
}
.hero-rule {
    width: 60px;
    height: 1px;
    background: var(--color-primary, #e7c874);
    margin: 0 auto 3rem;
}
.hero-desc {
    font-family: var(--font-serif);
    font-size: clamp(1.7rem, 2.2vw, 2.1rem);
    font-weight: 300;
    font-style: italic;
    line-height: 1.8;
    color: rgba(255,255,255,0.72);
    margin: 0 auto 4rem;
    max-width: 660px;
}
.hero-actions {
    display: flex;
    gap: 1.5rem;
    justify-content: center;
    flex-wrap: wrap;
}
.hero-scroll {
    position: absolute;
    bottom: 2.5rem;
    left: 50%;
    transform: translateX(-50%);
    z-index: 2;
    color: rgba(255,255,255,0.35);
    animation: bounce 2.4s infinite;
    transition: color 0.3s;
    text-decoration: none;
}
.hero-scroll:hover { color: var(--color-primary, #e7c874); }
@keyframes bounce {
    0%,100% { transform: translateX(-50%) translateY(0); }
    55%      { transform: translateX(-50%) translateY(8px); }
}

/* ─── QUOTE CAROUSEL ────────────────────────── */
.quote-section {
    padding: min(10vw, 100px) 5vw min(8vw, 80px);
    display: flex;
    justify-content: center;
    background: var(--color-bg);
}
.quote-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    max-width: 780px;
    width: 100%;
    gap: 3rem;
    text-align: center;
}
.progress-ring-wrap {
    position: relative;
    width: 52px;
    height: 52px;
    flex-shrink: 0;
}
.progress-ring__bg {
    fill: none;
    stroke: var(--color-border);
    stroke-width: 1.5;
}
.progress-ring__circle {
    fill: none;
    stroke: var(--color-primary);
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-dasharray: 138.23; /* 2π×22 */
    stroke-dashoffset: 138.23;
    transform: rotate(-90deg);
    transform-origin: 26px 26px;
}
.progress-ring__count {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-display);
    font-size: 1.5rem;
    color: var(--color-base);
    opacity: 0.5;
}
.quote-list {
    list-style: none;
    margin: 0;
    padding: 0;
    position: relative;
    min-height: 280px;
    width: 100%;
}
.quote-item {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2.5rem;
    opacity: 0;
    transform: translateY(16px);
    transition: opacity 0.7s ease, transform 0.7s ease;
    pointer-events: none;
}
.quote-item.revealed {
    opacity: 1;
    transform: none;
    pointer-events: auto;
    position: relative;
}
.quote-text {
    font-family: var(--font-serif);
    font-size: clamp(1.9rem, 2.5vw, 2.5rem);
    font-style: italic;
    font-weight: 400;
    line-height: 1.82;
    color: var(--color-base);
    opacity: 0.88;
    margin: 0;
    padding: 0 1rem;
    border: none;
    quotes: none;
}
.quote-text::before, .quote-text::after { content: none; }
.quote-cite {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.55rem;
    font-style: normal;
}
.quote-score {
    font-family: var(--font-display);
    font-size: 3.5rem;
    font-weight: 300;
    color: var(--color-primary);
    letter-spacing: 4px;
    line-height: 1;
}
.quote-source {
    font-family: var(--font-sans-serif);
    font-size: 1.05rem;
    letter-spacing: 2.5px;
    text-transform: uppercase;
    color: var(--color-base);
    opacity: 0.52;
}
.quote-wine {
    font-family: var(--font-serif);
    font-size: 1.5rem;
    font-style: italic;
    color: var(--color-base);
    opacity: 0.38;
}
.quote-dots {
    display: flex;
    gap: 12px;
    align-items: center;
}
.quote-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--color-border);
    border: none;
    cursor: pointer;
    padding: 0;
    transition: background 0.3s, transform 0.3s;
}
.quote-dot.active {
    background: var(--color-primary);
    transform: scale(1.4);
}

/* ─── STATEMENT ─────────────────────────────── */
.statement-section {
    padding: min(14vw, 140px) 8vw;
    text-align: center;
    border-top: 1px solid var(--color-border);
}
.statement-inner {
    max-width: 820px;
    margin: 0 auto;
}
.statement-heading {
    font-family: var(--font-display);
    font-size: clamp(3.4rem, 5.5vw, 6.5rem);
    font-weight: 300;
    font-style: normal;
    line-height: 1.38;
    color: var(--color-base);
    margin: 0 0 3.5rem;
    letter-spacing: 1px;
}
.statement-heading em {
    font-style: italic;
    color: var(--color-primary);
}
.statement-body {
    font-family: var(--font-serif);
    font-size: clamp(1.7rem, 1.8vw, 2rem);
    line-height: 1.85;
    color: var(--color-base);
    opacity: 0.62;
    max-width: 640px;
    margin: 0 auto 3rem;
}

/* ─── FEATURED WINE ─────────────────────────── */
.feature-section {
    display: grid;
    grid-template-columns: 55% 1fr;
    min-height: 88vh;
    border-top: 1px solid var(--color-border);
    overflow: hidden;
}
.feature-img-wrap {
    position: relative;
    overflow: hidden;
}
.feature-img-inner {
    width: 100%;
    height: 100%;
    overflow: hidden;
}
.feature-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.06);
    transition: transform 10s cubic-bezier(0.16,1,0.3,1);
    display: block;
}
.feature-section:hover .feature-img { transform: scale(1); }
.feature-score-badge {
    position: absolute;
    bottom: 3rem;
    left: 3rem;
    display: flex;
    align-items: baseline;
    gap: 4px;
    background: rgba(8,6,4,0.72);
    backdrop-filter: blur(8px);
    padding: 1.2rem 2rem;
    border: 1px solid rgba(231,200,116,0.3);
}
.feature-score-num {
    font-family: var(--font-display);
    font-size: 5.5rem;
    font-weight: 200;
    color: #e7c874;
    line-height: 1;
}
.feature-score-pts {
    font-family: var(--font-sans-serif);
    font-size: 1rem;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: rgba(231,200,116,0.65);
}
.feature-content {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: min(8vw, 80px) min(7vw, 80px);
}
.feature-title {
    font-family: var(--font-display);
    font-size: clamp(3rem, 5vw, 5.5rem);
    font-weight: 300;
    letter-spacing: 3px;
    line-height: 1.12;
    color: var(--color-base);
    margin: 0 0 1.5rem;
    text-transform: uppercase;
}
.feature-meta {
    font-family: var(--font-serif);
    font-size: 1.5rem;
    font-style: italic;
    color: var(--color-base);
    opacity: 0.45;
    margin: 0 0 2rem;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
}
.feature-rule {
    width: 40px;
    height: 1px;
    background: var(--color-primary);
    margin-bottom: 2.5rem;
    opacity: 0.8;
}
.feature-desc {
    font-family: var(--font-serif);
    font-size: clamp(1.6rem, 1.8vw, 1.95rem);
    font-style: italic;
    line-height: 1.8;
    color: var(--color-base);
    opacity: 0.62;
    margin: 0 0 1.5rem;
}
.feature-critic {
    font-family: var(--font-sans-serif);
    font-size: 1.05rem;
    letter-spacing: 1.5px;
    color: var(--color-base);
    opacity: 0.5;
    margin: 0 0 3rem;
    text-transform: uppercase;
}
.feature-critic strong {
