---
import Layout from '../layouts/Layout.astro';
import { type CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'pages'>;
}

const { entry } = Astro.props;
const { Content } = await entry.render();

const vineyards = [
  {
    name: 'The Lion Block',
    spec: '18 acres · Volcanic basalt · East-facing · 1,200 ft',
    note: 'The oldest and most prestigious parcel, source of Leonidas Cabernet Sauvignon.'
  },
  {
    name: 'The Ridge Block',
    spec: '8 acres · Rocky loam · South-facing · 1,450 ft',
    note: 'The highest site on the estate, delivering structure and mountain tension.'
  },
  {
    name: 'The Fog Block',
    spec: '6 acres · Goldridge sandy loam · West-facing',
    note: 'Marine influence preserves aromatic lift and natural acidity for white and Pinot lots.'
  },
  {
    name: 'The Stone Terrace',
    spec: '5 acres · Alluvial gravel · Flat valley floor',
    note: 'Drainage stress shapes concentration and textural depth in blending components.'
  },
  {
    name: 'The Palisades',
    spec: '3 acres · Volcanic face · Southwest · Steep slope',
    note: 'A dramatic, low-yield cliff parcel producing intensely concentrated Petite Sirah.'
  }
];

const philosophy = [
  {
    title: 'Less Is The Only Answer',
    text: 'The finest vintages are rarely the ones with the most intervention. We pursue precision through subtraction, not amplification.'
  },
  {
    title: 'Farming Before Cellar',
    text: 'Biodynamics is not aesthetic for us. It is a practical framework for healthier soil, balanced canopies, and truer site expression.'
  },
  {
    title: 'Pleasure Over Points',
    text: 'Scores are welcome but secondary. A wine succeeds when it asks for a second glass, not when it wins the loudest headline.'
  },
  {
    title: 'Rarity With Purpose',
    text: 'Limited production is a discipline that protects quality. We grow only what we can farm and finish at estate level of detail.'
  }
];

const faq = [
  {
    q: 'How do I purchase the wines?',
    a: 'Most wines are offered through allocation first. Join the list through the contact page. A limited quantity reaches selected restaurants and retail partners.'
  },
  {
    q: 'What is the allocation list?',
    a: 'Members receive the first offer on new releases each spring and autumn. There is no minimum commitment and membership is complimentary.'
  },
  {
    q: 'Can I visit the estate?',
    a: 'Yes. Private tastings are available by appointment Thursday through Sunday. Visit the Wine Tasting page for details.'
  },
  {
    q: 'Do you ship internationally?',
    a: 'We ship across U.S. states where law permits. International delivery is arranged through partner channels case by case.'
  },
  {
    q: 'How should I store and serve the wines?',
    a: 'Store bottles horizontally around 55-58°F. Cabernet-based wines benefit from 2-3 hours of decanting. Whites show best around 52-56°F.'
  },
  {
    q: 'Are the wines vegan?',
    a: 'Yes. We do not fine with animal products, and vintages from 2018 onward are certified vegan.'
  }
];

const pageTitle = entry.data.title || 'Maison';
const pageDescription = entry.data.description || 'Estate editorial';
---

<Layout title={pageTitle} description={pageDescription}>
  {entry.slug === 'vineyards' && (
    <article class="signature vineyards-page">
      <section class="vine-hero">
        <div class="vine-hero-bg drift" data-drift="0.07"></div>
        <div class="vine-hero-overlay"></div>
        <div class="vine-hero-inner" data-reveal="up">
          <span class="sig-kicker">Vineyards</span>
          <h1>Five Blocks.<br />One Signature.</h1>
          <p>Topography, exposure, and soil architecture define every Maison wine before the cellar begins.</p>
        </div>
      </section>

      <section class="vine-orbit-wrap">
        <div class="vine-core" data-reveal="scale">
          <span>42</span>
          <small>Estate Acres</small>
        </div>
        <div class="vine-orbit" aria-hidden="true"></div>
        <div class="vine-grid">
          {vineyards.map((block, i) => (
            <article class="vine-node" data-reveal="up" data-delay={String((i % 3) + 1)}>
              <h2>{block.name}</h2>
              <p class="vine-spec">{block.spec}</p>
              <p>{block.note}</p>
            </article>
          ))}
        </div>
      </section>

      <section class="signature-body" data-reveal="up">
        <Content />
      </section>
    </article>
  )}

  {entry.slug === 'philosophy' && (
    <article class="signature philosophy-page">
      <section class="phi-hero">
        <div class="phi-ring phi-ring-a"></div>
        <div class="phi-ring phi-ring-b"></div>
        <div class="phi-hero-inner" data-reveal="up">
          <span class="sig-kicker">Philosophy</span>
          <h1>Elegance Is<br />An Edit.</h1>
          <p>Everything unnecessary is removed so what remains can speak with clarity.</p>
        </div>
      </section>

      <section class="phi-manifesto">
        {philosophy.map((item, i) => (
          <article class={`phi-line phi-line-${(i % 4) + 1}`} data-reveal="up">
            <h2>{item.title}</h2>
            <p>{item.text}</p>
          </article>
        ))}
      </section>

      <section class="signature-body" data-reveal="up">
        <Content />
      </section>
    </article>
  )}

  {entry.slug === 'faq' && (
    <article class="signature faq-page">
      <section class="faq-hero">
        <div class="faq-hero-text" data-reveal="up">
          <span class="sig-kicker">FAQ</span>
          <h1>Questions,<br />Quietly Answered</h1>
          <p>Practical details for collectors, guests, and allocation members.</p>
        </div>
      </section>

      <section class="faq-cloud">
        {faq.map((item, i) => (
          <details class="faq-bubble" data-reveal="up" data-delay={String((i % 3) + 1)}>
            <summary>
              <span>{item.q}</span>
              <span class="faq-plus" aria-hidden="true">+</span>
            </summary>
            <p>{item.a}</p>
          </details>
        ))}
      </section>

      <section class="signature-body" data-reveal="up">
        <Content />
      </section>
    </article>
  )}
</Layout>

<style>
.signature {
  padding-bottom: min(10vw, 110px);
}
.sig-kicker {
  font-family: var(--font-sans-serif);
  font-size: 0.9rem;
  letter-spacing: 4px;
  text-transform: uppercase;
  color: var(--color-primary);
}
.signature-body {
  max-width: 940px;
  margin: min(8vw, 90px) auto 0;
  padding: 0 6vw;
  border-top: 1px solid var(--color-border);
  padding-top: min(5vw, 56px);
}
.signature-body :global(h2) {
  font-family: var(--font-display);
  font-size: clamp(2.5rem, 3vw, 3.6rem);
  font-weight: 300;
  letter-spacing: 2px;
  text-transform: uppercase;
}
.signature-body :global(p),
.signature-body :global(li) {
  font-size: 1.62rem;
  line-height: 1.8;
  opacity: 0.74;
}
.drift {
  transform: translate3d(0, calc(var(--drift-y, 0) * 1px), 0);
}

/* Vineyards */
.vine-hero {
  position: relative;
  min-height: 86vh;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}
.vine-hero-bg {
  position: absolute;
  inset: -8%;
  background-image: url('/img/vineyard-landscape.jpg');
  background-size: cover;
  background-position: center;
}
.vine-hero-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(to bottom, rgba(8, 6, 4, 0.34), rgba(8, 6, 4, 0.8));
}
.vine-hero-inner {
  position: relative;
  z-index: 2;
  text-align: center;
  max-width: 900px;
  padding: 0 6vw;
}
.vine-hero-inner h1 {
  margin: 1.8rem 0;
  font-family: var(--font-display);
  font-size: clamp(4.6rem, 10vw, 9.8rem);
  line-height: 1.03;
  letter-spacing: 7px;
  text-transform: uppercase;
  font-weight: 300;
  color: #f2ecde;
}
.vine-hero-inner p {
  margin: 0;
  color: rgba(242, 236, 222, 0.74);
  font-style: italic;
  font-size: clamp(1.5rem, 2vw, 2rem);
}
.vine-orbit-wrap {
  margin: min(7vw, 86px) auto 0;
  max-width: 1240px;
  padding: 0 6vw;
  position: relative;
}
.vine-orbit {
  position: absolute;
  top: 2rem;
  left: 50%;
  width: min(70vw, 760px);
  aspect-ratio: 1;
  transform: translateX(-50%);
  border-radius: 50%;
  border: 1px dashed color(var(--color-border) a(65%));
  animation: spinSlow 36s linear infinite;
}
@keyframes spinSlow {
  from { transform: translateX(-50%) rotate(0deg); }
  to { transform: translateX(-50%) rotate(360deg); }
}
.vine-core {
  position: relative;
  z-index: 2;
  width: 180px;
  aspect-ratio: 1;
  border-radius: 50%;
  margin: 0 auto 3.5rem;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 1px solid var(--color-border);
  background: radial-gradient(circle at 35% 30%, rgba(231, 200, 116, 0.2), transparent 68%);
}
.vine-core span {
  font-family: var(--font-display);
  font-size: 4.8rem;
  line-height: 1;
  color: var(--color-primary);
}
.vine-core small {
  font-family: var(--font-sans-serif);
  font-size: 0.75rem;
  text-transform: uppercase;
  letter-spacing: 2.5px;
  opacity: 0.58;
}
.vine-grid {
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 1.1rem;
}
.vine-node {
  padding: 1.4rem 1rem;
  text-align: center;
}
.vine-node h2 {
  margin: 0 0 0.6rem;
  font-family: var(--font-display);
  font-weight: 300;
  font-size: clamp(1.5rem, 2vw, 2.2rem);
  text-transform: uppercase;
  letter-spacing: 1px;
}
.vine-spec {
  margin: 0 0 0.8rem;
  font-family: var(--font-sans-serif);
  text-transform: uppercase;
  font-size: 0.72rem;
  letter-spacing: 1.7px;
  color: var(--color-primary);
}
.vine-node p {
  margin: 0;
  font-size: 1.32rem;
  line-height: 1.62;
  opacity: 0.7;
}

/* Philosophy */
.phi-hero {
  min-height: 74vh;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  position: relative;
  overflow: hidden;
  padding: 0 6vw;
}
.phi-ring {
  position: absolute;
  border-radius: 50%;
  border: 1px solid color(var(--color-border) a(70%));
}
.phi-ring-a {
  width: min(76vw, 920px);
  aspect-ratio: 1;
  animation: pulseA 8s ease-in-out infinite;
}
.phi-ring-b {
  width: min(56vw, 660px);
  aspect-ratio: 1;
  animation: pulseB 8s ease-in-out infinite;
}
@keyframes pulseA {
  0%, 100% { transform: scale(1); opacity: 0.5; }
  50% { transform: scale(1.04); opacity: 0.82; }
}
@keyframes pulseB {
  0%, 100% { transform: scale(1.05); opacity: 0.52; }
  50% { transform: scale(0.98); opacity: 0.86; }
}
.phi-hero-inner {
  position: relative;
  z-index: 2;
  max-width: 800px;
}
.phi-hero-inner h1 {
  margin: 1.8rem 0;
  font-family: var(--font-display);
  font-size: clamp(4.2rem, 9vw, 8.8rem);
  font-weight: 300;
  letter-spacing: 6px;
  line-height: 1.05;
  text-transform: uppercase;
}
.phi-hero-inner p {
  margin: 0;
  font-size: clamp(1.5rem, 1.9vw, 2rem);
  font-style: italic;
  opacity: 0.7;
}
.phi-manifesto {
  max-width: 1160px;
  margin: min(7vw, 80px) auto 0;
  padding: 0 6vw;
  display: grid;
  gap: min(2vw, 26px);
}
.phi-line {
  position: relative;
  padding: 1.8rem 1.4rem 1.8rem 2rem;
}
.phi-line::before {
  content: '';
  position: absolute;
  left: 0;
  top: 20%;
  bottom: 20%;
  width: 1px;
  background: var(--color-border);
}
.phi-line h2 {
  margin: 0 0 0.7rem;
  font-family: var(--font-display);
  font-size: clamp(2.2rem, 2.8vw, 3.3rem);
  font-weight: 300;
  letter-spacing: 1.6px;
  text-transform: uppercase;
}
.phi-line p {
  margin: 0;
  font-size: 1.55rem;
  line-height: 1.76;
  opacity: 0.72;
}
.phi-line-2,
.phi-line-4 {
  margin-left: 10%;
}

/* FAQ */
.faq-hero {
  min-height: 66vh;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: 0 6vw;
}
.faq-hero-text {
  max-width: 800px;
}
.faq-hero h1 {
  margin: 1.6rem 0;
  font-family: var(--font-display);
  font-size: clamp(4rem, 9vw, 8.4rem);
  font-weight: 300;
  text-transform: uppercase;
  letter-spacing: 6px;
  line-height: 1.05;
}
.faq-hero p {
  margin: 0;
  font-size: clamp(1.45rem, 1.8vw, 1.95rem);
  font-style: italic;
  opacity: 0.68;
}
.faq-cloud {
  max-width: 1120px;
  margin: min(5vw, 60px) auto 0;
  padding: 0 6vw;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: min(2vw, 24px);
}
.faq-bubble {
  border: 1px solid var(--color-border);
  border-radius: 55% 45% 52% 48% / 44% 56% 48% 52%;
  background: linear-gradient(145deg, color(var(--color-bg) l(-1%)), color(var(--color-bg) l(+2%)));
  padding: 1.3rem 1.5rem;
}
.faq-bubble summary {
  list-style: none;
  cursor: pointer;
  display: flex;
  justify-content: space-between;
  gap: 1rem;
  align-items: center;
}
.faq-bubble summary::-webkit-details-marker { display: none; }
.faq-bubble summary span:first-child {
  font-family: var(--font-display);
  font-size: clamp(1.8rem, 2.4vw, 2.8rem);
  line-height: 1.26;
}
.faq-plus {
  font-family: var(--font-sans-serif);
  font-size: 2rem;
  color: var(--color-primary);
  transition: transform 0.24s ease;
}
.faq-bubble[open] .faq-plus {
  transform: rotate(45deg);
}
.faq-bubble p {
  margin: 1rem 0 0;
  font-size: 1.4rem;
  line-height: 1.75;
  opacity: 0.75;
}

[data-theme='dark'] .faq-bubble {
  background: linear-gradient(145deg, #110d09, #0e0a07);
}

@media (max-width: 1080px) {
  .vine-grid {
    grid-template-columns: repeat(2, 1fr);
    gap: 1.2rem;
  }
  .vine-orbit {
    display: none;
  }
  .phi-line-2,
  .phi-line-4 {
    margin-left: 0;
  }
}
@media (max-width: 740px) {
  .faq-cloud {
    grid-template-columns: 1fr;
  }
  .vine-grid {
    grid-template-columns: 1fr;
  }
}
</style>

<script>
(function() {
  function initSignatureParallax() {
    const drifters = Array.from(document.querySelectorAll<HTMLElement>('.signature [data-drift]'));
    if (!drifters.length) return;
    const onScroll = () => {
      const y = window.scrollY;
      drifters.forEach((el) => {
        const ratio = Number(el.dataset.drift || '0');
        el.style.setProperty('--drift-y', String(-y * ratio * 0.12));
      });
    };
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
    document.addEventListener('astro:before-swap', () => window.removeEventListener('scroll', onScroll), { once: true });
  }

  document.addEventListener('astro:page-load', initSignatureParallax);
  initSignatureParallax();
})();
</script>
