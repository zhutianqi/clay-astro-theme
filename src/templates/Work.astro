---
import Layout from '../layouts/Layout.astro';
import { type CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'work'> | CollectionEntry<'news'> | CollectionEntry<'sold'>;
  next?: any;
  prev?: any;
  baseSlug?: string;
}

const { entry, next, prev, baseSlug } = Astro.props;
const { Content } = await entry.render();

const { title, description, thumbnail, rating, critic, vintage, varietal, appellation, price, production } = entry.data;
const hasWineData = varietal || vintage || appellation || price || production;
---

<Layout title={title} description={description}>
  <article class="wine-detail">

    {thumbnail && (
      <div class="wine-hero-img">
        <img src={thumbnail} alt={title} class="wine-hero-photo" />
        <div class="wine-hero-fade"></div>
      </div>
    )}

    <div class="wine-body">

      <header class="wine-header" data-reveal="up">
        {varietal && <p class="wine-varietal">{varietal}</p>}
        <h1 class="wine-title">{title}</h1>
        {appellation && <p class="wine-appellation">{appellation}{vintage ? ` · ${vintage}` : ''}</p>}
        <div class="wine-header-rule"></div>
      </header>

      {/* Score — large editorial number, no box */}
      {rating && (
        <div class="wine-score-display" data-reveal="up" data-delay="1">
          <div class="wine-score-main">
            <span class="wine-score-number">{rating}</span>
            <span class="wine-score-pts">Points</span>
          </div>
          {critic && <p class="wine-score-critic">{critic}</p>}
        </div>
      )}

      {/* Specs — editorial lines, no grid cells */}
      {hasWineData && (
        <div class="wine-specs-editorial" data-reveal="up" data-delay="2">
          {(varietal || vintage) && (
            <p class="wine-specs-primary">
              {[varietal, vintage].filter(Boolean).join(' · ')}
            </p>
          )}
          {appellation && <p class="wine-specs-secondary">{appellation}</p>}
          {(price || production) && (
            <p class="wine-specs-tertiary">
              {[price, production].filter(Boolean).join(' · ')}
            </p>
          )}
        </div>
      )}

      {description && <p class="wine-excerpt" data-reveal="up">{description}</p>}

      <div class="post-content-body" data-reveal="up">
        <Content />
      </div>

      <div class="wine-cta" data-reveal="up">
        <a href="/contact" class="wine-cta-link">
          <span>Enquire About This Wine</span>
          <span class="wine-cta-arrow" aria-hidden="true">→</span>
        </a>
      </div>

      {(next || prev) && (
        <nav class="wine-nav">
          <div class="wine-nav-prev">
            {next && (
              <a href={`/${baseSlug}/${next.slug}`} class="wine-nav-link">
                <span class="wine-nav-dir">← Previous</span>
                <span class="wine-nav-title">{next.data.title}</span>
              </a>
            )}
          </div>
          <div class="wine-nav-next">
            {prev && (
              <a href={`/${baseSlug}/${prev.slug}`} class="wine-nav-link">
                <span class="wine-nav-dir">Next →</span>
                <span class="wine-nav-title">{prev.data.title}</span>
              </a>
            )}
          </div>
        </nav>
      )}

    </div>
  </article>
</Layout>

<style>
.wine-detail { max-width: 100%; }

/* ── Hero image — Ken Burns cinematic zoom ── */
.wine-hero-img {
  position: relative;
  width: 100%;
  height: 75vh;
  min-height: 480px;
  overflow: hidden;
}
.wine-hero-photo {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
  display: block;
  animation: kenburns 14s ease-out forwards;
}
@keyframes kenburns {
  0%   { transform: scale(1.08); }
  100% { transform: scale(1); }
}
.wine-hero-fade {
  position: absolute;
  inset: 0;
  background: linear-gradient(to bottom, rgba(0,0,0,0.08) 0%, transparent 30%, var(--color-bg) 100%);
}

/* ── Body container ── */
.wine-body {
  max-width: 760px;
  margin: 0 auto;
  padding: 4rem 4vw 6rem;
}

/* ── Header ── */
.wine-header { text-align: center; margin-bottom: 4rem; }
.wine-varietal {
  font-family: var(--font-sans-serif);
  font-size: 1rem;
  letter-spacing: 4px;
  text-transform: uppercase;
  color: var(--color-primary);
  margin: 0 0 1.2rem;
}
.wine-title {
  font-family: var(--font-display);
  font-size: clamp(3rem, 6vw, 5.5rem);
  font-weight: 300;
  letter-spacing: 4px;
  text-transform: uppercase;
  color: var(--color-base);
  margin: 0 0 1rem;
  line-height: 1.15;
}
.wine-appellation {
  font-family: var(--font-serif);
  font-size: 1.6rem;
  font-style: italic;
  color: var(--color-base);
  opacity: 0.42;
  margin: 0;
}
.wine-header-rule {
  width: 36px;
  height: 1px;
  background: var(--color-primary);
  margin: 2rem auto 0;
  opacity: 0.6;
}

/* ── Score — large typographic display, no box ── */
.wine-score-display {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 1.2rem;
  padding: 4rem 0 3.5rem;
  text-align: center;
}
.wine-score-main {
  display: flex;
  align-items: flex-start;
  gap: 1.2rem;
}
.wine-score-number {
  font-family: var(--font-display);
  font-size: clamp(9rem, 22vw, 15rem);
  font-weight: 200;
  line-height: 0.82;
  color: var(--color-primary);
  letter-spacing: -6px;
}
.wine-score-pts {
  font-family: var(--font-sans-serif);
  font-size: 0.82rem;
  letter-spacing: 4px;
  text-transform: uppercase;
  opacity: 0.35;
  color: var(--color-base);
  padding-top: 1.2rem;
}
.wine-score-critic {
  font-family: var(--font-serif);
  font-size: 2rem;
  font-style: italic;
  color: var(--color-base);
  opacity: 0.42;
  margin: 0;
}

/* ── Specs — editorial lines, no grid ── */
.wine-specs-editorial {
  text-align: center;
  margin-bottom: 4.5rem;
}
.wine-specs-primary {
  font-family: var(--font-sans-serif);
  font-size: 1rem;
  letter-spacing: 4px;
  text-transform: uppercase;
  color: var(--color-base);
  opacity: 0.58;
  margin: 0 0 0.6rem;
}
.wine-specs-secondary {
  font-family: var(--font-serif);
  font-size: 1.85rem;
  font-style: italic;
  color: var(--color-base);
  opacity: 0.36;
  margin: 0 0 0.5rem;
}
.wine-specs-tertiary {
  font-family: var(--font-sans-serif);
  font-size: 0.88rem;
  letter-spacing: 2.5px;
  text-transform: uppercase;
  color: var(--color-base);
  opacity: 0.26;
  margin: 0;
}

/* ── Excerpt ── */
.wine-excerpt {
  font-family: var(--font-serif);
  font-size: 2rem;
  font-style: italic;
  line-height: 1.72;
  color: var(--color-base);
  opacity: 0.58;
  text-align: center;
  margin: 0 0 3.5rem;
}

/* ── Body content ── */
.post-content-body {
  font-size: 1.75rem;
  line-height: 1.78;
  color: var(--color-base);
  margin-bottom: 4rem;
}
.post-content-body h2 {
  font-family: var(--font-display);
  font-size: 2.6rem;
  font-weight: 300;
  letter-spacing: 3px;
  text-transform: uppercase;
  margin: 3.5rem 0 1.5rem;
  color: var(--color-base);
}
.post-content-body h3 {
  font-family: var(--font-sans-serif);
  font-size: 1rem;
  letter-spacing: 3px;
  text-transform: uppercase;
  color: var(--color-primary);
  margin: 2.5rem 0 1rem;
}
.post-content-body blockquote {
  border-left: 1px solid var(--color-primary);
  padding: 0.5rem 0 0.5rem 2.5rem;
  margin: 3rem 0;
}
.post-content-body blockquote p {
  font-style: italic;
  font-size: 1.85rem;
  color: var(--color-base);
  opacity: 0.65;
  margin: 0;
}
.post-content-body strong { color: var(--color-primary); }
.post-content-body ul, .post-content-body ol {
  padding-left: 1.5rem;
  margin: 1rem 0;
  list-style: disc;
}
.post-content-body li { margin-bottom: 0.4rem; }
.post-content-body table {
  width: 100%;
  border-collapse: collapse;
  margin: 2rem 0;
  font-size: 1.5rem;
}
.post-content-body th, .post-content-body td {
  padding: 10px 14px;
  border-bottom: 1px solid var(--color-border);
  text-align: left;
}
.post-content-body th {
  font-family: var(--font-sans-serif);
  letter-spacing: 1.5px;
  text-transform: uppercase;
  font-size: 0.85rem;
  opacity: 0.4;
}

/* ── CTA — animated underline text link ── */
.wine-cta {
  text-align: center;
  padding: 5rem 0;
}
.wine-cta-link {
  font-family: var(--font-sans-serif);
  font-size: 1.05rem;
  letter-spacing: 4px;
  text-transform: uppercase;
  color: var(--color-primary);
  text-decoration: none;
  display: inline-flex;
  align-items: center;
  gap: 1.2rem;
  position: relative;
  padding-bottom: 8px;
  transition: gap 0.4s cubic-bezier(0.2,0,0,1);
}
.wine-cta-link::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 1px;
  background: var(--color-primary);
  transform: scaleX(0);
  transform-origin: right;
  transition: transform 0.45s cubic-bezier(0.2,0,0,1);
}
.wine-cta-link:hover {
  gap: 2rem;
  text-decoration: none;
}
.wine-cta-link:hover::after {
  transform: scaleX(1);
  transform-origin: left;
}
.wine-cta-arrow {
  transition: transform 0.4s cubic-bezier(0.2,0,0,1);
  display: inline-block;
}
.wine-cta-link:hover .wine-cta-arrow {
  transform: translateX(6px);
}

/* ── Prev/next navigation ── */
.wine-nav {
  display: flex;
  justify-content: space-between;
  gap: 2rem;
  padding-top: 4rem;
  border-top: 1px solid var(--color-border);
}
.wine-nav-link {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
  text-decoration: none;
  color: var(--color-base);
  transition: color 0.22s;
}
.wine-nav-link:hover { color: var(--color-primary); text-decoration: none; }
.wine-nav-dir {
  font-family: var(--font-sans-serif);
  font-size: 0.85rem;
  letter-spacing: 2px;
  text-transform: uppercase;
  opacity: 0.32;
}
.wine-nav-title {
  font-family: var(--font-display);
  font-size: 1.8rem;
  font-weight: 300;
}
.wine-nav-next { text-align: right; }

@media (max-width: 600px) {
  .wine-score-number { font-size: clamp(7rem, 28vw, 10rem); letter-spacing: -3px; }
  .wine-nav { flex-direction: column; }
  .wine-nav-next { text-align: left; }
}
</style>
