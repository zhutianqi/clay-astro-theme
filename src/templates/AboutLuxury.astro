<script>
(function() {
  function initAboutMotion() {
    const drifters = Array.from(document.querySelectorAll('[data-drift]'));
    if (!drifters.length) return;

    const onScroll = () => {
      const y = window.scrollY;
      drifters.forEach((el) => {
        const ratio = Number(el.getAttribute('data-drift')) || 0;
        el.style.setProperty('--drift-y', String(y * ratio * -0.12));
      });
    };

    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
    document.addEventListener('astro:before-swap', () => {
      window.removeEventListener('scroll', onScroll);
    }, { once: true });
  }

  document.addEventListener('astro:page-load', initAboutMotion);
  initAboutMotion();
})();
</script>
