---
import Layout from '../layouts/Layout.astro';
import { type CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'pages'>;
}

interface AboutConfig {
  eyebrow: string;
  title: string;
  subtitle: string;
  heroImage: string;
  lead: string;
  pullQuote: string;
  quoteBy: string;
  stats: Array<{ label: string; value: string }>;
  pillars: Array<{ title: string; body: string }>;
  gallery: string[];
}

const { entry } = Astro.props;
const { Content } = await entry.render();

const configs: Record<string, AboutConfig> = {
  'bio': {
    eyebrow: 'About The Estate',
    title: 'A Legacy\nPoured Slowly',
    subtitle: 'Napa Valley · Since 1989',
    heroImage: '/img/wine-estate.jpg',
    lead: 'Maison was founded on a simple belief: true luxury is never rushed. Every vine is farmed by hand, every parcel harvested in multiple passes, and every barrel judged with patience instead of ego.',
    pullQuote: 'Luxury is not excess. Luxury is precision, repeated year after year.',
    quoteBy: 'Catherine Renard, Co-Founder',
    stats: [
      { label: 'Estate Acres', value: '42' },
      { label: 'Annual Cases', value: '2,500' },
      { label: 'Harvest Passes', value: '3-5' }
    ],
    pillars: [
      { title: 'Stewardship First', body: 'Each block is farmed as an independent ecosystem. Soil vitality and vine balance lead every decision before cellar ambition.' },
      { title: 'Small By Intent', body: 'Production remains deliberately limited so every cuvee can be tracked, tasted, and refined by the same core team.' },
      { title: 'Service Without Noise', body: 'Allocation members receive direct estate access, vintage briefings, and private hospitality designed around discretion.' }
    ],
    gallery: ['/img/vineyard-landscape.jpg', '/img/wine-cellar-bottles.jpg', '/img/wine-pour.jpg']
  },
  'our-story': {
    eyebrow: 'Our Story',
    title: 'From One Acre\nTo An Icon',
    subtitle: 'Three Decades Of Craft',
    heroImage: '/img/vineyard-landscape.jpg',
    lead: 'What began as a single experimental acre in 1989 became a quietly influential estate because growth was never the goal. Character was.',
    pullQuote: 'We expanded only when we could farm better, not bigger.',
    quoteBy: 'Thomas Renard, Founder',
    stats: [
      { label: 'First Vintage', value: '1992' },
      { label: 'Estate Blocks', value: '5' },
      { label: 'Core Team Years', value: '14+' }
    ],
    pillars: [
      { title: '1989-1999', body: 'The first decade established a Cabernet-focused identity rooted in hillside structure and restrained extraction.' },
      { title: '2000-2014', body: 'Selective acquisitions added altitude and aspect diversity, enabling a finer architectural style across blends.' },
      { title: '2015-Today', body: 'A second generation now leads farming and hospitality while preserving the estate signature of clarity and length.' }
    ],
    gallery: ['/img/wine-barrels.jpg', '/img/wine-bottle-label.jpg', '/img/wine-estate.jpg']
  },
  'winemaker': {
    eyebrow: 'The Winemaker',
    title: 'Elena Marchand',
    subtitle: 'Restraint · Precision · Place',
    heroImage: '/img/wine-tasting.jpg',
    lead: 'After formative years in Bordeaux and Burgundy, Elena brought a disciplined, terroir-first philosophy to Maison. Her approach favors texture, line, and longevity over immediacy.',
    pullQuote: 'The vineyard already knows the answer. The cellar should not interrupt it.',
    quoteBy: 'Elena Marchand',
    stats: [
      { label: 'Joined Maison', value: '2011' },
      { label: 'Estate Biodynamic', value: '100%' },
      { label: 'Top Score', value: '98 pts' }
    ],
    pillars: [
      { title: 'Farming Discipline', body: 'Cover crops, low-water strategy, and meticulous canopy work keep fruit expression luminous and site-true.' },
      { title: 'Cellar Philosophy', body: 'Native fermentations, gentle extraction, and measured élevage preserve aromatic precision and structural grace.' },
      { title: 'Signature Outcome', body: 'Wines of aromatic lift, mineral backbone, and layered finish that evolve confidently across years in cellar.' }
    ],
    gallery: ['/img/wine-red-glass.jpg', '/img/wine-cellar-bottles.jpg', '/img/wine-tasting.jpg']
  }
};

const fallback: AboutConfig = {
  eyebrow: 'Maison',
  title: entry.data.title || 'Maison',
  subtitle: entry.data.description || 'Estate Journal',
  heroImage: entry.data.thumbnail || '/img/wine-estate.jpg',
  lead: entry.data.description || 'An estate shaped by patient craft and elegant restraint.',
  pullQuote: 'Craft without haste.',
  quoteBy: 'Maison',
  stats: [],
  pillars: [],
  gallery: ['/img/wine-estate.jpg', '/img/vineyard-landscape.jpg', '/img/wine-cellar-bottles.jpg']
};

const config = configs[entry.slug] || fallback;
const titleHtml = config.title.replace('\n', '<br />');
---

<Layout title={entry.data.title} description={entry.data.description}>
  <article class="about-luxe">
    <section class="about-luxe-hero">
      <div class="about-luxe-hero-bg" style={`background-image: url('${config.heroImage}')`}></div>
      <div class="about-luxe-hero-overlay"></div>
      <div class="about-luxe-hero-inner" data-reveal="up">
        <span class="about-luxe-eyebrow">{config.eyebrow}</span>
        <h1 class="about-luxe-title" set:html={titleHtml}></h1>
        <div class="about-luxe-rule"></div>
        <p class="about-luxe-subtitle">{config.subtitle}</p>
      </div>
    </section>

    <section class="about-luxe-intro">
      <div class="about-luxe-intro-copy" data-reveal="left">
        <p class="about-luxe-lead">{config.lead}</p>
      </div>
      <div class="about-luxe-quote" data-reveal="right">
        <blockquote>{config.pullQuote}</blockquote>
        <cite>{config.quoteBy}</cite>
      </div>
    </section>

    {config.stats.length > 0 && (
      <section class="about-luxe-stats" data-reveal="up">
        {config.stats.map((item) => (
          <div class="about-luxe-stat">
            <span class="about-luxe-stat-value">{item.value}</span>
            <span class="about-luxe-stat-label">{item.label}</span>
          </div>
        ))}
      </section>
    )}

    <section class="about-luxe-gallery">
      {config.gallery.map((image, i) => (
        <figure class="about-luxe-gallery-item" data-reveal="up" data-delay={String((i % 3) + 1)}>
          <img src={image} alt={entry.data.title || 'Maison'} loading="lazy" />
        </figure>
      ))}
    </section>

    {config.pillars.length > 0 && (
      <section class="about-luxe-pillars">
        {config.pillars.map((item, i) => (
          <article class="about-luxe-pillar" data-reveal="up" data-delay={String((i % 3) + 1)}>
            <h2>{item.title}</h2>
            <p>{item.body}</p>
          </article>
        ))}
      </section>
    )}

    <section class="about-luxe-journal" data-reveal="up">
      <div class="about-luxe-journal-inner">
        <Content />
      </div>
    </section>

    <section class="about-luxe-cta" data-reveal="scale">
      <p>Request a private tasting experience at the estate.</p>
      <a href="/contact">Contact Maison</a>
    </section>
  </article>
</Layout>

<style>
.about-luxe {
  padding-bottom: min(8vw, 90px);
}

.about-luxe-hero {
  position: relative;
  height: min(92vh, 920px);
  min-height: 560px;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  text-align: center;
}
.about-luxe-hero-bg {
  position: absolute;
  inset: 0;
  background-size: cover;
  background-position: center;
  transform: scale(1.06);
  transition: transform 10s ease-out;
}
.about-luxe-hero:hover .about-luxe-hero-bg { transform: scale(1.01); }
.about-luxe-hero-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(to bottom, rgba(8, 6, 4, 0.36), rgba(8, 6, 4, 0.76));
}
.about-luxe-hero-inner {
  position: relative;
  z-index: 2;
  padding: 0 8vw;
  max-width: 900px;
}
.about-luxe-eyebrow {
  font-family: var(--font-sans-serif);
  letter-spacing: 4.5px;
  text-transform: uppercase;
  font-size: 0.95rem;
  color: #e7c874;
  opacity: 0.9;
}
.about-luxe-title {
  margin: 2rem 0 2.2rem;
  font-family: var(--font-display);
  font-size: clamp(4.2rem, 10vw, 10rem);
  font-weight: 300;
  letter-spacing: 6px;
  text-transform: uppercase;
  line-height: 1.04;
  color: #f2ecdd;
}
.about-luxe-rule {
  width: 54px;
  height: 1px;
  margin: 0 auto 2rem;
  background: #e7c874;
  opacity: 0.75;
}
.about-luxe-subtitle {
  margin: 0;
  font-family: var(--font-serif);
  font-style: italic;
  font-size: clamp(1.5rem, 2vw, 2rem);
  color: rgba(242, 236, 221, 0.72);
}

.about-luxe-intro {
  max-width: 1240px;
  margin: min(8vw, 90px) auto 0;
  padding: 0 6vw;
  display: grid;
  grid-template-columns: 1.3fr 1fr;
  gap: min(7vw, 90px);
  align-items: center;
}
.about-luxe-lead {
  margin: 0;
  font-family: var(--font-serif);
  font-size: clamp(2rem, 2.8vw, 3.1rem);
  font-style: italic;
  line-height: 1.62;
  color: var(--color-base);
  opacity: 0.78;
}
.about-luxe-quote {
  padding: min(4vw, 40px);
  border: 1px solid rgba(198, 154, 86, 0.24);
  background: linear-gradient(180deg, rgba(231, 200, 116, 0.08) 0%, rgba(231, 200, 116, 0.02) 100%);
}
.about-luxe-quote blockquote {
  margin: 0 0 1.4rem;
  padding: 0;
  border: 0;
  font-family: var(--font-serif);
  font-size: clamp(1.7rem, 2.1vw, 2.3rem);
  line-height: 1.68;
  font-style: italic;
  color: var(--color-base);
  opacity: 0.8;
}
.about-luxe-quote cite {
  font-family: var(--font-sans-serif);
  font-size: 0.86rem;
  letter-spacing: 2.8px;
  text-transform: uppercase;
  color: var(--color-primary);
}

.about-luxe-stats {
  max-width: 1240px;
  margin: min(7vw, 80px) auto 0;
  padding: 0 6vw;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 2.2rem;
}
.about-luxe-stat {
  padding: 2rem 1.4rem;
  border-top: 1px solid rgba(198, 154, 86, 0.32);
  text-align: center;
}
.about-luxe-stat-value {
  display: block;
  font-family: var(--font-display);
  font-size: clamp(3.2rem, 5vw, 5rem);
  color: var(--color-primary);
  font-weight: 300;
  line-height: 1;
}
.about-luxe-stat-label {
  display: block;
  margin-top: 0.9rem;
  font-family: var(--font-sans-serif);
  font-size: 0.82rem;
  letter-spacing: 2.8px;
  text-transform: uppercase;
  color: var(--color-base);
  opacity: 0.52;
}

.about-luxe-gallery {
  max-width: 1320px;
  margin: min(7vw, 80px) auto 0;
  padding: 0 6vw;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: min(2.6vw, 30px);
}
.about-luxe-gallery-item {
  margin: 0;
  aspect-ratio: 4 / 5;
  overflow: hidden;
}
.about-luxe-gallery-item img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  transition: transform 0.9s cubic-bezier(0.2, 0, 0, 1);
}
.about-luxe-gallery-item:hover img { transform: scale(1.05); }

.about-luxe-pillars {
  max-width: 1240px;
  margin: min(8vw, 90px) auto 0;
  padding: 0 6vw;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: min(2.6vw, 30px);
}
.about-luxe-pillar {
  padding: min(3vw, 36px);
  border: 1px solid rgba(180, 136, 72, 0.2);
  background: rgba(255, 255, 255, 0.36);
  backdrop-filter: blur(4px);
}
.about-luxe-pillar h2 {
  margin: 0 0 1.3rem;
  font-family: var(--font-display);
  font-size: clamp(2.1rem, 2.6vw, 3rem);
  font-weight: 300;
  letter-spacing: 1.8px;
  text-transform: uppercase;
  color: var(--color-base);
}
.about-luxe-pillar p {
  margin: 0;
  font-family: var(--font-serif);
  font-size: 1.55rem;
  line-height: 1.76;
  font-style: italic;
  color: var(--color-base);
  opacity: 0.66;
}

.about-luxe-journal {
  max-width: 980px;
  margin: min(8vw, 90px) auto 0;
  padding: 0 6vw;
}
.about-luxe-journal-inner {
  border-top: 1px solid rgba(180, 136, 72, 0.25);
  padding-top: min(5vw, 56px);
}
.about-luxe-journal :global(h2) {
  font-family: var(--font-display);
  font-size: clamp(2.4rem, 3vw, 3.4rem);
  font-weight: 300;
  letter-spacing: 2px;
  text-transform: uppercase;
  margin-bottom: 1.4rem;
}
.about-luxe-journal :global(p),
.about-luxe-journal :global(li),
.about-luxe-journal :global(blockquote p) {
  font-size: 1.6rem;
  line-height: 1.8;
  opacity: 0.7;
}

.about-luxe-cta {
  max-width: 820px;
  margin: min(8vw, 90px) auto 0;
  padding: 4.4rem 6vw;
  text-align: center;
  background: #100c08;
}
.about-luxe-cta p {
  margin: 0 0 1.8rem;
  font-family: var(--font-serif);
  font-size: clamp(1.8rem, 2.2vw, 2.3rem);
  font-style: italic;
  color: rgba(242, 236, 221, 0.72);
}
.about-luxe-cta a {
  font-family: var(--font-sans-serif);
  font-size: 0.96rem;
  letter-spacing: 3px;
  text-transform: uppercase;
  color: #e7c874;
  text-decoration: none;
  border-bottom: 1px solid #e7c874;
  padding-bottom: 5px;
}
.about-luxe-cta a:hover {
  color: #ecd28b;
  text-decoration: none;
}

[data-theme='dark'] .about-luxe-lead,
[data-theme='dark'] .about-luxe-quote blockquote,
[data-theme='dark'] .about-luxe-pillar h2 {
  color: #f8f2e5;
}
[data-theme='dark'] .about-luxe-pillar {
  background: rgba(16, 12, 8, 0.55);
  border-color: rgba(218, 174, 103, 0.22);
}
[data-theme='dark'] .about-luxe-pillar p,
[data-theme='dark'] .about-luxe-journal :global(p),
[data-theme='dark'] .about-luxe-journal :global(li),
[data-theme='dark'] .about-luxe-journal :global(blockquote p) {
  color: #f8f2e5;
  opacity: 0.82;
}
[data-theme='dark'] .about-luxe-journal-inner {
  border-color: rgba(218, 174, 103, 0.22);
}

@media (max-width: 1000px) {
  .about-luxe-intro {
    grid-template-columns: 1fr;
    gap: 2rem;
  }
  .about-luxe-stats,
  .about-luxe-gallery,
  .about-luxe-pillars {
    grid-template-columns: 1fr;
  }
}
</style>
