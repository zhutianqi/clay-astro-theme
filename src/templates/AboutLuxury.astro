---
import Layout from '../layouts/Layout.astro';
import { type CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'pages'>;
}

interface BioConfig {
  label: string;
  title: string;
  subtitle: string;
  hero: string;
  sceneA: string;
  sceneB: string;
  lead: string;
  quote: string;
  by: string;
  metrics: Array<{ value: string; label: string }>;
}

interface StoryBeat {
  year: string;
  title: string;
  body: string;
  image: string;
}

interface StoryConfig {
  label: string;
  title: string;
  subtitle: string;
  hero: string;
  beats: StoryBeat[];
}

interface WinemakerConfig {
  label: string;
  name: string;
  subtitle: string;
  hero: string;
  portrait: string;
  manifesto: string;
  quote: string;
  approach: Array<{ title: string; detail: string }>;
  accolades: string[];
}

const { entry } = Astro.props;
const { Content } = await entry.render();

const bioConfig: BioConfig = {
  label: 'About The Estate',
  title: 'A Legacy\nComposed In Silence',
  subtitle: 'Napa Valley · Since 1989',
  hero: '/img/wine-estate.jpg',
  sceneA: '/img/vineyard-landscape.jpg',
  sceneB: '/img/wine-cellar-bottles.jpg',
  lead: 'Maison was built on the conviction that true luxury is slow, quiet, and exacting. Every parcel is harvested by hand, every lot raised with patience, and every release measured against the memory of our finest vintages.',
  quote: 'We do not make wine to impress in a single sip. We make it to stay in memory.',
  by: 'Catherine Renard · Co-Founder',
  metrics: [
    { value: '42', label: 'Estate Acres' },
    { value: '2,500', label: 'Cases Per Year' },
    { value: '3-5', label: 'Selective Passes' }
  ]
};

const storyConfig: StoryConfig = {
  label: 'Our Story',
  title: 'From One Acre\nTo An Enduring Name',
  subtitle: 'A quiet chronology of deliberate growth',
  hero: '/img/vineyard-landscape.jpg',
  beats: [
    {
      year: '1989',
      title: 'The First Slope',
      body: 'Thomas Renard planted a single acre on volcanic hillside soils, convinced the site could deliver a wine of architectural depth.',
      image: '/img/vineyard-landscape.jpg'
    },
    {
      year: '1992',
      title: 'First Vintage',
      body: 'Ninety cases were produced. Most were shared privately. The remaining bottles became the benchmark for the estate\'s future direction.',
      image: '/img/wine-red-glass.jpg'
    },
    {
      year: '2005',
      title: 'Measured Expansion',
      body: 'Additional blocks were acquired only where elevation and exposure aligned with the house style of precision and lift.',
      image: '/img/wine-barrels.jpg'
    },
    {
      year: '2015',
      title: 'Second Generation',
      body: 'Isabelle Renard assumed stewardship, preserving the estate ethos while refining farming and hospitality with contemporary rigor.',
      image: '/img/wine-estate.jpg'
    }
  ]
};

const winemakerConfig: WinemakerConfig = {
  label: 'The Winemaker',
  name: 'Elena Marchand',
  subtitle: 'Restraint · Precision · Place',
  hero: '/img/wine-tasting.jpg',
  portrait: '/img/wine-pour.jpg',
  manifesto: 'After formative years in Bordeaux and Burgundy, Elena brought a terroir-first philosophy to Maison: fewer interventions, cleaner lines, longer finish, and wines designed for evolution rather than immediate spectacle.',
  quote: 'The vineyard already knows what the wine should be. My work is to preserve that truth.',
  approach: [
    { title: 'Farming Discipline', detail: 'Biodynamic blocks, cover-crop biodiversity, and strict yield decisions before fruit reaches cellar doors.' },
    { title: 'Cellar Precision', detail: 'Native fermentations, restrained extraction, and elevage choices optimized for structure and aromatic purity.' },
    { title: 'Architectural Balance', detail: 'A signature profile of mineral line, layered tannin, and length that unfolds over years in bottle.' }
  ],
  accolades: [
    '98 Points · Leonidas Cabernet Sauvignon 2020 · Wine Advocate',
    '97 Points · Leonidas Cabernet Sauvignon 2018 · James Suckling',
    '96 Points · Hillside Blend 2019 · Wine Spectator',
    'Winemaker Of The Year · California Wine Institute 2022'
  ]
};

const pageTitle = entry.data.title || 'Maison';
const pageDescription = entry.data.description || 'Estate story';
const slug = entry.slug;
---

<Layout title={pageTitle} description={pageDescription}>
  {slug === 'bio' && (
    <article class="bio-cinema about-page">
      <section class="bio-hero">
        <div class="bio-hero-bg drift" data-drift="0.08" style={`background-image:url('${bioConfig.hero}')`}></div>
        <div class="bio-hero-vignette"></div>
        <div class="bio-hero-inner" data-reveal="up">
          <span class="bio-kicker">{bioConfig.label}</span>
          <h1 set:html={bioConfig.title.replace('\n', '<br />')}></h1>
          <p>{bioConfig.subtitle}</p>
        </div>
      </section>

      <section class="bio-scenes">
        <figure class="bio-scene-a drift" data-drift="0.18" data-reveal="left">
          <img src={bioConfig.sceneA} alt="Maison vineyard" loading="lazy" />
        </figure>
        <figure class="bio-scene-b drift" data-drift="0.12" data-reveal="right">
          <img src={bioConfig.sceneB} alt="Maison cellar" loading="lazy" />
        </figure>
        <div class="bio-lead" data-reveal="up">
          <p>{bioConfig.lead}</p>
        </div>
      </section>

      <section class="bio-art-gallery">
        <figure class="bio-art-main drift" data-drift="0.1" data-reveal="left">
          <img src="/img/clay-images-20.jpg" alt="Maison estate detail" loading="lazy" />
        </figure>
        <figure class="bio-art-side bio-art-side-top" data-reveal="up">
          <img src="/img/clay-images-16.jpg" alt="Maison texture study" loading="lazy" />
        </figure>
        <figure class="bio-art-side bio-art-side-bottom drift" data-drift="0.07" data-reveal="up" data-delay="2">
          <img src="/img/clay-images-10.jpg" alt="Maison cellar atmosphere" loading="lazy" />
        </figure>
      </section>

      <section class="bio-metrics" data-reveal="up">
        {bioConfig.metrics.map((item) => (
          <div class="bio-orb">
            <span>{item.value}</span>
            <small>{item.label}</small>
          </div>
        ))}
      </section>

      <section class="bio-quote" data-reveal="scale">
        <blockquote>{bioConfig.quote}</blockquote>
        <cite>{bioConfig.by}</cite>
      </section>

      <section class="about-body" data-reveal="up">
        <Content />
      </section>
    </article>
  )}

  {slug === 'our-story' && (
    <article class="story-chronicle about-page">
      <section class="story-hero">
        <div class="story-hero-bg drift" data-drift="0.09" style={`background-image:url('${storyConfig.hero}')`}></div>
        <div class="story-hero-overlay"></div>
        <div class="story-hero-inner" data-reveal="up">
          <span>{storyConfig.label}</span>
          <h1 set:html={storyConfig.title.replace('\n', '<br />')}></h1>
          <p>{storyConfig.subtitle}</p>
        </div>
      </section>

      <section class="story-track" aria-label="Maison timeline">
        <div class="story-spine" aria-hidden="true"></div>
        {storyConfig.beats.map((beat, i) => (
          <article class={`story-beat ${i % 2 === 0 ? 'left' : 'right'}`} data-reveal="up">
            <div class="story-year">{beat.year}</div>
            <div class="story-panel">
              <h2>{beat.title}</h2>
              <p>{beat.body}</p>
            </div>
            <figure class="story-image drift" data-drift={String(0.08 + (i % 3) * 0.04)}>
              <img src={beat.image} alt={beat.title} loading="lazy" />
            </figure>
          </article>
        ))}
      </section>

      <section class="about-body story-body" data-reveal="up">
        <Content />
      </section>
    </article>
  )}

  {slug === 'winemaker' && (
    <article class="winemaker-portrait about-page">
      <section class="winemaker-hero">
        <div class="winemaker-hero-bg drift" data-drift="0.07" style={`background-image:url('${winemakerConfig.hero}')`}></div>
        <div class="winemaker-grain"></div>
        <div class="winemaker-hero-inner" data-reveal="up">
          <span>{winemakerConfig.label}</span>
          <h1>{winemakerConfig.name}</h1>
          <p>{winemakerConfig.subtitle}</p>
        </div>
      </section>

      <section class="winemaker-stage">
        <figure class="winemaker-portrait-wrap" data-reveal="left">
          <img class="drift" data-drift="0.15" src={winemakerConfig.portrait} alt={winemakerConfig.name} loading="lazy" />
          <figcaption>{winemakerConfig.quote}</figcaption>
        </figure>
        <div class="winemaker-manifesto" data-reveal="right">
          <p>{winemakerConfig.manifesto}</p>
          <ul>
            {winemakerConfig.approach.map((item) => (
              <li>
                <h2>{item.title}</h2>
                <p>{item.detail}</p>
              </li>
            ))}
          </ul>
        </div>
      </section>

      <section class="winemaker-ticker" aria-label="Elena accolades">
        <div class="ticker-track">
          {[...winemakerConfig.accolades, ...winemakerConfig.accolades].map((line) => (
            <span>{line}</span>
          ))}
        </div>
      </section>

      <section class="about-body winemaker-body" data-reveal="up">
        <Content />
      </section>
    </article>
  )}

  {slug !== 'bio' && slug !== 'our-story' && slug !== 'winemaker' && (
    <article class="about-fallback about-page">
      <section class="about-fallback-hero" data-reveal="up">
        <h1>{pageTitle}</h1>
        <p>{pageDescription}</p>
      </section>
      <section class="about-body" data-reveal="up">
        <Content />
      </section>
    </article>
  )}
</Layout>

<style>
.about-page {
  padding-bottom: min(10vw, 110px);
}

.about-body {
  max-width: 900px;
  margin: min(8vw, 90px) auto 0;
  padding: 0 6vw;
  border-top: 1px solid rgba(202, 160, 95, 0.28);
  padding-top: min(5vw, 56px);
}
.about-body :global(h2) {
  font-family: var(--font-display);
  font-size: clamp(2.6rem, 3vw, 3.8rem);
  font-weight: 300;
  letter-spacing: 2px;
  text-transform: uppercase;
}
.about-body :global(p),
.about-body :global(li) {
  font-size: 1.65rem;
  line-height: 1.82;
  opacity: 0.72;
}
.about-body :global(img) {
  width: 100%;
  margin: 2rem 0;
}

.drift {
  transform: translate3d(0, calc(var(--drift-y, 0) * 1px), 0);
  transition: transform 0.14s linear;
}

.bio-hero {
  min-height: 90vh;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}
.bio-hero-bg {
  position: absolute;
  inset: -6%;
  background-size: cover;
  background-position: center;
}
.bio-hero-vignette {
  position: absolute;
  inset: 0;
  background: radial-gradient(circle at center, rgba(12, 8, 4, 0.14) 0%, rgba(12, 8, 4, 0.82) 100%);
}
.bio-hero-inner {
  position: relative;
  z-index: 2;
  text-align: center;
  max-width: 900px;
  padding: 0 6vw;
}
.bio-kicker {
  font-family: var(--font-sans-serif);
  font-size: 0.9rem;
  letter-spacing: 4px;
  text-transform: uppercase;
  color: #e7c874;
}
.bio-hero h1 {
  margin: 2rem 0;
  color: #f5efe0;
  font-family: var(--font-display);
  font-weight: 300;
  font-size: clamp(4.5rem, 11vw, 10rem);
  line-height: 1.03;
  letter-spacing: 7px;
  text-transform: uppercase;
}
.bio-hero p {
  margin: 0;
  color: rgba(245, 239, 224, 0.76);
  font-style: italic;
  font-size: clamp(1.5rem, 2vw, 2.1rem);
}

.bio-scenes {
  margin: min(8vw, 90px) auto 0;
  max-width: 1320px;
  padding: 0 6vw;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: min(4vw, 42px);
  align-items: end;
}
.bio-scenes figure {
  margin: 0;
  overflow: hidden;
}
.bio-scene-a {
  clip-path: ellipse(78% 64% at 50% 50%);
  aspect-ratio: 4 / 5;
}
.bio-scene-b {
  clip-path: inset(0 round 38px);
  aspect-ratio: 4 / 5;
}
.bio-scenes img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 1.2s cubic-bezier(0.2, 0, 0, 1);
}
.bio-scenes figure:hover img {
  transform: scale(1.08);
}
.bio-lead {
  grid-column: 1 / -1;
  max-width: 940px;
  margin: min(4vw, 40px) auto 0;
  text-align: center;
}
.bio-lead p {
  margin: 0;
  font-size: clamp(2rem, 2.7vw, 3.2rem);
  line-height: 1.68;
  font-style: italic;
  opacity: 0.8;
}

.bio-art-gallery {
  margin: min(7vw, 80px) auto 0;
  max-width: 1320px;
  padding: 0 6vw;
  display: grid;
  grid-template-columns: 1.1fr 0.9fr;
  gap: min(2vw, 24px);
}
.bio-art-gallery figure {
  margin: 0;
  overflow: hidden;
}
.bio-art-main {
  grid-row: 1 / span 2;
  aspect-ratio: 5 / 6;
  clip-path: ellipse(72% 86% at 50% 50%);
}
.bio-art-side {
  aspect-ratio: 4 / 3;
}
.bio-art-side-top {
  clip-path: polygon(0 0, 100% 8%, 92% 100%, 6% 92%);
}
.bio-art-side-bottom {
  clip-path: ellipse(82% 72% at 50% 50%);
}
.bio-art-gallery img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  transition: transform 1.1s cubic-bezier(0.2, 0, 0, 1), filter 1.1s;
}
.bio-art-gallery figure:hover img {
  transform: scale(1.06);
  filter: saturate(1.06) contrast(1.05);
}

.bio-metrics {
  margin: min(7vw, 80px) auto 0;
  max-width: 1180px;
  padding: 0 6vw;
  display: flex;
  justify-content: center;
  gap: min(2.8vw, 30px);
  flex-wrap: wrap;
}
.bio-orb {
  position: relative;
  isolation: isolate;
  width: min(220px, 42vw);
  aspect-ratio: 1;
  border-radius: 50%;
  border: 1px solid rgba(202, 160, 95, 0.36);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: radial-gradient(circle at 35% 28%, rgba(231, 200, 116, 0.14), transparent 68%);
  animation: orbFloat 5.8s ease-in-out infinite;
}
.bio-orb::before,
.bio-orb::after {
  content: '';
  position: absolute;
  inset: -10px;
  border-radius: 50%;
  pointer-events: none;
}
.bio-orb::before {
  border: 1px solid rgba(202, 160, 95, 0.35);
  animation: orbSpin 14s linear infinite;
}
.bio-orb::after {
  inset: -20px;
  border: 1px dashed rgba(202, 160, 95, 0.3);
  animation: orbSpin 22s linear infinite reverse;
}
.bio-orb:nth-child(2) {
  animation-delay: 0.8s;
}
.bio-orb:nth-child(3) {
  animation-delay: 1.6s;
}
.bio-orb span {
  position: relative;
  z-index: 2;
  font-family: var(--font-display);
  font-size: clamp(3rem, 5vw, 5rem);
  line-height: 1;
  color: var(--color-primary);
}
.bio-orb small {
  position: relative;
  z-index: 2;
  margin-top: 0.7rem;
  font-family: var(--font-sans-serif);
  font-size: 0.78rem;
  text-transform: uppercase;
  letter-spacing: 2.6px;
  opacity: 0.56;
}
@keyframes orbFloat {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-10px); }
}
@keyframes orbSpin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

.bio-quote {
  margin: min(7vw, 80px) auto 0;
  max-width: 980px;
  padding: 0 6vw;
  text-align: center;
}
.bio-quote blockquote {
  margin: 0;
  padding: 0;
  border: 0;
  font-family: var(--font-serif);
  font-size: clamp(2rem, 2.7vw, 3rem);
  font-style: italic;
  line-height: 1.72;
  opacity: 0.82;
}
.bio-quote cite {
  display: inline-block;
  margin-top: 1.6rem;
  font-family: var(--font-sans-serif);
  font-size: 0.85rem;
  letter-spacing: 2.7px;
  text-transform: uppercase;
  color: var(--color-primary);
}

.story-hero {
  min-height: 88vh;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}
.story-hero-bg {
  position: absolute;
  inset: -5%;
  background-size: cover;
  background-position: center;
}
.story-hero-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(145deg, rgba(7, 5, 3, 0.52), rgba(7, 5, 3, 0.86));
}
.story-hero-inner {
  position: relative;
  z-index: 2;
  text-align: center;
  max-width: 940px;
  padding: 0 6vw;
}
.story-hero-inner span {
  font-family: var(--font-sans-serif);
  font-size: 0.9rem;
  letter-spacing: 4px;
  text-transform: uppercase;
  color: #e7c874;
}
.story-hero-inner h1 {
  margin: 1.8rem 0;
  font-family: var(--font-display);
  color: #f4eddb;
  font-weight: 300;
  text-transform: uppercase;
  font-size: clamp(4.2rem, 10vw, 9.6rem);
  line-height: 1.06;
  letter-spacing: 6px;
}
.story-hero-inner p {
  margin: 0;
  font-style: italic;
  color: rgba(244, 237, 219, 0.72);
  font-size: clamp(1.5rem, 1.9vw, 2rem);
}

.story-track {
  position: relative;
  margin: min(8vw, 90px) auto 0;
  max-width: 1320px;
  padding: 0 6vw;
}
.story-spine {
  position: absolute;
  top: 0;
  bottom: 0;
  left: 50%;
  width: 1px;
  transform: translateX(-50%);
  background: linear-gradient(to bottom, transparent, rgba(202, 160, 95, 0.55), transparent);
}
.story-beat {
  display: grid;
  grid-template-columns: 1fr 110px 1fr;
  gap: 2rem;
  align-items: center;
  margin-bottom: min(8vw, 90px);
}
.story-beat.right .story-panel {
  grid-column: 3;
}
.story-beat.right .story-year {
  grid-column: 2;
}
.story-beat.right .story-image {
  grid-column: 1;
}
.story-beat.left .story-panel {
  grid-column: 1;
  text-align: right;
}
.story-beat.left .story-year {
  grid-column: 2;
}
.story-beat.left .story-image {
  grid-column: 3;
}
.story-year {
  justify-self: center;
  width: 96px;
  height: 96px;
  border-radius: 50%;
  border: 1px solid rgba(202, 160, 95, 0.42);
  background: var(--color-bg);
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: var(--font-display);
  font-size: 1.6rem;
  letter-spacing: 2px;
  color: var(--color-primary);
}
.story-panel h2 {
  margin: 0 0 1rem;
  font-family: var(--font-display);
  font-weight: 300;
  font-size: clamp(2.3rem, 2.9vw, 3.6rem);
  text-transform: uppercase;
  letter-spacing: 1.8px;
}
.story-panel p {
  margin: 0;
  font-size: 1.55rem;
  line-height: 1.8;
  opacity: 0.72;
}
.story-image {
  margin: 0;
  aspect-ratio: 4 / 5;
  overflow: hidden;
  clip-path: polygon(10% 0, 100% 8%, 90% 100%, 0 92%);
}
.story-image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 1.1s cubic-bezier(0.2, 0, 0, 1);
}
.story-image:hover img {
  transform: scale(1.07);
}

.story-body {
  margin-top: min(5vw, 56px);
}

.winemaker-hero {
  min-height: 88vh;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}
.winemaker-hero-bg {
  position: absolute;
  inset: -5%;
  background-size: cover;
  background-position: center;
  filter: saturate(0.88) contrast(1.02);
}
.winemaker-grain {
  position: absolute;
  inset: 0;
  background-image: radial-gradient(rgba(255, 255, 255, 0.08) 0.5px, transparent 0.5px);
  background-size: 3px 3px;
  mix-blend-mode: soft-light;
  opacity: 0.14;
  animation: grainMove 10s linear infinite;
}
@keyframes grainMove {
  from { transform: translate(0, 0); }
  to { transform: translate(-30px, -20px); }
}
.winemaker-hero::after {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(to bottom, rgba(8, 6, 4, 0.3), rgba(8, 6, 4, 0.82));
}
.winemaker-hero-inner {
  position: relative;
  z-index: 2;
  text-align: center;
  max-width: 940px;
  padding: 0 6vw;
}
.winemaker-hero-inner span {
  font-family: var(--font-sans-serif);
  font-size: 0.9rem;
  letter-spacing: 4px;
  text-transform: uppercase;
  color: #e7c874;
}
.winemaker-hero-inner h1 {
  margin: 1.8rem 0;
  color: #f5efde;
  font-family: var(--font-display);
  font-weight: 300;
  font-size: clamp(4.2rem, 10vw, 9rem);
  letter-spacing: 6px;
  text-transform: uppercase;
}
.winemaker-hero-inner p {
  margin: 0;
  font-size: clamp(1.4rem, 1.9vw, 2rem);
  font-style: italic;
  color: rgba(245, 239, 222, 0.74);
}

.winemaker-stage {
  margin: min(8vw, 90px) auto 0;
  max-width: 1320px;
  padding: 0 6vw;
  display: grid;
  grid-template-columns: 0.9fr 1.1fr;
  gap: min(6vw, 68px);
  align-items: center;
}
.winemaker-portrait-wrap {
  margin: 0;
  position: relative;
}
.winemaker-portrait-wrap img {
  width: 100%;
  aspect-ratio: 4 / 5;
  object-fit: cover;
  display: block;
  clip-path: ellipse(70% 84% at 50% 50%);
}
.winemaker-portrait-wrap figcaption {
  margin-top: 1.4rem;
  font-size: 1.55rem;
  line-height: 1.76;
  font-style: italic;
  opacity: 0.74;
}
.winemaker-manifesto > p {
  margin: 0 0 2rem;
  font-size: clamp(2rem, 2.5vw, 3rem);
  line-height: 1.66;
