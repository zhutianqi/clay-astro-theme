---
import Layout from '../layouts/Layout.astro';
import { type CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'pages'>;
}

interface PageConfig {
  eyebrow: string;
  title: string;
  subtitle: string;
  hero: string;
  lead: string;
  featureTitle: string;
  featureBody: string;
  featureImage: string;
  gallery: string[];
}

const { entry } = Astro.props;
const { Content } = await entry.render();

const pageConfigs: Record<string, PageConfig> = {
  bio: {
    eyebrow: 'About The Estate',
    title: 'A Legacy\nPoured Slowly',
    subtitle: 'Napa Valley · Since 1989',
    hero: '/img/wine-estate.jpg',
    lead: 'Maison was built around a single discipline: craftsmanship without haste. Every decision in vineyard and cellar is measured against elegance, longevity, and fidelity to place.',
    featureTitle: 'Three Decades Of Precision',
    featureBody: 'From selective farming passes to low-intervention cellar work, the estate has preserved a house style defined by aromatic lift, structural depth, and quiet power.',
    featureImage: '/img/wine-cellar-bottles.jpg',
    gallery: ['/img/vineyard-landscape.jpg', '/img/clay-images-20.jpg', '/img/clay-images-16.jpg']
  },
  'our-story': {
    eyebrow: 'Our Story',
    title: 'From One Acre\nTo An Icon',
    subtitle: 'A chronology of deliberate growth',
    hero: '/img/vineyard-landscape.jpg',
    lead: 'What began as a single hillside planting evolved into a reference estate because expansion followed quality, never volume.',
    featureTitle: 'Growth By Selection, Not Scale',
    featureBody: 'Maison added blocks only when exposure, soil profile, and farming resources could support the estate signature. Every acquisition had to improve the blend architecture.',
    featureImage: '/img/wine-barrels.jpg',
    gallery: ['/img/wine-red-glass.jpg', '/img/wine-estate.jpg', '/img/clay-images-10.jpg']
  },
  vineyards: {
    eyebrow: 'Vineyards',
    title: 'Five Blocks\nOne Signature',
    subtitle: '42 acres of terroir, farmed parcel by parcel',
    hero: '/img/vineyard-landscape.jpg',
    lead: 'Each block is managed as its own ecosystem. Soil, altitude, and aspect are preserved in the final wines through separate farming and lot-by-lot vinification.',
    featureTitle: 'Topography Shapes Character',
    featureBody: 'The estate moves from volcanic hillside parcels to cooler marine-influenced rows, creating a broad palette for layered blends and site-pure bottlings.',
    featureImage: '/img/wine-bottle-label.jpg',
    gallery: ['/img/wine-pour.jpg', '/img/wine-cellar-bottles.jpg', '/img/clay-images-17.jpg']
  },
  philosophy: {
    eyebrow: 'Philosophy',
    title: 'Elegance Is\nAn Edit',
    subtitle: 'Less intervention, more truth',
    hero: '/img/wine-red-glass.jpg',
    lead: 'The finest vintages are usually the quietest in cellar. The vineyard leads; the winemaking follows with restraint.',
    featureTitle: 'Restraint Is A Technical Choice',
    featureBody: 'Biodynamic farming, lower extraction, and patient elevage are not marketing language. They are repeatable methods for precision, balance, and ageability.',
    featureImage: '/img/wine-pour.jpg',
    gallery: ['/img/wine-estate.jpg', '/img/clay-images-12.jpg', '/img/clay-images-15.jpg']
  },
  faq: {
    eyebrow: 'FAQ',
    title: 'Questions\nClearly Answered',
    subtitle: 'For allocation members, collectors, and guests',
    hero: '/img/wine-cellar-bottles.jpg',
    lead: 'Practical details about purchasing, visits, shipping, and service standards at Maison.',
    featureTitle: 'Service With Precision',
    featureBody: 'Allocation logistics, tasting appointments, and fulfillment are handled with the same rigor as vineyard and cellar operations.',
    featureImage: '/img/wine-tasting.jpg',
    gallery: ['/img/wine-bottle-label.jpg', '/img/clay-images-11.jpg', '/img/wine-estate.jpg']
  }
};

const faqItems = [
  {
    q: 'How do I purchase the wines?',
    a: 'Most wines are released through allocation first. Join the list via the contact page. A limited amount reaches selected restaurants and retail partners.'
  },
  {
    q: 'What is the allocation list?',
    a: 'Members receive priority access to new releases each spring and autumn. There is no minimum purchase requirement and membership is complimentary.'
  },
  {
    q: 'Can I visit the estate?',
    a: 'Yes. Private tastings are by appointment, typically Thursday through Sunday.'
  },
  {
    q: 'Do you ship internationally?',
    a: 'We ship where regulations permit. International delivery is coordinated via distribution partners when available.'
  },
  {
    q: 'Are the wines vegan?',
    a: 'Yes. We do not use animal-product fining agents, and vintages from 2018 onward are certified vegan.'
  }
];

const config = pageConfigs[entry.slug];
---

<Layout title={entry.data.title} description={entry.data.description}>
  {config && (
    <article class="house-page">
      <section class="house-hero">
        <div class="house-hero-bg drift" data-drift="0.08" style={`background-image:url('${config.hero}')`}></div>
        <div class="house-hero-overlay"></div>
        <div class="house-hero-inner" data-reveal="up">
          <span class="house-eyebrow">{config.eyebrow}</span>
          <h1 set:html={config.title.replace('\n', '<br />')}></h1>
          <div class="house-rule"></div>
          <p>{config.subtitle}</p>
        </div>
      </section>

      <section class="house-statement" data-reveal="up">
        <p>{config.lead}</p>
      </section>

      <section class="house-feature">
        <div class="house-feature-image" data-reveal="left">
          <img src={config.featureImage} alt={config.featureTitle} loading="lazy" />
        </div>
        <div class="house-feature-content" data-reveal="right">
          <span class="house-eyebrow">Editorial</span>
          <h2>{config.featureTitle}</h2>
          <div class="house-rule"></div>
          <p>{config.featureBody}</p>
        </div>
      </section>

      {entry.slug === 'faq' ? (
        <section class="house-faq" data-reveal="up">
          {faqItems.map((item, i) => (
            <details class="house-faq-item" data-delay={String((i % 3) + 1)}>
              <summary>
                <span>{item.q}</span>
                <span class="house-faq-plus" aria-hidden="true">+</span>
              </summary>
              <p>{item.a}</p>
            </details>
          ))}
        </section>
      ) : (
        <section class="house-gallery">
          {config.gallery.map((image, i) => (
            <figure class="house-gallery-item" data-reveal="up" data-delay={String((i % 3) + 1)}>
              <img src={image} alt={entry.data.title || 'Maison'} loading="lazy" />
            </figure>
          ))}
        </section>
      )}

      <section class="house-body" data-reveal="up">
        <Content />
      </section>
    </article>
  )}
</Layout>

<style>
.house-page {
  padding-bottom: min(10vw, 110px);
}

.house-eyebrow {
  font-family: var(--font-sans-serif);
  font-size: 0.94rem;
  letter-spacing: 4px;
  text-transform: uppercase;
  color: var(--color-primary);
}

.house-rule {
  width: 50px;
  height: 1px;
  background: var(--color-primary);
  opacity: 0.75;
}

.house-hero {
  position: relative;
  min-height: 92vh;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.house-hero-bg {
  position: absolute;
  inset: -8%;
  background-size: cover;
  background-position: center;
}

.house-hero-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(to bottom, rgba(8, 6, 4, 0.32), rgba(8, 6, 4, 0.78));
}

.house-hero-inner {
  position: relative;
  z-index: 2;
  text-align: center;
  max-width: 980px;
  padding: 0 6vw;
}

.house-hero-inner h1 {
  margin: 1.8rem 0;
  font-family: var(--font-display);
  font-size: clamp(4.4rem, 10vw, 10rem);
  font-weight: 300;
  line-height: 1.03;
  letter-spacing: 8px;
  text-transform: uppercase;
  color: #f4eddd;
}

.house-hero-inner .house-rule {
  margin: 0 auto 1.8rem;
}

.house-hero-inner p {
  margin: 0;
  font-family: var(--font-serif);
  font-size: clamp(1.5rem, 2vw, 2rem);
  font-style: italic;
  color: rgba(244, 237, 221, 0.74);
}

.house-statement {
  max-width: 980px;
  margin: min(8vw, 92px) auto 0;
  padding: 0 6vw;
  text-align: center;
}

.house-statement p {
  margin: 0;
  font-family: var(--font-serif);
  font-size: clamp(2rem, 2.7vw, 3rem);
  font-style: italic;
  line-height: 1.72;
  color: var(--color-base);
  opacity: 0.82;
}

.house-feature {
  margin: min(8vw, 90px) auto 0;
  max-width: 1320px;
  padding: 0 6vw;
  display: grid;
  grid-template-columns: 54% 1fr;
  gap: min(5vw, 64px);
  align-items: center;
}

.house-feature-image {
  overflow: hidden;
  aspect-ratio: 5 / 4;
}

.house-feature-image img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  transition: transform 0.9s cubic-bezier(0.2, 0, 0, 1);
}

.house-feature-image:hover img {
  transform: scale(1.04);
}

.house-feature-content h2 {
  margin: 1.2rem 0 1.8rem;
  font-family: var(--font-display);
  font-size: clamp(2.8rem, 4vw, 5rem);
  font-weight: 300;
  text-transform: uppercase;
  letter-spacing: 3px;
  line-height: 1.1;
}

.house-feature-content .house-rule {
  margin-bottom: 2rem;
}

.house-feature-content p {
  margin: 0;
  font-family: var(--font-serif);
  font-size: clamp(1.6rem, 1.9vw, 1.95rem);
  line-height: 1.8;
  opacity: 0.7;
}

.house-gallery {
  margin: min(7vw, 80px) auto 0;
  max-width: 1320px;
  padding: 0 6vw;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: min(2.2vw, 24px);
}

.house-gallery-item {
  margin: 0;
  aspect-ratio: 4 / 5;
  overflow: hidden;
}

.house-gallery-item img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  transition: transform 0.85s cubic-bezier(0.2, 0, 0, 1);
}

.house-gallery-item:hover img {
  transform: scale(1.05);
}

.house-faq {
  margin: min(7vw, 80px) auto 0;
  max-width: 980px;
  padding: 0 6vw;
  display: grid;
  gap: 1rem;
}

.house-faq-item {
  border-top: 1px solid var(--color-border);
  border-bottom: 1px solid var(--color-border);
  padding: 0.9rem 0;
}

.house-faq-item summary {
  list-style: none;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 1rem;
  cursor: pointer;
}

.house-faq-item summary::-webkit-details-marker {
  display: none;
}

.house-faq-item summary span:first-child {
  font-family: var(--font-display);
  font-size: clamp(2rem, 2.6vw, 3rem);
  font-weight: 300;
  letter-spacing: 1.2px;
}

.house-faq-plus {
  font-family: var(--font-sans-serif);
  font-size: 1.8rem;
  color: var(--color-primary);
  transition: transform 0.25s ease;
}

.house-faq-item[open] .house-faq-plus {
  transform: rotate(45deg);
}

.house-faq-item p {
  margin: 0.8rem 0 0;
  font-family: var(--font-serif);
  font-size: 1.5rem;
  line-height: 1.75;
  opacity: 0.72;
}

.house-body {
  max-width: 980px;
  margin: min(8vw, 90px) auto 0;
  padding: min(5vw, 56px) 6vw 0;
  border-top: 1px solid var(--color-border);
}

.house-body :global(h2) {
  font-family: var(--font-display);
  font-size: clamp(2.6rem, 3vw, 3.8rem);
  font-weight: 300;
  text-transform: uppercase;
  letter-spacing: 2px;
}

.house-body :global(p),
.house-body :global(li) {
  font-size: 1.6rem;
  line-height: 1.82;
  opacity: 0.74;
}

.drift {
  transform: translate3d(0, calc(var(--drift-y, 0) * 1px), 0);
}

@media (max-width: 980px) {
  .house-feature {
    grid-template-columns: 1fr;
  }
  .house-gallery {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 640px) {
  .house-hero-inner h1 {
    letter-spacing: 4px;
  }
}
</style>

<script>
(function() {
  function initHouseParallax() {
    const drifters = Array.from(document.querySelectorAll<HTMLElement>('.house-page [data-drift]'));
    if (!drifters.length) return;

    const onScroll = () => {
      const y = window.scrollY;
      drifters.forEach((el) => {
        const ratio = Number(el.dataset.drift || '0');
        el.style.setProperty('--drift-y', String(-y * ratio * 0.12));
      });
    };

    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
    document.addEventListener('astro:before-swap', () => window.removeEventListener('scroll', onScroll), { once: true });
  }

  document.addEventListener('astro:page-load', initHouseParallax);
  initHouseParallax();
})();
</script>
