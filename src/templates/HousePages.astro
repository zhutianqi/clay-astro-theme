---
import Layout from '../layouts/Layout.astro';
import { type CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'pages'>;
}

interface HouseConfig {
  eyebrow: string;
  title: string;
  subtitle: string;
  hero: string;
  lead: string;
  art: string[];
}

const { entry } = Astro.props;
const { Content } = await entry.render();

const house: Record<string, HouseConfig> = {
  bio: {
    eyebrow: 'About The Estate',
    title: 'A Legacy\nPoured Slowly',
    subtitle: 'Napa Valley · Since 1989',
    hero: '/img/wine-estate.jpg',
    lead: 'Maison was built around one discipline: craftsmanship without haste. Every decision in vineyard and cellar is measured against elegance, longevity, and fidelity to place.',
    art: ['/img/clay-images-20.jpg', '/img/wine-cellar-bottles.jpg', '/img/clay-images-16.jpg', '/img/wine-pour.jpg']
  },
  'our-story': {
    eyebrow: 'Our Story',
    title: 'From One Acre\nTo An Icon',
    subtitle: 'A chronology of deliberate growth',
    hero: '/img/vineyard-landscape.jpg',
    lead: 'What began as a single hillside planting became a reference estate because expansion followed quality, never volume.',
    art: ['/img/wine-red-glass.jpg', '/img/wine-barrels.jpg', '/img/wine-estate.jpg', '/img/clay-images-10.jpg']
  },
  vineyards: {
    eyebrow: 'Vineyards',
    title: 'Five Blocks\nOne Signature',
    subtitle: '42 acres, farmed parcel by parcel',
    hero: '/img/vineyard-landscape.jpg',
    lead: 'Each block is managed as its own ecosystem. Soil, altitude, and exposure are preserved in the final wines through lot-level farming and vinification.',
    art: ['/img/wine-bottle-label.jpg', '/img/vineyard-landscape.jpg', '/img/wine-pour.jpg', '/img/clay-images-17.jpg']
  },
  philosophy: {
    eyebrow: 'Philosophy',
    title: 'Elegance Is\nAn Edit',
    subtitle: 'Less intervention, more truth',
    hero: '/img/wine-red-glass.jpg',
    lead: 'The most profound vintages are often the quietest in cellar. The vineyard leads, and winemaking follows with restraint.',
    art: ['/img/wine-pour.jpg', '/img/wine-estate.jpg', '/img/clay-images-12.jpg', '/img/clay-images-15.jpg']
  },
  faq: {
    eyebrow: 'FAQ',
    title: 'Questions\nClearly Answered',
    subtitle: 'For allocation members, collectors, and guests',
    hero: '/img/wine-cellar-bottles.jpg',
    lead: 'Practical details around purchasing, shipping, and estate visits, delivered with the same precision as our farming and cellar work.',
    art: ['/img/wine-tasting.jpg', '/img/wine-bottle-label.jpg', '/img/clay-images-11.jpg', '/img/wine-estate.jpg']
  }
};

const config = house[entry.slug];

const vineyardBlocks = [
  ['The Lion Block', '18 acres · Volcanic basalt · East-facing'],
  ['The Ridge Block', '8 acres · Rocky loam · South-facing'],
  ['The Fog Block', '6 acres · Goldridge sandy loam · Marine influence'],
  ['The Stone Terrace', '5 acres · Alluvial gravel · Valley floor'],
  ['The Palisades', '3 acres · Volcanic face · Extreme slope']
];

const philosophyLines = [
  'The finest wines are not made louder in cellar; they are preserved in clarity.',
  'Biodynamic farming is a technical commitment to soil vitality and vine balance.',
  'Scores are outcomes, not objectives. Pleasure and longevity are the objective.',
  'Rarity exists to protect quality, never to manufacture scarcity.'
];

const faqItems = [
  ['How do I purchase the wines?', 'Most wines are released through allocation first. A limited amount reaches selected partners.'],
  ['What is the allocation list?', 'Members receive priority access to spring and autumn releases with no minimum purchase requirement.'],
  ['Can I visit the estate?', 'Yes. Private tastings are by appointment, typically Thursday through Sunday.'],
  ['Do you ship internationally?', 'We ship where regulations permit. International fulfillment is coordinated through distribution partners.'],
  ['Are the wines vegan?', 'Yes. We do not use animal-product fining agents, and vintages since 2018 are certified vegan.']
];
---

<Layout title={entry.data.title} description={entry.data.description}>
  {config && (
    <article class={`house-page house-${entry.slug}`}>
      <section class="house-hero">
        <div class="house-hero-bg drift" data-drift="0.08" style={`background-image:url('${config.hero}')`}></div>
        <div class="house-hero-overlay"></div>
        <div class="house-hero-inner" data-reveal="up">
          <span class="house-eyebrow">{config.eyebrow}</span>
          <h1 set:html={config.title.replace('\n', '<br />')}></h1>
          <div class="house-rule"></div>
          <p>{config.subtitle}</p>
        </div>
      </section>

      <section class="house-lead" data-reveal="up">
        <p>{config.lead}</p>
      </section>

      {entry.slug === 'bio' && (
        <section class="bio-stage">
          <figure class="bio-main" data-reveal="left">
            <img src={config.art[0]} alt="Estate signature" loading="lazy" />
          </figure>
          <figure class="bio-detail drift" data-drift="0.11" data-reveal="right">
            <img src={config.art[1]} alt="Cellar detail" loading="lazy" />
          </figure>
          <figure class="bio-detail drift" data-drift="0.06" data-reveal="up" data-delay="2">
            <img src={config.art[2]} alt="Texture detail" loading="lazy" />
          </figure>
          <figure class="bio-line" data-reveal="up" data-delay="3">
            <img src={config.art[3]} alt="Pour detail" loading="lazy" />
          </figure>
        </section>
      )}

      {entry.slug === 'our-story' && (
        <section class="story-stage">
          <article class="story-row" data-reveal="left">
            <figure><img src={config.art[0]} alt="Founding era" loading="lazy" /></figure>
            <div>
              <h2>1989 · Foundation</h2>
              <p>A single hillside acre established the estate DNA: structure, lift, and aging architecture.</p>
            </div>
          </article>
          <article class="story-row reverse" data-reveal="right">
            <figure><img src={config.art[1]} alt="Growth era" loading="lazy" /></figure>
            <div>
              <h2>2005 · Expansion</h2>
              <p>Additional parcels were selected only when slope, soil, and farming resources met the house standard.</p>
            </div>
          </article>
          <article class="story-row" data-reveal="left">
            <figure><img src={config.art[2]} alt="Current era" loading="lazy" /></figure>
            <div>
              <h2>Today · Continuity</h2>
              <p>Second-generation stewardship preserves the same philosophy while refining execution every vintage.</p>
            </div>
          </article>
        </section>
      )}

      {entry.slug === 'vineyards' && (
        <section class="vine-stage">
          <div class="vine-mast" data-reveal="left">
            <img src={config.art[0]} alt="Vineyard map tone" loading="lazy" />
          </div>
          <div class="vine-list">
            {vineyardBlocks.map((row, i) => (
              <article class="vine-item" data-reveal={i % 2 === 0 ? 'right' : 'left'}>
                <h2>{row[0]}</h2>
                <p>{row[1]}</p>
              </article>
            ))}
          </div>
        </section>
      )}

      {entry.slug === 'philosophy' && (
        <section class="phi-stage">
          <figure class="phi-image drift" data-drift="0.1" data-reveal="left">
            <img src={config.art[0]} alt="Philosophy visual" loading="lazy" />
          </figure>
          <div class="phi-lines">
            {philosophyLines.map((line, i) => (
              <p data-reveal={i % 2 === 0 ? 'right' : 'left'}>{line}</p>
            ))}
          </div>
        </section>
      )}

      {entry.slug === 'faq' && (
        <section class="faq-stage">
          <div class="faq-aside" data-reveal="left">
            <img src={config.art[0]} alt="Hospitality" loading="lazy" />
          </div>
          <div class="faq-list" data-reveal="right">
            {faqItems.map((item) => (
              <details class="faq-item">
                <summary>
                  <span>{item[0]}</span>
                  <span class="faq-plus" aria-hidden="true">+</span>
                </summary>
                <p>{item[1]}</p>
              </details>
            ))}
          </div>
        </section>
      )}

      <section class="house-body" data-reveal="up">
        <Content />
      </section>
    </article>
  )}
</Layout>

<style>
.house-page { padding-bottom: min(10vw, 110px); }
.house-eyebrow {
  font-family: var(--font-sans-serif);
  font-size: 0.94rem;
  letter-spacing: 4px;
  text-transform: uppercase;
  color: var(--color-primary);
}
.house-rule { width: 50px; height: 1px; background: var(--color-primary); opacity: 0.75; }

.house-hero {
  position: relative;
  min-height: 92vh;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}
.house-hero-bg {
  position: absolute;
  inset: -8%;
  background-size: cover;
  background-position: center;
}
.house-hero-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(to bottom, rgba(8, 6, 4, 0.3), rgba(8, 6, 4, 0.78));
}
.house-hero-inner {
  position: relative;
  z-index: 2;
  text-align: center;
  max-width: 980px;
  padding: 0 6vw;
}
.house-hero-inner h1 {
  margin: 1.8rem 0;
  font-family: var(--font-display);
  font-size: clamp(4.4rem, 10vw, 10rem);
  font-weight: 300;
  line-height: 1.03;
  letter-spacing: 8px;
  text-transform: uppercase;
  color: #f4eddd;
}
.house-hero-inner .house-rule { margin: 0 auto 1.8rem; }
.house-hero-inner p {
  margin: 0;
  font-family: var(--font-serif);
  font-size: clamp(1.5rem, 2vw, 2rem);
  font-style: italic;
  color: rgba(244, 237, 221, 0.74);
}

.house-lead {
  max-width: 980px;
  margin: min(8vw, 92px) auto 0;
  padding: 0 6vw;
  text-align: center;
}
.house-lead p {
  margin: 0;
  font-family: var(--font-serif);
  font-size: clamp(2rem, 2.7vw, 3rem);
  font-style: italic;
  line-height: 1.72;
  opacity: 0.82;
}

.bio-stage,
.story-stage,
.vine-stage,
.phi-stage,
.faq-stage {
  margin: min(8vw, 90px) auto 0;
  max-width: 1320px;
  padding: 0 6vw;
}

.bio-stage {
  display: grid;
  grid-template-columns: 1.2fr 1fr;
  gap: min(2vw, 24px);
}
.bio-stage figure { margin: 0; overflow: hidden; }
.bio-main { grid-row: 1 / span 2; aspect-ratio: 5 / 6; }
.bio-detail { aspect-ratio: 4 / 3; }
.bio-line { grid-column: 1 / -1; aspect-ratio: 16 / 6; }
.bio-stage img,
.story-stage img,
.vine-stage img,
.phi-stage img,
.faq-stage img {
  width: 100%; height: 100%; object-fit: cover; display: block;
  transition: transform 0.85s cubic-bezier(0.2, 0, 0, 1);
}
.bio-stage figure:hover img,
.story-stage figure:hover img,
.vine-stage figure:hover img,
.phi-stage figure:hover img,
.faq-stage figure:hover img { transform: scale(1.04); }

.story-stage { display: grid; gap: min(2vw, 24px); }
.story-row {
  display: grid;
  grid-template-columns: 42% 1fr;
  gap: min(3vw, 36px);
  align-items: center;
}
.story-row.reverse { grid-template-columns: 1fr 42%; }
.story-row.reverse figure { order: 2; }
.story-row h2 {
  margin: 0 0 1rem;
  font-family: var(--font-display);
  font-size: clamp(2.3rem, 3vw, 3.8rem);
  font-weight: 300;
  letter-spacing: 1.8px;
  text-transform: uppercase;
}
.story-row p { margin: 0; font-size: 1.55rem; line-height: 1.78; opacity: 0.72; }
.story-row figure { margin: 0; aspect-ratio: 5 / 4; overflow: hidden; }

.vine-stage {
  display: grid;
  grid-template-columns: 38% 1fr;
  gap: min(4vw, 52px);
  align-items: start;
}
.vine-mast { position: sticky; top: 110px; }
.vine-mast img { aspect-ratio: 4 / 5; }
.vine-list { display: grid; gap: 1rem; }
.vine-item { border-top: 1px solid var(--color-border); padding: 1.1rem 0 1rem; }
.vine-item h2 {
  margin: 0 0 0.5rem;
  font-family: var(--font-display);
  font-size: clamp(2.1rem, 2.6vw, 3.3rem);
  font-weight: 300;
  text-transform: uppercase;
  letter-spacing: 1.2px;
}
.vine-item p { margin: 0; font-size: 1.35rem; letter-spacing: 1.1px; text-transform: uppercase; opacity: 0.66; }

.phi-stage {
  display: grid;
  grid-template-columns: 44% 1fr;
  gap: min(4vw, 52px);
  align-items: center;
}
.phi-image { margin: 0; aspect-ratio: 4 / 5; overflow: hidden; }
.phi-lines { display: grid; gap: 1rem; }
.phi-lines p {
  margin: 0;
  padding-left: 1rem;
  border-left: 1px solid var(--color-border);
  font-size: clamp(1.8rem, 2.2vw, 2.5rem);
  line-height: 1.7;
  font-style: italic;
  opacity: 0.8;
}

.faq-stage {
  display: grid;
  grid-template-columns: 42% 1fr;
  gap: min(4vw, 52px);
  align-items: start;
}
.faq-aside { margin: 0; }
.faq-aside img { aspect-ratio: 4 / 5; }
.faq-list { display: grid; gap: 0.8rem; }
.faq-item { border-top: 1px solid var(--color-border); border-bottom: 1px solid var(--color-border); padding: 0.8rem 0; }
.faq-item summary {
  list-style: none;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 1rem;
  cursor: pointer;
}
.faq-item summary::-webkit-details-marker { display: none; }
.faq-item summary span:first-child {
  font-family: var(--font-display);
  font-size: clamp(1.9rem, 2.4vw, 2.9rem);
  font-weight: 300;
}
.faq-plus { font-family: var(--font-sans-serif); color: var(--color-primary); font-size: 1.8rem; transition: transform 0.25s ease; }
.faq-item[open] .faq-plus { transform: rotate(45deg); }
.faq-item p { margin: 0.7rem 0 0; font-size: 1.45rem; line-height: 1.75; opacity: 0.72; }

.house-body {
  max-width: 980px;
  margin: min(8vw, 90px) auto 0;
  padding: min(5vw, 56px) 6vw 0;
  border-top: 1px solid var(--color-border);
}
.house-body :global(h2) {
  font-family: var(--font-display);
  font-size: clamp(2.6rem, 3vw, 3.8rem);
  font-weight: 300;
  text-transform: uppercase;
  letter-spacing: 2px;
}
.house-body :global(p),
.house-body :global(li) {
  font-size: 1.6rem;
  line-height: 1.82;
  opacity: 0.74;
}

.drift { transform: translate3d(0, calc(var(--drift-y, 0) * 1px), 0); }

@media (max-width: 980px) {
  .bio-stage,
  .story-row,
  .story-row.reverse,
  .vine-stage,
  .phi-stage,
  .faq-stage { grid-template-columns: 1fr; }
  .story-row.reverse figure { order: 0; }
  .vine-mast { position: relative; top: auto; }
}

@media (max-width: 640px) {
  .house-hero-inner h1 { letter-spacing: 4px; }
}
</style>

<script>
(function() {
  function initHouseParallax() {
    const drifters = Array.from(document.querySelectorAll<HTMLElement>('.house-page [data-drift]'));
    if (!drifters.length) return;

    const onScroll = () => {
      const y = window.scrollY;
      drifters.forEach((el) => {
        const ratio = Number(el.dataset.drift || '0');
        el.style.setProperty('--drift-y', String(-y * ratio * 0.12));
      });
    };

    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
    document.addEventListener('astro:before-swap', () => window.removeEventListener('scroll', onScroll), { once: true });
  }

  document.addEventListener('astro:page-load', initHouseParallax);
  initHouseParallax();
})();
</script>
