---
import Layout from '../layouts/Layout.astro';
import { type CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'pages'>;
}

interface HouseConfig {
  eyebrow: string;
  title: string;
  subtitle: string;
  hero: string;
  lead: string;
  art: string[];
}

const { entry } = Astro.props;
const { Content } = await entry.render();

const house: Record<string, HouseConfig> = {
  bio: {
    eyebrow: 'Bio · Editorial Film',
    title: 'A Legacy\nPoured Slowly',
    subtitle: 'Napa Valley · Since 1989',
    hero: '/img/stock/bio-hero.jpg',
    lead: 'Maison was built around one discipline: craftsmanship without haste. Every decision in vineyard and cellar is measured against elegance, longevity, and fidelity to place.',
    art: ['/img/stock/bio-a.jpg', '/img/stock/bio-b.jpg', '/img/stock/bio-c.jpg', '/img/stock/estate-hero.jpg']
  },
  'our-story': {
    eyebrow: 'Our Story · Timeline Museum',
    title: 'From One Acre\nTo An Icon',
    subtitle: 'A chronology of deliberate growth',
    hero: '/img/stock/story-hero.jpg',
    lead: 'What began as a single hillside planting became a reference estate because expansion followed quality, never volume.',
    art: ['/img/stock/story-a.jpg', '/img/stock/story-b.jpg', '/img/stock/story-c.jpg', '/img/stock/estate-hero.jpg']
  },
  vineyards: {
    eyebrow: 'Vineyards · Cartographic',
    title: 'Five Blocks\nOne Signature',
    subtitle: '42 acres, farmed parcel by parcel',
    hero: '/img/stock/vine-hero.jpg',
    lead: 'Each block is managed as its own ecosystem. Soil, altitude, and exposure are preserved in the final wines through lot-level farming and vinification.',
    art: ['/img/stock/vine-a.jpg', '/img/stock/vine-b.jpg', '/img/stock/vine-hero.jpg', '/img/stock/estate-hero.jpg']
  },
  philosophy: {
    eyebrow: 'Philosophy · Manifesto',
    title: 'Elegance Is\nAn Edit',
    subtitle: 'Less intervention, more truth',
    hero: '/img/stock/phi-hero.jpg',
    lead: 'The most profound vintages are often the quietest in cellar. The vineyard leads, and winemaking follows with restraint.',
    art: ['/img/stock/phi-a.jpg', '/img/stock/phi-b.jpg', '/img/stock/phi-hero.jpg', '/img/stock/estate-hero.jpg']
  },
  faq: {
    eyebrow: 'FAQ · Concierge',
    title: 'Questions\nClearly Answered',
    subtitle: 'For allocation members, collectors, and guests',
    hero: '/img/stock/faq-hero.jpg',
    lead: 'Practical details around purchasing, shipping, and estate visits, delivered with the same precision as our farming and cellar work.',
    art: ['/img/stock/faq-a.jpg', '/img/stock/faq-b.jpg', '/img/stock/faq-hero.jpg', '/img/stock/estate-hero.jpg']
  }
};

const config = house[entry.slug];

const bioStats = [
  ['42', 'Estate Acres'],
  ['2,500', 'Cases / Year'],
  ['35+', 'Harvests'],
  ['5', 'Distinct Blocks']
];

const storyMoments = [
  ['1989', 'Foundation', 'A single acre on volcanic slope established the estate style.'],
  ['1992', 'First Vintage', 'The first release defined the benchmark for balance and aging.'],
  ['2005', 'Expansion', 'New parcels were acquired only when quality criteria were met.'],
  ['2015', 'Transition', 'Second-generation stewardship preserved the house philosophy.'],
  ['Today', 'Continuity', 'Every vintage still follows the same disciplined framework.']
];

const vineyardBlocks = [
  ['The Lion Block', '18 acres', 'Volcanic basalt · East-facing'],
  ['The Ridge Block', '8 acres', 'Rocky loam · South-facing'],
  ['The Fog Block', '6 acres', 'Marine influence · Aromatic lift'],
  ['The Stone Terrace', '5 acres', 'Alluvial gravel · Valley floor'],
  ['The Palisades', '3 acres', 'Steep volcanic face · Tiny yields']
];

const philosophyLines = [
  'The vineyard leads; the cellar follows.',
  'Precision is subtraction, not amplification.',
  'Scores may arrive, but pleasure is the objective.',
  'Rarity exists to protect quality, never to perform exclusivity.'
];

const faqItems = [
  ['How do I purchase the wines?', 'Most wines are released through allocation first. A limited amount reaches selected partners.'],
  ['What is the allocation list?', 'Members receive priority access to spring and autumn releases with no minimum purchase requirement.'],
  ['Can I visit the estate?', 'Yes. Private tastings are by appointment, typically Thursday through Sunday.'],
  ['Do you ship internationally?', 'We ship where regulations permit. International fulfillment is coordinated through distribution partners.'],
  ['Are the wines vegan?', 'Yes. We do not use animal-product fining agents, and vintages since 2018 are certified vegan.']
];
---

<Layout title={entry.data.title} description={entry.data.description}>
  {config && (
    <article class={`house-page variant-${entry.slug}`}>
      <section class="house-hero">
        <div class="house-hero-bg drift" data-drift="0.08" style={`background-image:url('${config.hero}')`}></div>
        <div class="house-hero-overlay"></div>
        <div class="house-hero-inner" data-reveal="up">
          <span class="house-eyebrow">{config.eyebrow}</span>
          <h1 set:html={config.title.replace('\n', '<br />')}></h1>
          <div class="house-rule"></div>
          <p>{config.subtitle}</p>
        </div>
      </section>

      <section class="house-lead" data-reveal="up">
        <p>{config.lead}</p>
      </section>

      {entry.slug === 'bio' && (
        <section class="bio-film">
          <figure class="bio-film-main" data-reveal="left">
            <img src={config.art[0]} alt="Estate" loading="lazy" />
          </figure>
          <figure class="bio-film-support drift" data-drift="0.1" data-reveal="right">
            <img src={config.art[1]} alt="Cellar" loading="lazy" />
          </figure>
          <div class="bio-film-strip" data-reveal="up" data-delay="2">
            {bioStats.map((s, i) => (
              <article class="bio-chip" data-reveal={i % 2 === 0 ? 'up' : 'right'}>
                <span>{s[0]}</span>
                <small>{s[1]}</small>
              </article>
            ))}
          </div>
          <figure class="bio-film-wide" data-reveal="up" data-delay="3">
            <img src={config.art[2]} alt="Estate detail" loading="lazy" />
          </figure>
        </section>
      )}

      {entry.slug === 'our-story' && (
        <section class="story-museum">
          <div class="story-spine" aria-hidden="true"></div>
          {storyMoments.map((m, i) => (
            <article class={`story-card ${i % 2 === 0 ? 'left' : 'right'}`} data-reveal={i % 2 === 0 ? 'left' : 'right'}>
              <span class="story-year">{m[0]}</span>
              <div class="story-copy">
                <h2>{m[1]}</h2>
                <p>{m[2]}</p>
              </div>
            </article>
          ))}
          <figure class="story-visual" data-reveal="up">
            <img src={config.art[0]} alt="Timeline visual" loading="lazy" />
          </figure>
        </section>
      )}

      {entry.slug === 'vineyards' && (
        <section class="vine-carto">
          <figure class="vine-map" data-reveal="left">
            <img src={config.art[0]} alt="Estate map texture" loading="lazy" />
            <div class="map-grid" aria-hidden="true"></div>
          </figure>
          <div class="vine-pins">
            {vineyardBlocks.map((b, i) => (
              <article class="vine-pin" data-reveal={i % 2 === 0 ? 'right' : 'up'}>
                <h2>{b[0]}</h2>
                <p class="vine-size">{b[1]}</p>
                <p>{b[2]}</p>
              </article>
            ))}
          </div>
        </section>
      )}

      {entry.slug === 'philosophy' && (
        <section class="phi-manifesto">
          <figure class="phi-image drift" data-drift="0.08" data-reveal="left">
            <img src={config.art[0]} alt="Manifesto visual" loading="lazy" />
          </figure>
          <div class="phi-texts">
            {philosophyLines.map((line, i) => (
              <p data-reveal={i % 2 === 0 ? 'right' : 'left'}>{line}</p>
            ))}
          </div>
          <figure class="phi-secondary" data-reveal="up" data-delay="2">
            <img src={config.art[1]} alt="Philosophy detail" loading="lazy" />
          </figure>
        </section>
      )}

      {entry.slug === 'faq' && (
        <section class="faq-concierge">
          <div class="faq-panel" data-reveal="left">
            <figure>
              <img src={config.art[0]} alt="Hospitality" loading="lazy" />
            </figure>
            <p>Allocation, shipping, and hospitality are coordinated by a dedicated concierge team.</p>
          </div>
          <div class="faq-list" data-reveal="right">
            {faqItems.map((f) => (
              <details class="faq-item">
                <summary>
                  <span>{f[0]}</span>
                  <span class="faq-plus" aria-hidden="true">+</span>
                </summary>
                <p>{f[1]}</p>
              </details>
            ))}
          </div>
        </section>
      )}

      <section class="house-body" data-reveal="up">
        <Content />
      </section>
    </article>
  )}
</Layout>

<style>
.house-page { padding-bottom: min(10vw, 110px); }
.house-eyebrow {
  font-family: var(--font-sans-serif);
  font-size: 0.94rem;
  letter-spacing: 4px;
  text-transform: uppercase;
  color: var(--color-primary);
}
.house-rule { width: 50px; height: 1px; background: var(--color-primary); opacity: 0.75; }

.house-hero {
  position: relative;
  min-height: 92vh;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}
.house-hero-bg {
  position: absolute;
  inset: -8%;
  background-size: cover;
  background-position: center;
}
.house-hero-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(to bottom, rgba(8, 6, 4, 0.3), rgba(8, 6, 4, 0.78));
}
.house-hero-inner {
  position: relative;
  z-index: 2;
  text-align: center;
  max-width: 980px;
  padding: 0 6vw;
}
.house-hero-inner h1 {
  margin: 1.8rem 0;
  font-family: var(--font-display);
  font-size: clamp(4.4rem, 10vw, 10rem);
  font-weight: 300;
  line-height: 1.03;
  letter-spacing: 8px;
  text-transform: uppercase;
  color: #f4eddd;
}
.house-hero-inner .house-rule { margin: 0 auto 1.8rem; }
.house-hero-inner p {
  margin: 0;
  font-family: var(--font-serif);
  font-size: clamp(1.5rem, 2vw, 2rem);
  font-style: italic;
  color: rgba(244, 237, 221, 0.74);
}

.house-lead {
  max-width: 980px;
  margin: min(8vw, 92px) auto 0;
  padding: 0 6vw;
  text-align: center;
}
.house-lead p {
  margin: 0;
  font-family: var(--font-serif);
  font-size: clamp(2rem, 2.7vw, 3rem);
  font-style: italic;
  line-height: 1.72;
  opacity: 0.82;
}

.bio-film,
.story-museum,
.vine-carto,
.phi-manifesto,
.faq-concierge {
  margin: min(8vw, 90px) auto 0;
  max-width: 1320px;
  padding: 0 6vw;
}

.bio-film {
  display: grid;
  grid-template-columns: 1.1fr 0.9fr;
  gap: min(2vw, 24px);
}
.bio-film-main,
.bio-film-support,
.bio-film-wide { margin: 0; overflow: hidden; }
.bio-film-main { grid-row: 1 / span 2; aspect-ratio: 4 / 5; }
.bio-film-support { aspect-ratio: 4 / 3; }
.bio-film-wide { grid-column: 1 / -1; aspect-ratio: 16 / 6; }
.bio-film-strip {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 0.8rem;
}
.bio-chip {
  border-top: 1px solid var(--color-border);
  padding: 0.8rem 0;
}
.bio-chip span {
  display: block;
  font-family: var(--font-display);
  font-size: clamp(2rem, 3vw, 3.2rem);
  color: var(--color-primary);
}
.bio-chip small {
  font-family: var(--font-sans-serif);
  letter-spacing: 2px;
  text-transform: uppercase;
  font-size: 0.76rem;
  opacity: 0.62;
}

.story-museum {
  position: relative;
  display: grid;
  gap: 1rem;
}
.story-spine {
  position: absolute;
  left: 50%;
  top: 0;
  bottom: 0;
  width: 1px;
  transform: translateX(-50%);
  background: linear-gradient(to bottom, transparent, var(--color-border), transparent);
}
.story-card {
  width: 50%;
  display: grid;
  gap: 0.7rem;
  padding: 0.8rem 1rem;
}
.story-card.left { margin-right: auto; text-align: right; }
.story-card.right { margin-left: auto; }
.story-year {
  font-family: var(--font-sans-serif);
  letter-spacing: 3px;
  text-transform: uppercase;
  color: var(--color-primary);
  font-size: 0.78rem;
}
.story-copy h2 {
  margin: 0;
  font-family: var(--font-display);
  font-size: clamp(2.1rem, 2.8vw, 3.8rem);
  font-weight: 300;
  text-transform: uppercase;
}
.story-copy p { margin: 0; font-size: 1.48rem; line-height: 1.75; opacity: 0.72; }
.story-visual { margin: 1rem auto 0; width: min(720px, 100%); overflow: hidden; aspect-ratio: 16 / 8; }

.vine-carto {
  display: grid;
  grid-template-columns: 40% 1fr;
  gap: min(4vw, 48px);
}
.vine-map { position: relative; margin: 0; overflow: hidden; aspect-ratio: 4 / 5; }
.map-grid {
  position: absolute;
  inset: 0;
  background-image:
    linear-gradient(rgba(245, 217, 128, 0.12) 1px, transparent 1px),
    linear-gradient(90deg, rgba(245, 217, 128, 0.12) 1px, transparent 1px);
  background-size: 48px 48px;
  pointer-events: none;
}
.vine-pins { display: grid; gap: 0.8rem; }
.vine-pin { border-top: 1px solid var(--color-border); padding: 0.9rem 0; }
.vine-pin h2 {
  margin: 0;
  font-family: var(--font-display);
  font-size: clamp(2rem, 2.6vw, 3.2rem);
  font-weight: 300;
  text-transform: uppercase;
}
.vine-size {
  margin: 0.3rem 0;
  font-family: var(--font-sans-serif);
  letter-spacing: 2px;
  text-transform: uppercase;
  color: var(--color-primary);
  font-size: 0.78rem;
}
.vine-pin p { margin: 0; font-size: 1.38rem; opacity: 0.7; }

.phi-manifesto {
  display: grid;
  grid-template-columns: 42% 1fr;
  gap: min(4vw, 48px);
  align-items: center;
}
.phi-image,
.phi-secondary { margin: 0; overflow: hidden; }
.phi-image { aspect-ratio: 4 / 5; }
.phi-secondary { grid-column: 1 / -1; aspect-ratio: 16 / 6; }
.phi-texts { display: grid; gap: 0.8rem; }
.phi-texts p {
  margin: 0;
  border-left: 1px solid var(--color-border);
  padding-left: 1rem;
  font-size: clamp(1.8rem, 2.2vw, 2.5rem);
  line-height: 1.72;
  font-style: italic;
}

.faq-concierge {
  display: grid;
  grid-template-columns: 42% 1fr;
  gap: min(4vw, 48px);
  align-items: start;
}
.faq-panel { position: sticky; top: 110px; }
.faq-panel figure { margin: 0; overflow: hidden; aspect-ratio: 4 / 5; }
.faq-panel p {
  margin: 1rem 0 0;
  font-size: 1.42rem;
  line-height: 1.7;
  opacity: 0.68;
}
.faq-list { display: grid; gap: 0.8rem; }
.faq-item { border-top: 1px solid var(--color-border); border-bottom: 1px solid var(--color-border); padding: 0.8rem 0; }
.faq-item summary {
  list-style: none;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 1rem;
  cursor: pointer;
}
.faq-item summary::-webkit-details-marker { display: none; }
.faq-item summary span:first-child {
  font-family: var(--font-display);
  font-size: clamp(1.9rem, 2.4vw, 2.9rem);
  font-weight: 300;
}
.faq-plus { color: var(--color-primary); font-size: 1.8rem; transition: transform 0.25s ease; }
.faq-item[open] .faq-plus { transform: rotate(45deg); }
.faq-item p { margin: 0.7rem 0 0; font-size: 1.45rem; line-height: 1.75; opacity: 0.72; }

.house-body {
  max-width: 980px;
  margin: min(8vw, 90px) auto 0;
  padding: min(5vw, 56px) 6vw 0;
  border-top: 1px solid var(--color-border);
}
.house-body :global(h2) {
  font-family: var(--font-display);
  font-size: clamp(2.6rem, 3vw, 3.8rem);
  font-weight: 300;
  text-transform: uppercase;
  letter-spacing: 2px;
}
.house-body :global(p),
.house-body :global(li) {
  font-size: 1.6rem;
  line-height: 1.82;
  opacity: 0.74;
}

.house-page img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  transition: transform 0.85s cubic-bezier(0.2, 0, 0, 1);
}
.house-page figure:hover img { transform: scale(1.04); }

.drift { transform: translate3d(0, calc(var(--drift-y, 0) * 1px), 0); }

@media (max-width: 980px) {
  .bio-film,
  .vine-carto,
  .phi-manifesto,
  .faq-concierge { grid-template-columns: 1fr; }
  .story-spine { left: 24px; }
  .story-card { width: calc(100% - 42px); margin-left: 42px !important; text-align: left !important; }
  .faq-panel { position: static; top: auto; }
}

@media (max-width: 640px) {
  .house-hero-inner h1 { letter-spacing: 4px; }
  .bio-film-strip { grid-template-columns: 1fr; }
}
</style>

<script>
(function() {
  function initHouseParallax() {
    const drifters = Array.from(document.querySelectorAll<HTMLElement>('.house-page [data-drift]'));
    if (!drifters.length) return;

    const onScroll = () => {
      const y = window.scrollY;
      drifters.forEach((el) => {
        const ratio = Number(el.dataset.drift || '0');
        el.style.setProperty('--drift-y', String(-y * ratio * 0.12));
      });
    };

    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
    document.addEventListener('astro:before-swap', () => window.removeEventListener('scroll', onScroll), { once: true });
  }

  document.addEventListener('astro:page-load', initHouseParallax);
  initHouseParallax();
})();
</script>
