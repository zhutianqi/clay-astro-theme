---
import Layout from '../layouts/Layout.astro';
import { type CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'pages'>;
}

const { entry } = Astro.props;
const { title, description } = entry.data;
---

<Layout title="Join the Allocation List" description="Request access to Maison's annual allocation — a limited release offered exclusively to members before reaching any retail or restaurant channel.">

  <!-- ── CONTACT HERO ── -->
  <section class="contact-hero">
    <div class="contact-hero-bg"></div>
    <div class="contact-hero-overlay"></div>
    <div class="contact-hero-content">
      <span class="contact-eyebrow">By Invitation</span>
      <h1 class="contact-title">Request<br><em>Allocation</em></h1>
      <div class="contact-hero-rule"></div>
      <p class="contact-hero-sub">
        Our wines are offered to allocation members before reaching any retail or restaurant channel. Applications are reviewed quarterly by the estate.
      </p>
    </div>
    <div class="contact-scroll-indicator" aria-hidden="true">
      <div class="contact-scroll-line"></div>
    </div>
  </section>

  <!-- ── FORM SECTION ── -->
  <section class="contact-body">
    <div class="contact-left" data-reveal="left">
      <span class="contact-section-label">The Process</span>
      <h2 class="contact-left-title">A quiet<br><em>conversation</em><br>begins here.</h2>
      <div class="contact-left-rule"></div>
      <p class="contact-left-body">
        Each year, we release our wines in a single allocation to a community of collectors who share our conviction that the finest wines deserve unhurried attention.
      </p>
      <p class="contact-left-body">
        Membership carries no minimum purchase obligation. You will receive early access, tasting notes, and an invitation to the annual estate dinner.
      </p>
      <ul class="contact-benefits">
        <li>
          <span class="contact-benefit-mark">—</span>
          <span>Priority access to all new vintages</span>
        </li>
        <li>
          <span class="contact-benefit-mark">—</span>
          <span>Exclusive cellar-door pricing</span>
        </li>
        <li>
          <span class="contact-benefit-mark">—</span>
          <span>Annual estate dinner invitation</span>
        </li>
        <li>
          <span class="contact-benefit-mark">—</span>
          <span>Personal winemaker correspondence</span>
        </li>
      </ul>
    </div>

    <div class="contact-form-wrap" data-reveal="right">
      <!-- Netlify form. To receive email notifications, go to:
           Netlify Dashboard → Site → Forms → contact-allocation → Notifications
           and add an email notification to zhutianqi0124@gmail.com -->
      <form
        id="contact-form"
        name="contact-allocation"
        method="POST"
        data-netlify="true"
        action="/contact/thanks"
        novalidate
      >
        <input type="hidden" name="form-name" value="contact-allocation" />
        <p hidden><label>Leave this empty: <input name="bot-field" /></label></p>

        <div class="form-row">
          <div class="form-field">
            <input
              type="text"
              id="full-name"
              name="full-name"
              required
              autocomplete="name"
              class="form-input"
              placeholder=" "
            />
            <label for="full-name" class="form-label">Full Name <span class="form-required">*</span></label>
            <div class="form-line"></div>
            <p class="form-error" data-error="full-name">Please enter your full name</p>
          </div>
        </div>

        <div class="form-row form-row-split">
          <div class="form-field">
            <input
              type="email"
              id="email"
              name="email"
              required
              autocomplete="email"
              class="form-input"
              placeholder=" "
            />
            <label for="email" class="form-label">Email Address <span class="form-required">*</span></label>
            <div class="form-line"></div>
            <p class="form-error" data-error="email">Please enter a valid email</p>
          </div>
          <div class="form-field">
            <input
              type="tel"
              id="phone"
              name="phone"
              autocomplete="tel"
              class="form-input"
              placeholder=" "
            />
            <label for="phone" class="form-label">Phone Number</label>
            <div class="form-line"></div>
          </div>
        </div>

        <div class="form-row form-row-split">
          <div class="form-field">
            <input
              type="text"
              id="location"
              name="location"
              required
              autocomplete="country-name"
              class="form-input"
              placeholder=" "
            />
            <label for="location" class="form-label">Country of Residence <span class="form-required">*</span></label>
            <div class="form-line"></div>
            <p class="form-error" data-error="location">Please enter your location</p>
          </div>
          <div class="form-field form-field-select">
            <select id="budget" name="annual-wine-investment" class="form-input form-select" required>
              <option value="" disabled selected></option>
              <option value="5k-15k">$5,000 – $15,000</option>
              <option value="15k-50k">$15,000 – $50,000</option>
              <option value="50k+">$50,000+</option>
              <option value="prefer-not">Prefer not to say</option>
            </select>
            <label for="budget" class="form-label form-label-select">Annual Wine Investment <span class="form-required">*</span></label>
            <div class="form-line"></div>
            <p class="form-error" data-error="budget">Please select a range</p>
          </div>
        </div>

        <div class="form-row">
          <div class="form-field form-field-select">
            <select id="interest" name="primary-interest" class="form-input form-select">
              <option value="" disabled selected></option>
              <option value="cabernet">Cabernet Sauvignon</option>
              <option value="chardonnay">Chardonnay</option>
              <option value="red-blends">Red Blends</option>
              <option value="all">All Varietals</option>
            </select>
            <label for="interest" class="form-label form-label-select">Primary Interest</label>
            <div class="form-line"></div>
          </div>
        </div>

        <div class="form-row">
          <div class="form-field">
            <textarea
              id="message"
              name="message"
              rows="4"
              class="form-input form-textarea"
              placeholder=" "
            ></textarea>
            <label for="message" class="form-label">A Personal Note</label>
            <div class="form-line"></div>
          </div>
        </div>

        <div class="form-submit-row">
          <p class="form-privacy">
            Your information is held in strict confidence and shared with no third parties.
          </p>
          <button type="submit" class="form-submit" id="form-submit-btn">
            <span class="form-submit-text">Submit Application</span>
            <span class="form-submit-arrow">→</span>
          </button>
        </div>

      </form>
    </div>
  </section>

</Layout>

<style>
/* ── HERO ─────────────────────────── */
.contact-hero {
  position: relative;
  height: 85svh;
  min-height: 580px;
  display: flex;
  align-items: flex-end;
  justify-content: flex-start;
  overflow: hidden;
  padding: 0 8vw 8vw;
}
.contact-hero-bg {
  position: absolute;
  inset: 0;
  background-image: url('/img/contact-bg.jpg'), url('/img/vineyard-landscape.jpg');
  background-size: cover;
  background-position: center 40%;
  transform: scale(1.06);
  transition: transform 14s ease-out;
}
.contact-hero:hover .contact-hero-bg { transform: scale(1); }
.contact-hero-overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(
    135deg,
    rgba(4,2,0,0.88) 0%,
    rgba(4,2,0,0.62) 55%,
    rgba(4,2,0,0.45) 100%
  );
}
.contact-hero-content {
  position: relative;
  z-index: 2;
  color: #fff;
  max-width: 680px;
  animation: heroIn 1.6s cubic-bezier(0.16,1,0.3,1) both;
}
@keyframes heroIn {
  from { opacity: 0; transform: translateY(30px); }
  to   { opacity: 1; transform: none; }
}
.contact-eyebrow {
  display: block;
  font-family: var(--font-sans-serif);
  font-size: 0.9rem;
  letter-spacing: 5px;
  text-transform: uppercase;
  color: #e7c874;
  opacity: 0.85;
  margin-bottom: 2rem;
}
.contact-title {
  font-family: var(--font-display);
  font-size: clamp(5.5rem, 10vw, 11rem);
  font-weight: 200;
  letter-spacing: 4px;
  text-transform: uppercase;
  line-height: 1.05;
  margin: 0 0 2.5rem;
  color: #f0ead8;
}
.contact-title em {
  font-style: italic;
  color: #e7c874;
}
.contact-hero-rule {
  width: 48px;
  height: 1px;
  background: #e7c874;
  margin-bottom: 2.5rem;
  opacity: 0.65;
}
.contact-hero-sub {
  font-family: var(--font-serif);
  font-size: clamp(1.5rem, 1.8vw, 1.85rem);
  font-style: italic;
  line-height: 1.75;
  color: rgba(240,234,216,0.58);
  max-width: 520px;
  margin: 0;
}
.contact-scroll-indicator {
  position: absolute;
  bottom: 0;
  right: 8vw;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0;
  z-index: 2;
}
.contact-scroll-line {
  width: 1px;
  height: 80px;
  background: linear-gradient(to bottom, rgba(231,200,116,0) 0%, rgba(231,200,116,0.6) 100%);
  animation: scrollDrop 2.4s cubic-bezier(0.4,0,0.6,1) infinite;
}
@keyframes scrollDrop {
  0%   { transform: scaleY(0); transform-origin: top; opacity: 0; }
  40%  { transform: scaleY(1); transform-origin: top; opacity: 1; }
  60%  { transform: scaleY(1); transform-origin: bottom; opacity: 1; }
  100% { transform: scaleY(0); transform-origin: bottom; opacity: 0; }
}

/* ── BODY ─────────────────────────── */
.contact-body {
  display: grid;
  grid-template-columns: 42% 1fr;
  min-height: 80vh;
}

/* ── LEFT PANEL ───────────────────── */
.contact-left {
  background: #0a0604;
  padding: min(10vw, 100px) min(6vw, 70px);
  display: flex;
  flex-direction: column;
}
.contact-section-label {
  font-family: var(--font-sans-serif);
  font-size: 0.8rem;
  letter-spacing: 4px;
  text-transform: uppercase;
  color: #e7c874;
  opacity: 0.7;
  display: block;
  margin-bottom: 2.5rem;
}
.contact-left-title {
  font-family: var(--font-display);
  font-size: clamp(3rem, 4.5vw, 5.2rem);
  font-weight: 300;
  letter-spacing: 2px;
  text-transform: uppercase;
  line-height: 1.15;
  color: #f0ead8;
  margin: 0 0 2.5rem;
}
.contact-left-title em {
  font-style: italic;
  color: #e7c874;
}
.contact-left-rule {
  width: 36px;
  height: 1px;
  background: #e7c874;
  opacity: 0.5;
  margin-bottom: 2.5rem;
}
.contact-left-body {
  font-family: var(--font-serif);
  font-size: clamp(1.5rem, 1.6vw, 1.8rem);
  font-style: italic;
  line-height: 1.8;
  color: rgba(240,234,216,0.48);
  margin: 0 0 1.8rem;
}
.contact-benefits {
  list-style: none;
  margin: 1.5rem 0 0;
  padding: 0;
  display: flex;
  flex-direction: column;
  gap: 1rem;
}
.contact-benefits li {
  display: flex;
  gap: 1rem;
  font-family: var(--font-sans-serif);
  font-size: 1rem;
  letter-spacing: 1.5px;
  text-transform: uppercase;
  color: rgba(240,234,216,0.42);
}
.contact-benefit-mark {
  color: #e7c874;
  opacity: 0.6;
  flex-shrink: 0;
}

/* ── FORM PANEL ───────────────────── */
.contact-form-wrap {
  background: var(--color-bg);
  padding: min(8vw, 80px) min(7vw, 80px);
  display: flex;
  flex-direction: column;
  justify-content: center;
}
[data-theme='dark'] .contact-form-wrap {
  background: #100c08;
}

form { width: 100%; }
.form-row { margin-bottom: 2.5rem; }
.form-row-split {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 0 3rem;
}

/* ── Field — floating label style ── */
.form-field {
  position: relative;
  padding-top: 1.8rem;
}
.form-input {
  width: 100%;
  background: transparent;
  border: none;
  border-bottom: 1px solid var(--color-border);
  color: var(--color-base);
  font-family: var(--font-serif);
  font-size: 1.6rem;
  font-style: italic;
  padding: 0.6rem 0 0.8rem;
  outline: none;
  transition: border-color 0.3s;
  box-sizing: border-box;
  appearance: none;
  -webkit-appearance: none;
}
.form-input:focus {
  border-bottom-color: var(--color-primary);
}
.form-label {
  position: absolute;
  top: 1.8rem;
  left: 0;
  font-family: var(--font-sans-serif);
  font-size: 0.85rem;
  letter-spacing: 2.5px;
  text-transform: uppercase;
  color: var(--color-base);
  opacity: 0.38;
  pointer-events: none;
  transform-origin: left top;
  transition: transform 0.28s cubic-bezier(0.2,0,0,1), opacity 0.28s, color 0.28s;
}
/* Lift label when input has value or is focused */
.form-input:focus + .form-label,
.form-input:not(:placeholder-shown) + .form-label {
  transform: translateY(-1.8rem) scale(0.82);
  opacity: 0.65;
  color: var(--color-primary);
}
.form-input::placeholder { color: transparent; }
.form-line {
  position: absolute;
  bottom: 0;
  left: 0;
  width: 0;
  height: 2px;
  background: var(--color-primary);
  transition: width 0.38s cubic-bezier(0.2,0,0,1);
  pointer-events: none;
}
.form-input:focus ~ .form-line { width: 100%; }

/* Select overrides */
.form-select {
  cursor: pointer;
  padding-right: 2rem;
  font-style: normal;
  font-family: var(--font-sans-serif);
  font-size: 1.1rem;
  letter-spacing: 0.5px;
}
.form-select option { background: var(--color-bg); color: var(--color-base); }
.form-label-select { top: 1.8rem; }
.form-select:not([value=""]):valid + .form-label-select,
.form-select:focus + .form-label-select {
  transform: translateY(-1.8rem) scale(0.82);
  opacity: 0.65;
  color: var(--color-primary);
}

/* Textarea */
.form-textarea {
  resize: none;
  line-height: 1.7;
}

/* Required marker */
.form-required { color: var(--color-primary); opacity: 0.7; margin-left: 2px; }

/* Error messages */
.form-error {
  font-family: var(--font-sans-serif);
  font-size: 0.78rem;
  letter-spacing: 1.5px;
  text-transform: uppercase;
  color: #c0392b;
  margin: 0.4rem 0 0;
  display: none;
}
.form-field.has-error .form-error { display: block; }
.form-field.has-error .form-input { border-bottom-color: #c0392b; }

/* Submit row */
.form-submit-row {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  gap: 2rem;
  margin-top: 1rem;
}
.form-privacy {
  font-family: var(--font-sans-serif);
  font-size: 0.8rem;
  letter-spacing: 1.5px;
  text-transform: uppercase;
  color: var(--color-base);
  opacity: 0.3;
  margin: 0;
  max-width: 280px;
  line-height: 1.7;
}
.form-submit {
  font-family: var(--font-sans-serif);
  font-size: 0.95rem;
  letter-spacing: 3.5px;
  text-transform: uppercase;
  background: transparent;
  border: none;
  cursor: pointer;
  color: var(--color-base);
  opacity: 0.55;
  display: inline-flex;
  align-items: center;
  gap: 0.8rem;
  position: relative;
  padding-bottom: 5px;
  transition: opacity 0.25s, color 0.25s, gap 0.4s cubic-bezier(0.2,0,0,1);
  flex-shrink: 0;
}
.form-submit::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 1px;
  background: var(--color-primary);
  transform: scaleX(0.3);
  transform-origin: left;
  transition: transform 0.4s cubic-bezier(0.2,0,0,1);
}
.form-submit:hover {
  opacity: 1;
  color: var(--color-primary);
  gap: 1.3rem;
}
.form-submit:hover::after { transform: scaleX(1); }
.form-submit.loading .form-submit-text { opacity: 0.5; }

/* ── RESPONSIVE ───────────────────── */
@media (max-width: 900px) {
  .contact-body { grid-template-columns: 1fr; }
  .contact-left { padding: min(10vw, 80px) 6vw; }
  .contact-form-wrap { padding: min(8vw, 70px) 6vw; }
}
@media (max-width: 600px) {
  .contact-hero { padding: 0 6vw 6vw; align-items: flex-end; }
  .contact-title { font-size: clamp(4.5rem, 14vw, 8rem); }
  .form-row-split { grid-template-columns: 1fr; }
  .form-submit-row { flex-direction: column; align-items: flex-start; gap: 2rem; }
  .contact-scroll-indicator { display: none; }
}
</style>

<script>
(function() {
    const form = document.getElementById('contact-form') as HTMLFormElement;
    if (!form) return;

    function validateField(field: HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement): boolean {
        const wrapper = field.closest('.form-field') as HTMLElement;
        if (!wrapper) return true;

        let valid = true;

        if (field.required && !field.value.trim()) {
            valid = false;
        } else if (field.type === 'email' && field.value.trim()) {
            const emailRe = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
            valid = emailRe.test(field.value.trim());
        }

        wrapper.classList.toggle('has-error', !valid);
        return valid;
    }

    // Real-time validation on blur
    form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement>(
        'input, textarea, select'
    ).forEach(field => {
        field.addEventListener('blur', () => validateField(field));
        field.addEventListener('input', () => {
            if ((field.closest('.form-field') as HTMLElement)?.classList.contains('has-error')) {
                validateField(field);
            }
        });
    });

    // Submit: validate all required fields first
    form.addEventListener('submit', (e) => {
        let allValid = true;
        form.querySelectorAll<HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement>(
            'input[required], select[required], textarea[required]'
        ).forEach(field => {
            if (!validateField(field)) allValid = false;
        });

        if (!allValid) {
            e.preventDefault();
            const firstError = form.querySelector<HTMLElement>('.has-error .form-input');
            firstError?.focus();
            return;
        }

        const btn = document.getElementById('form-submit-btn');
        if (btn) {
            btn.classList.add('loading');
            (btn.querySelector('.form-submit-text') as HTMLElement).textContent = 'Sending…';
        }
    });

    // Select visual state for floating labels
    form.querySelectorAll<HTMLSelectElement>('select').forEach(sel => {
        const updateSelectState = () => {
            const label = sel.nextElementSibling as HTMLElement;
            if (label && sel.value) {
                label.style.transform = 'translateY(-1.8rem) scale(0.82)';
                label.style.opacity = '0.65';
                label.style.color = 'var(--color-primary)';
            } else if (label) {
                label.style.transform = '';
                label.style.opacity = '';
                label.style.color = '';
            }
        };
        sel.addEventListener('change', updateSelectState);
        updateSelectState();
    });
})();
</script>
